// Busca juegos nuevos en IGDB si pulsas el botón "Buscar" o Enter
window.buscarJuegosIGDBParaLista = async function() {
    const input = document.getElementById('inputBuscarJuegoEditor');
    const contenedor = document.getElementById('listaJuegosEditorContainer');
    if (!input || !contenedor) return;
    const query = input.value.trim();
    if (!query) return;

    // Si existen juegos nuevos en IGDB mediante Google Apps Script (buscarJuegos / searchGames)
    if (typeof google !== 'undefined' && google.script && google.script.run) {
        const avisoCarga = document.createElement('p');
        avisoCarga.id = 'avisoBuscandoIGDB';
        avisoCarga.style.cssText = 'color:#666; font-size:0.8rem; text-align:center; font-family:"Outfit",sans-serif; margin: 6px 0;';
        avisoCarga.textContent = 'Buscando más juegos en IGDB...';
        contenedor.prepend(avisoCarga);

        google.script.run
            .withSuccessHandler(function(res) {
                const aviso = document.getElementById('avisoBuscandoIGDB');
                if (aviso) aviso.remove();
                const lista = (res && res.data) ? res.data : (Array.isArray(res) ? res : []);
                lista.forEach(juego => {
                    const idJuego = String(juego.id);
                    if (contenedor.querySelector(`[data-id="${idJuego}"]`)) return; // Ya está en la lista visual
                    const imgHash = (juego.cover && juego.cover.image_id) ? juego.cover.image_id : (juego.caratula || '');
                    const caratula = imgHash ? `https://images.igdb.com/igdb/image/upload/t_cover_small/${imgHash}.jpg` : 'https://via.placeholder.com/45x60?text=Sin+Img';
                    const nombre = juego.name || juego.nombre || 'Juego';

                    // Lo guardamos también en memoria para que tenga carátula y título al pintarse en la lista
                    window.miColeccionActiva = window.miColeccionActiva || {};
                    if (!window.miColeccionActiva[idJuego]) {
                        window.miColeccionActiva[idJuego] = { nombre: nombre, caratula: imgHash };
                    }

                    const div = document.createElement('div');
                    div.className = 'item-juego-editor';
                    div.setAttribute('onclick', `window.toggleJuegoEnEditor(this, '${idJuego}')`);
                    div.setAttribute('data-id', idJuego);
                    div.setAttribute('data-nombre', nombre.toLowerCase());
                    div.setAttribute('data-selected', 'false');
                    div.style.cssText = 'display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; border-radius: 12px; background: #f9fafb; border: 1px solid #e5e7eb; cursor: pointer; transition: all 0.15s;';
                    div.innerHTML = `
                        <div style="display: flex; align-items: center; gap: 12px; overflow: hidden;">
                            <img src="${caratula}" style="width: 38px; height: 50px; object-fit: cover; border-radius: 6px; flex-shrink: 0;">
                            <span style="color: #222; font-family: 'Outfit', sans-serif; font-size: 0.85rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${nombre}</span>
                        </div>
                        <span class="material-symbols-rounded icon-check" style="color: #ccc; font-size: 22px;">radio_button_unchecked</span>
                    `;
                    contenedor.prepend(div);
                });
            })
            .withFailureHandler(function() {
                const aviso = document.getElementById('avisoBuscandoIGDB');
                if (aviso) aviso.remove();
            })
            .buscarJuegosIGDB ? google.script.run.buscarJuegosIGDB(query) : (
                google.script.run.searchGames ? google.script.run.searchGames(query) : null
            );
    }
};

window.toggleJuegoEnEditor = function(el) {
    const activo = el.getAttribute('data-selected') === 'true';
    const nuevoEstado = !activo;
    el.setAttribute('data-selected', nuevoEstado ? 'true' : 'false');
    el.style.background = nuevoEstado ? '#f0fdf4' : '#f9fafb';
    el.style.borderColor = nuevoEstado ? '#86efac' : '#e5e7eb';
    const icon = el.querySelector('.icon-check');
    if (icon) {
        icon.textContent = nuevoEstado ? 'check_circle' : 'radio_button_unchecked';
        icon.style.color = nuevoEstado ? '#16a34a' : '#ccc';
    }
};

window.guardarJuegosEditadosLista = async function(idLista) {
    const modalEditor = document.getElementById('modalEditorJuegosLista');
    const contenedor = document.getElementById('listaJuegosEditorContainer');
    const btn = document.getElementById('btnGuardarEdicionLista');
    if (!contenedor) return;

    const seleccionados = Array.from(contenedor.querySelectorAll('[data-selected="true"]')).map(el => el.getAttribute('data-id'));
    if (btn) btn.textContent = 'Guardando...';

    // 1. Actualizamos la caché local de inmediato
    if (window.misListasCache && window.misListasCache[idLista]) {
        window.misListasCache[idLista].juegos = seleccionados;
    }

    // 2. Cerramos el modal de edición inmediatamente (igual que al darle a la X)
    if (modalEditor) {
        modalEditor.style.setProperty('display', 'none', 'important');
    }

    // 3. Refrescamos la vista de la lista que está debajo para ver los juegos añadidos/quitados al instante
    window.abrirDetalleLista(idLista);
    if (typeof window.cargarListasPerfil === 'function') window.cargarListasPerfil();

    // 4. Guardamos en segundo plano en Firebase
    try {
        const uid = (window.auth && window.auth.currentUser) ? window.auth.currentUser.uid : (window.usuarioActual ? window.usuarioActual.uid : null);
        if (uid && window.db) {
            await window.db.collection('usuarios').doc(uid).collection('listas').doc(idLista).update({
                juegos: seleccionados
            });
        }
    } catch (e) {
        console.error('Error sincronizando lista con Firebase:', e);
    }
};
