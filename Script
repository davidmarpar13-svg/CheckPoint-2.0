    // Opción 1 de los 3 puntitos (para el creador): Borrar tema
    borrarTemaActual: async function(idTema) {
        const menu = document.getElementById('dropdownOpcionesTemaHilo');
        if (menu) menu.classList.remove('abierto');

        const idBorrar = idTema || this.idTemaAbierto;
        if (!idBorrar) return;

        this.temasActuales = (this.temasActuales || []).filter(function(t) { return t && t.id !== idBorrar; });
        window.misTemasCreadosCache = (window.misTemasCreadosCache || []).filter(function(t) { return t && t.id !== idBorrar; });

        await this.guardarTemasActuales();

        if (typeof window.actualizarContadorTemasEnPerfil === 'function') {
            window.actualizarContadorTemasEnPerfil();
        }
        if (typeof window.renderizarTemasDelUsuarioEnPerfil === 'function') {
            const contTemas = document.getElementById('contenedorMisTemasPerfil');
            if (contTemas && contTemas.style.display !== 'none') {
                window.renderizarTemasDelUsuarioEnPerfil();
            }
        }

        if (typeof window.mostrarToastAvisoEstreno === 'function') {
            window.mostrarToastAvisoEstreno('Tema eliminado', 'El tema ha sido borrado de la comunidad.');
        }

        this.cerrarHilo();
    },

    // Opción 2 de los 3 puntitos (para otros usuarios): Seguir / Dejar de seguir tema
    toggleSeguirTema: async function(idTema) {
        const menu = document.getElementById('dropdownOpcionesTemaHilo');
        if (menu) menu.classList.remove('abierto');

        const tema = (this.temasActuales || []).find(function(t) { return t && t.id === (idTema || window.ComunidadApp.idTemaAbierto); });
        if (!tema) return;

        const usuario = this.obtenerUsuarioActivo();
        tema.seguidores = Array.isArray(tema.seguidores) ? tema.seguidores : [];
        const claveSeguidor = (usuario.uid && usuario.uid !== 'anon') ? usuario.uid : (usuario.nombre || 'anon').toLowerCase();

        const idx = tema.seguidores.indexOf(claveSeguidor);
        if (idx === -1) {
            tema.seguidores.push(claveSeguidor);
            if (typeof window.mostrarToastAvisoEstreno === 'function') {
                window.mostrarToastAvisoEstreno(
                    '🔔 Siguiendo este tema',
                    'Te avisaremos en tus notificaciones cada vez que alguien comente en "' + (tema.titulo || 'este hilo') + '".'
                );
            }
        } else {
            tema.seguidores.splice(idx, 1);
            if (typeof window.mostrarToastAvisoEstreno === 'function') {
                window.mostrarToastAvisoEstreno(
                    'Seguimiento desactivado',
                    'Ya no recibirás notificaciones de nuevos comentarios en este tema.'
                );
            }
        }

        await this.guardarTemasActuales();
        this.actualizarContenidoMenuTresPuntos(tema);
    },

    comprimirImagenDispositivo: function(file, maxAncho, calidad) {
        return new Promise(function(resolve) {
            if (!file) return resolve('');
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    let width = img.width;
                    let height = img.height;
                    const maxDim = maxAncho || 900;

                    if (width > height && width > maxDim) {
                        height = Math.round((height * maxDim) / width);
                        width = maxDim;
                    } else if (height > maxDim) {
                        width = Math.round((width * maxDim) / height);
                        height = maxDim;
                    }

                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);
                    resolve(canvas.toDataURL('image/jpeg', calidad || 0.74));
                };
                img.onerror = function() { resolve(''); };
                img.src = e.target.result;
            };
            reader.onerror = function() { resolve(''); };
            reader.readAsDataURL(file);
        });
    },

    extraerDatosFichaJuego: function(idJuego) {
        const idStr = String(idJuego || '').trim();
        const detailScreen = document.getElementById('gameDetailScreen');
        const idFichaAbierta = String(window.juegoActualEnFichaId || window.currentGameId || '').trim();
        const fichaCorrespondeAlJuego = Boolean(detailScreen && idFichaAbierta === idStr);

        const juegoObj = (window.juegosCargados && window.juegosCargados[idStr]) ||
                         (window.miColeccionActiva && window.miColeccionActiva[idStr]) ||
                         (window.misAvisosEstreno && window.misAvisosEstreno[idStr]) ||
                         (window.SagaApp && window.SagaApp.registroJuegosIGDB && window.SagaApp.registroJuegosIGDB[idStr]) || {};

        // Si tenemos algún tema guardado de este juego con datos cacheados, lo usamos como respaldo
        const temaConDatos = (this.temasActuales || []).find(function(t) { return t && String(t.idJuego) === idStr; }) ||
                             (window.misTemasCreadosCache || []).find(function(t) { return t && String(t.idJuego) === idStr; }) || {};

        // 1. Título del juego
        let titulo = '';
        if (fichaCorrespondeAlJuego) {
            const elTitulo = document.getElementById('gdTitle');
            if (elTitulo && elTitulo.textContent && elTitulo.textContent.trim() && elTitulo.textContent.trim().toUpperCase() !== 'CARGANDO...') {
                titulo = elTitulo.textContent.trim();
            }
        }
        if (!titulo) {
            titulo = String(juegoObj.nombre || juegoObj.name || juegoObj.title || juegoObj.titulo || temaConDatos.juegoTitulo || 'Comunidad').trim();
        }

        // 2. Portada segura (evita leer src="" vacío cuando la ficha está cerrada)
        const normalizarUrlImagen = function(val, tamano) {
            if (!val) return '';
            const str = String(val).trim();
            if (!str || str === 'null' || str === 'undefined') return '';
            if (str.indexOf('script.google.com') !== -1 || str.indexOf('googleusercontent.com/userCodeAppPanel') !== -1) return '';
            if (str.indexOf('http://') === 0 || str.indexOf('https://') === 0 || str.indexOf('data:image') === 0) {
                return str;
            }
            const limpio = str.replace(/\.(jpg|png|webp)$/i, '');
            return 'https://images.igdb.com/igdb/image/upload/' + (tamano || 't_cover_big') + '/' + limpio + '.jpg';
        };

        let coverUrl = '';
        if (fichaCorrespondeAlJuego) {
            const gdCover = document.getElementById('gdCover');
            const attrSrc = gdCover ? (gdCover.getAttribute('src') || '') : '';
            coverUrl = normalizarUrlImagen(attrSrc, 't_cover_big');
        }
        if (!coverUrl && juegoObj.cover) {
            coverUrl = normalizarUrlImagen(juegoObj.cover.image_id || juegoObj.cover.url, 't_cover_big');
        }
        if (!coverUrl) {
            coverUrl = normalizarUrlImagen(juegoObj.caratula || juegoObj.portada || juegoObj.coverUrl || juegoObj.imagen || temaConDatos.juegoCover, 't_cover_big');
        }
        if (!coverUrl && window.SagaApp && typeof window.SagaApp.resolverUrlCaratula === 'function') {
            coverUrl = normalizarUrlImagen(window.SagaApp.resolverUrlCaratula(juegoObj), 't_cover_big');
        }
        if (!coverUrl) {
            coverUrl = 'https://via.placeholder.com/264x352?text=Portada';
        }

        // 3. Artwork / Screenshot para el Banner superior
        let artworkUrl = '';
        if (juegoObj.artworks && Array.isArray(juegoObj.artworks) && juegoObj.artworks.length > 0) {
            const art = juegoObj.artworks[0];
            artworkUrl = normalizarUrlImagen((art && art.image_id) || art, 't_1080p');
        }
        if (!artworkUrl && juegoObj.screenshots && Array.isArray(juegoObj.screenshots) && juegoObj.screenshots.length > 0) {
            const sc = juegoObj.screenshots[0];
            artworkUrl = normalizarUrlImagen((sc && sc.image_id) || sc, 't_1080p');
        }
        if (!artworkUrl && fichaCorrespondeAlJuego) {
            const bgEl = document.getElementById('gdBackdrop') || document.getElementById('gdBg') || detailScreen.querySelector('[style*="background-image"]');
            if (bgEl && bgEl.style && bgEl.style.backgroundImage) {
                const m = bgEl.style.backgroundImage.match(/url\(['"]?([^'"]+)['"]?\)/);
                if (m && m[1]) artworkUrl = normalizarUrlImagen(m[1], 't_1080p');
            }
        }
        if (!artworkUrl && temaConDatos.juegoArtwork) {
            artworkUrl = normalizarUrlImagen(temaConDatos.juegoArtwork, 't_1080p');
        }
        if (!artworkUrl) {
            artworkUrl = coverUrl.replace('t_cover_big', 't_1080p');
        }

        // 4. Fecha de Lanzamiento y Género
        let fecha = '';
        let genero = '';

        const limpiarIconosTexto = function(str) {
            return String(str || '')
                .replace(/\b(calendar_today|event|sell|label|category|videogame_asset|sports_esports|person_add)\b/gi, '')
                .trim();
        };

        if (fichaCorrespondeAlJuego) {
            const bloquesFicha = Array.from(detailScreen.querySelectorAll('div, span, p'));
            for (let i = 0; i < bloquesFicha.length; i++) {
                const nodo = bloquesFicha[i];
                const txtLimpio = limpiarIconosTexto(nodo.textContent).toUpperCase();

                if (txtLimpio === 'LANZAMIENTO' && !fecha) {
                    let herm = nodo.nextElementSibling || (nodo.parentElement ? nodo.parentElement.nextElementSibling : null);
                    if (herm) {
                        const candidato = limpiarIconosTexto(herm.textContent);
                        if (candidato && candidato.toUpperCase() !== 'LANZAMIENTO') fecha = candidato;
                    }
                }
                if ((txtLimpio === 'GÉNEROS' || txtLimpio === 'GENEROS') && !genero) {
                    let hermGen = nodo.nextElementSibling || (nodo.parentElement ? nodo.parentElement.nextElementSibling : null);
                    if (hermGen) {
                        const candidatoGen = limpiarIconosTexto(hermGen.textContent);
                        if (candidatoGen && !/G[ÉE]NEROS/i.test(candidatoGen) && !/no especificado/i.test(candidatoGen)) {
                            genero = candidatoGen;
                        }
                    }
                }
            }
        }

        if (!fecha && juegoObj) {
            if (juegoObj.first_release_date) {
                const ts = juegoObj.first_release_date < 10000000000 ? juegoObj.first_release_date * 1000 : juegoObj.first_release_date;
                fecha = new Date(ts).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
            } else if (juegoObj.lanzamiento || juegoObj.fecha_lanzamiento || juegoObj.release_date) {
                fecha = String(juegoObj.lanzamiento || juegoObj.fecha_lanzamiento || juegoObj.release_date).trim();
            }
        }

        if (!genero && juegoObj) {
            if (Array.isArray(juegoObj.genres) && juegoObj.genres.length > 0) {
                genero = juegoObj.genres.map(function(g) { return (g && g.name) || g; }).filter(Boolean).join(', ');
            } else if (juegoObj.generos || juegoObj.genero) {
                const gStr = String(juegoObj.generos || juegoObj.genero).trim();
                if (!/no especificado/i.test(gStr)) genero = gStr;
            }
        }

        // 5. Descripción
        let descripcion = '';
        if (fichaCorrespondeAlJuego) {
            const descEl = document.getElementById('gdSynopsis') || document.getElementById('gdSummary') || document.getElementById('gdDescription');
            if (descEl && descEl.textContent) {
                descripcion = descEl.textContent.trim();
            }
        }
        if (!descripcion && (juegoObj.sinopsis || juegoObj.summary || juegoObj.descripcion)) {
            descripcion = String(juegoObj.sinopsis || juegoObj.summary || juegoObj.descripcion).trim();
        }

        return {
            id: idStr,
            titulo: titulo,
            coverUrl: coverUrl,
            artworkUrl: artworkUrl,
            fecha: fecha,
            genero: genero,
            descripcion: descripcion || ('Comunidad oficial de jugadores de ' + titulo + ' en Checkpoint.')
        };
    },

