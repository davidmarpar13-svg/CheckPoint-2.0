window.mejorarTarjetasYBotonResenaEnFicha = function(forzarRefrescoLikes) {
    const detailScreen = document.getElementById('gameDetailScreen');
    if (!detailScreen || detailScreen.classList.contains('hidden')) return;

    window.sincronizarMapaMisResenasDesdeDOM();

    const idJuego = String(window.juegoActualEnFichaId || window.currentGameId || '').trim();
    const elTitFicha = document.getElementById('gdTitle');
    const elCovFicha = document.getElementById('gdCover');
    const tituloFichaReal = (elTitFicha && elTitFicha.textContent) ? elTitFicha.textContent.trim() : '';
    const coverFichaReal = (elCovFicha && elCovFicha.src) ? elCovFicha.src : '';
    const usuarioActivo = window.ComunidadApp ? window.ComunidadApp.obtenerUsuarioActivo() : { uid: 'anon', nombre: 'DAVID' };

    const creditoIGDB = document.getElementById('gdCreditoIGDB');
    if (elTitFicha && creditoIGDB && elTitFicha.nextElementSibling !== creditoIGDB) {
        elTitFicha.insertAdjacentElement('afterend', creditoIGDB);
    }

    const candidatosInternos = Array.from(detailScreen.querySelectorAll('div')).filter(function(div) {
        if (window.esContenedorDeJuegoOPerfil(div)) return false;
        if (div.id && /tab|review|resena|ficha|media|content/i.test(div.id)) return false;
        if (div.querySelector('textarea')) return false;
        if (div.classList.contains('resena-limpia-top') || div.classList.contains('resena-limpia-user') || div.classList.contains('resena-limpia-actions')) return false;

        const txt = (div.textContent || '').replace(/\s+/g, ' ').trim();
        if (!/\d+\s*\/\s*10/.test(txt)) return false;
        return Boolean(div.querySelector('img'));
    });

    const tarjetasRaizSet = new Set();
    candidatosInternos.forEach(function(div) {
        if (div.classList.contains('resena-ficha-item-limpio')) {
            tarjetasRaizSet.add(div);
            return;
        }
        let actual = div;
        const padre = actual.parentElement;
        if (padre && !window.esContenedorDeJuegoOPerfil(padre) && !padre.id) {
            const imgsEnPadre = padre.querySelectorAll('img');
            const abuelo = padre.parentElement;
            const esContenedorDePestana = abuelo && (window.esContenedorDeJuegoOPerfil(abuelo) || abuelo.querySelector('#gdSynopsis') || abuelo.querySelector('[id*="Tab"], [id*="tab"]'));
            if (imgsEnPadre.length === 1 && !esContenedorDePestana) {
                actual = padre;
            }
        }
        tarjetasRaizSet.add(actual);
    });

    const tarjetasRaiz = Array.from(tarjetasRaizSet);
    let usuarioTieneResenaEnFicha = false;

    tarjetasRaiz.forEach(function(card, idx) {
        if (!card.dataset.datosExtraidosLimpio) {
            const imgEl = card.querySelector('img');
            const avatarSrc = imgEl ? imgEl.src : 'https://ui-avatars.com/api/?name=U';
            const matchNotaGlobal = (card.textContent || '').match(/(\d+)\s*\/\s*10/);
            const notaNum = matchNotaGlobal ? parseInt(matchNotaGlobal[1], 10) : 8;

            const textosNodos = Array.from(card.querySelectorAll('h3, h4, strong, b, span, p, div'))
                .filter(function(el) { return el.children.length === 0 && !el.classList.contains('material-symbols-rounded'); })
                .map(function(el) { return (el.textContent || '').trim(); })
                .filter(function(t) { return t && !/^(star|arrow_back|favorite|favorite_border|chevron_right|more_vert|share|delete|edit)$/i.test(t); });

            const autorNombre = textosNodos.find(function(t) {
