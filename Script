                    titulo: '❤️ A ' + usuario.nombre + ' le gustó tu comentario',
                    mensaje: 'En el tema "' + (tema.titulo || '') + '": "' + (comentario.texto ? comentario.texto.slice(0, 55) : 'Tu imagen') + '"',
