['abrirListasJuego', 'abrirListasDelJuego', 'verListasJuego', 'mostrarListasJuego'].forEach(nombreFn => {
    if (typeof window[nombreFn] === 'function' && !window['_' + nombreFn + 'Hooked']) {
        window['_' + nombreFn + 'Hooked'] = true;
        const fnOriginal = window[nombreFn];
        window[nombreFn] = async function(idParam) {
            if (idParam && (typeof idParam === 'string' || typeof idParam === 'number')) {
                window.juegoActualEnFichaId = String(idParam);
            }
            const res = await fnOriginal.apply(this, arguments);
            setTimeout(() => window.filtrarTarjetasListasPorJuegoActual(window.juegoActualEnFichaId), 50);
            setTimeout(() => window.filtrarTarjetasListasPorJuegoActual(window.juegoActualEnFichaId), 250);
            return res;
        };
    }
});

