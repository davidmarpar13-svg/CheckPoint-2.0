        const tema = (this.temasActuales || []).find(function(t) { return t && t.id === idTema; });
        if (!tema || !Array.isArray(tema.comentarios)) return;

        const comentario = tema.comentarios.find(function(c) { return c && c.id === idComentario; });
        if (!comentario) return;

        const usuario = this.obtenerUsuarioActivo();
        comentario.likes = Array.isArray(comentario.likes) ? comentario.likes : [];
        comentario.likesDetalle = Array.isArray(comentario.likesDetalle) ? comentario.likesDetalle : [];

        const idx = comentario.likes.indexOf(usuario.uid);
        if (idx === -1) {
            comentario.likes.push(usuario.uid);
            comentario.likesDetalle.push({
                uid: usuario.uid,
                nombre: usuario.nombre,
                fecha: Date.now()
