    const titulo = ctx.titulo || 'Mi Lista';
    const texto = '📋 Lista "' + titulo + '" en Checkpoint\n¡Descubre los juegos de esta lista!';
    try { if (navigator.clipboard && navigator.clipboard.writeText) await navigator.clipboard.writeText(texto); } catch (err) {}
    if (navigator.share) {
        try { await navigator.share({ title: 'Lista: ' + titulo, text: texto }); return; } catch (err) {}
    }
    if (typeof window.mostrarToastAvisoEstreno === 'function') {
        window.mostrarToastAvisoEstreno('📤 Lista compartida', 'Se ha copiado "' + titulo + '" al portapapeles.');
