window.resolverIdJuegoDeTarjetaResena = function(cardEl, tituloJuego) {
    if (cardEl) {
        const nodoConOnclick = cardEl.getAttribute('onclick') ? cardEl : cardEl.querySelector('[onclick]');
        const attr = nodoConOnclick ? (nodoConOnclick.getAttribute('onclick') || '') : '';
        const matchId = attr.match(/['"]?(\d+)['"]?/);
        if (matchId && matchId[1]) return String(matchId[1]);
    }
    const titNorm = String(tituloJuego || '').toLowerCase().trim();
    if (!titNorm) return '';

    const buscarEnMapa = function(mapa) {
        if (!mapa || typeof mapa !== 'object') return '';
        const claves = Object.keys(mapa);
        for (let i = 0; i < claves.length; i++) {
            const item = mapa[claves[i]];
            if (!item) continue;
            const nom = String(item.nombre || item.name || item.title || item.titulo || '').toLowerCase().trim();
            if (nom === titNorm) return String(item.id || claves[i]);
        }
        return '';
    };
    return buscarEnMapa(window.miColeccionActiva) || buscarEnMapa(window.juegosCargados) || buscarEnMapa(window.misAvisosEstreno) || '';
};

