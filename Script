            if (!tieneAfinidadDev && String(id) !== String(this.idJuegoRaizSaga)) return;

            const nNorm = this.normalizarSinTildes(nombrePropio);
            if (!regexContieneSagaPalabra.test(nNorm)) return;

            const claveTitulo = item.nombreBase;
            const existentesConMismoNombre = principalesPorTituloBase.get(claveTitulo) || [];

            if (existentesConMismoNombre.length === 0) {
                existentesConMismoNombre.push(item);
                principalesPorTituloBase.set(claveTitulo, existentesConMismoNombre);
                idsUsadosEnPrincipales.add(id);
                principales.push(item);
            } else {
                const esDistintoPorIdYFecha = existentesConMismoNombre.every(existente => {
                    if (String(existente.id) === String(item.id)) return false;
                    if (item.esProximamente !== existente.esProximamente) return true;
                    const difAnios = (item.anio && existente.anio) ? Math.abs(item.anio - existente.anio) : 0;
                    return difAnios >= 4;
                });

                if (esDistintoPorIdYFecha) {
                    existentesConMismoNombre.forEach(ex => {
                        if (!ex.esProximamente && ex.anio && !ex.nombre.includes(`(${ex.anio})`)) {
                            ex.nombre = `${ex.nombre} (${ex.anio})`;
                        }
                    });
                    if (!item.esProximamente && item.anio && !item.nombre.includes(`(${item.anio})`)) {
                        item.nombre = `${item.nombre} (${item.anio})`;
                    }
                    existentesConMismoNombre.push(item);
                    idsUsadosEnPrincipales.add(id);
                    principales.push(item);
                }
            }
        });

        // BARRERA PADRE-HIJO SOLO PARA JUEGOS NUMERADOS (ej. "Devil May Cry 5" bloquea "Devil May Cry 5: Mega Buster", pero "Prince of Persia" NO bloquea "Prince of Persia: The Sands of Time")
        const titulosPadresNumerados = principales
            .map(p => this.normalizarSinTildes(p.nombre.replace(/\s*\(\d{4}\)$/, '')))
            .filter(t => !t.includes(':') && /\s+([2-9]|[1-9][0-9]|ii|iii|iv|v|vi|vii|viii|ix|x)$/i.test(t));

        principales = principales.filter(candidato => {
            if (candidato.esReglaOficial) return true;
            const nombreCandNorm = this.normalizarSinTildes(candidato.nombre);
            const esSubItemDeUnJuegoNumerado = titulosPadresNumerados.some(padre =>
                nombreCandNorm !== padre &&
                (nombreCandNorm.startsWith(padre + ':') || nombreCandNorm.startsWith(padre + ' -'))
            );
            return !esSubItemDeUnJuegoNumerado;
        });

        const ordenarNuevosPrimero = (a, b) => {
            if (b.ordenCronologico !== a.ordenCronologico) {
                return b.ordenCronologico - a.ordenCronologico;
            }
            return a.nombre.localeCompare(b.nombre);
        };

        principales.sort(ordenarNuevosPrimero);
        todo.sort(ordenarNuevosPrimero);

        return { principales, todo };
    },

    cambiarPestana: function(pestana) {
        this.estado.pestanaActiva = pestana;
        const esPrin = pestana === 'principales';

        document.getElementById('btnTabSagaPrincipales').classList.toggle('activa', esPrin);
        document.getElementById('btnTabSagaTodo').classList.toggle('activa', !esPrin);
        document.getElementById('sagaTabSlider').style.transform = esPrin ? 'translateX(0%)' : 'translateX(100%)';

        const filtro = document.getElementById('inputBuscadorInternoSaga').value;
        this.renderizarGrid(filtro);
    },

    renderizarGrid: function(textoFiltro) {
        const contenedor = document.getElementById('contenedorGridSaga');
        if (!contenedor) return;

        const filtro = this.normalizarSinTildes(textoFiltro);
        const esPrin = this.estado.pestanaActiva === 'principales';
        const origen = esPrin ? this.estado.principales : this.estado.todo;
        const lista = origen.filter(j => !filtro || this.normalizarSinTildes(j.nombre).includes(filtro));

        if (lista.length === 0) {
            contenedor.innerHTML = `<div style="grid-column: 1 / -1; text-align: center; padding: 40px 20px; color: #888; font-size: 0.86rem;">No hay resultados en esta sección.</div>`;
            return;
        }

        const colUsuario = window.miColeccionActiva || {};
        contenedor.innerHTML = lista.map(j => {
            const cover = j.coverUrl || 'https://via.placeholder.com/240x320/f3f4f6/666666?text=Sin+Portada';
            const enColeccion = Boolean(colUsuario[String(j.id)]);
            const tag = esPrin ? j.etiquetaPrincipal : j.etiquetaTodo;
            const esExtra = tag.includes('DLC') || tag.includes('Objeto') || tag.includes('Fan Game') || tag.includes('Cancelado') || tag.includes('LCD') || tag.includes('Minijuego') || tag.includes('Remaster') || tag.includes('Recopilación') || tag.includes('Edición') || tag.includes('Móvil');
            const esProximo = tag.includes('Próximamente');

            const bgBadge = esProximo ? '#e0f2fe' : (esExtra ? '#fef3c7' : '#f3f4f6');
            const colorBadge = esProximo ? '#0369a1' : (esExtra ? '#b45309' : '#444444');

            return `
