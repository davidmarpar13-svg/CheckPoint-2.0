(function conectarHooksSegurosFicha() {
    if (window._hooksSegurosFichaConectados) return;
    window._hooksSegurosFichaConectados = true;

    const funcionesAHookear = [
        'openGameDetail',
        'añadirAlInventario',
        'actualizarEstadoJuego',
        'marcarComoFavoritoDesdeFicha',
        'borrarJuegoDeColeccion'
    ];

    funcionesAHookear.forEach(nombreFn => {
        if (typeof window[nombreFn] === 'function' && !window['_' + nombreFn + 'FichaHook']) {
            window['_' + nombreFn + 'FichaHook'] = true;
            const fnOriginal = window[nombreFn];
            window[nombreFn] = function() {
                const res = fnOriginal.apply(this, arguments);
                setTimeout(window.prepararInterfazFichaSinBucle, 15);
                setTimeout(window.prepararInterfazFichaSinBucle, 120);
                return res;
            };
        }
    });

    document.addEventListener('click', function(e) {
        setTimeout(window.limpiarTarjetasBasuraEnDOM, 100);

        const detailScreen = document.getElementById('gameDetailScreen');
        if (!detailScreen || !detailScreen.contains(e.target)) return;

        if (detailScreen.dataset.juegoNoEstrenado === 'true') {
            const iconsContainer = document.getElementById('gdIconsContainer');
            if (iconsContainer && iconsContainer.contains(e.target)) {
                const nodoClicado = e.target.closest('.estado-no-estrenado-fijo, [onclick*="mostrarAvisoJuegoNoEstrenado"]');
                const textoClicado = (e.target.textContent || '').trim().toUpperCase();
                if (nodoClicado || textoClicado === 'PENDIENTE' || textoClicado === 'SPORTS_ESPORTS') {
                    e.stopImmediatePropagation();
                    e.preventDefault();
                    window.mostrarAvisoJuegoNoEstrenado(e);
                    return;
                }
            }
        }

        if (e.target.closest('#btn-fav-ficha')) {
            setTimeout(window.prepararInterfazFichaSinBucle, 30);
            return;
        }

        if (!window.SagaApp || !window.SagaApp.volverASagaPendiente) return;

        const sagaOverlay = document.getElementById('sagaJuegoOverlay');
        if (sagaOverlay && sagaOverlay.style.display !== 'none') return;

        const clickable = e.target.closest('button, a, div[onclick], span[onclick], .back-btn, [id*="Back"], [id*="Close"]');
        const onclickStr = clickable ? (clickable.getAttribute('onclick') || '') : '';
        const texto = (clickable || e.target).textContent ? (clickable || e.target).textContent.trim().toLowerCase() : '';
        const rect = (clickable || e.target).getBoundingClientRect();

        const esBotonAtrasFicha =
            /closeGameDetail|cerrarFicha|gameDetailScreen|volver|back/i.test(onclickStr) ||
            ['<', '‹', '←', 'arrow_back', 'arrow_back_ios', 'chevron_left'].includes(texto) ||
            (rect.top < 110 && rect.left < 95 && rect.width < 80 && rect.height < 80);

        if (esBotonAtrasFicha) {
            e.stopImmediatePropagation();
            e.preventDefault();
            window.SagaApp.regresarAListaSaga();
        }
    }, true);
})();

