    obtenerTextoDescripcionCompleto: function(j) {
        if (!j || typeof j !== 'object') return '';
        const partes = [
            j.descripcion, j.sinopsis, j.resumen, j.summary, j.storyline,
            j.description, j.overview, j.plot, j.historia, j.info, j.detalles
        ];
        Object.values(j).forEach(val => {
            if (typeof val === 'string' && val.length > 35 && !val.startsWith('http') && !val.startsWith('//')) {
                partes.push(val);
            }
        });
        return partes.filter(Boolean).join(' ').toLowerCase().trim();
    },

    obtenerTimestampLanzamiento: function(j) {
        if (!j || typeof j !== 'object') return null;

        const mesesES = {
            enero: 0, febrero: 1, marzo: 2, abril: 3, mayo: 4, junio: 5,
            julio: 6, agosto: 7, septiembre: 8, setiembre: 8, octubre: 9, noviembre: 10, diciembre: 11
        };

        const campos = [
            j.first_release_date, j.release_date, j.releaseDate,
            j.lanzamiento, j.fecha_lanzamiento, j.fecha, j.human_date,
            ...Object.values(j).filter(v => typeof v === 'string' && v.length < 40)
        ];

        for (const val of campos) {
            if (val === undefined || val === null || val === '') continue;

            if (typeof val === 'number' && val > 100000) {
                return val < 10000000000 ? val * 1000 : val;
            }

            if (typeof val === 'string') {
                const str = val.toLowerCase().trim();
                const mEs = str.match(/(\d{1,2})\s+de\s+([a-záéíóú]+)\s+de\s+(19\d\d|20\d\d)/i);
                if (mEs) {
                    const dia = Number(mEs[1]);
                    const mes = mesesES[mEs[2].normalize('NFD').replace(/[\u0300-\u036f]/g, '')];
                    const anio = Number(mEs[3]);
                    if (mes !== undefined) {
                        return new Date(anio, mes, dia, 12, 0, 0).getTime();
                    }
                }
                if (/^\d{9,13}$/.test(str)) {
                    const num = Number(str);
                    return num < 10000000000 ? num * 1000 : num;
                }
            }
        }
        return null;
    },

