        const esDLCoArmaPorDescripcion = regexDLCsArmasYCodigosEnDescripcion.test(desc);

        // B) Detector de FAN GAMES / ROMHACKS
        const regexFanGame = new RegExp(
            '\\b(fan\\s*game|fangame|fan-game|fan\\s*made|fan-made|hecho por fans|creado por fans|juego de fans|proyecto de fans|' +
            'rom\\s*hack|romhack|hack\\s*rom|hack\\s+of|modificaci[oó]n|mod\\s+de|mod\\s+for|multiplayer\\s+mod|randomizer|' +
