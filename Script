    obtenerGenerosDeFicha: function(raiz, juegoFallback) {
        const nodos = Array.from(raiz.querySelectorAll('div, span, p'));
        const idx = nodos.findIndex(el => /G[ÉE]NEROS/i.test((el.textContent || '').trim()));
        let textoGen = (idx !== -1 && nodos[idx + 1]) ? (nodos[idx + 1].textContent || '') : '';
        if (!textoGen && juegoFallback) {
            textoGen = String(juegoFallback.genero || juegoFallback.generos || '');
