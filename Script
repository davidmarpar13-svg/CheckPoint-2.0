                            ${tag}
                        </span>
                    </div>
                </div>
            `;
        }).join('');
    },

    abrirJuego: async function(idJuego) {
        const idStr = String(idJuego).trim();
        let juegoRaw = this.registroJuegosIGDB[idStr];

        if (!juegoRaw || !this.esObjetoCompletoIGDB(juegoRaw)) {
            const itemEnLista = [...this.estado.principales, ...this.estado.todo].find(x => String(x.id) === idStr);
            if (itemEnLista && itemEnLista.nombre) {
                const res = await this.consultarIGDB(itemEnLista.nombre.replace(/\s*\(\d{4}\)$/, ''));
                juegoRaw = res.find(x => String(x.id) === idStr) || res[0] || juegoRaw;
            }
        }

        if (juegoRaw) {
            const normalizado = this.normalizarObjetoIGDB(juegoRaw);
            this.registroJuegosIGDB[idStr] = normalizado;
            this.inyectarEnCachesNativos(normalizado);
        }

        const grid = document.getElementById('contenedorGridSaga');
        this.scrollGuardado = grid ? grid.scrollTop : 0;

        if (typeof window.openGameDetail === 'function') {
            window.openGameDetail(idStr);
        }

        const overlay = document.getElementById('sagaJuegoOverlay');
        if (overlay) overlay.style.display = 'none';
        this.volverASagaPendiente = true;
    }
};

