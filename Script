                overlay.appendChild(contenedorExtra);
            }
            const banner = infoLista.banner || 'linear-gradient(135deg, #2b5876 0%, #4e4376 100%)';
            const juegosIds = infoLista.juegos;
            let caratulasHTML = '';
            juegosIds.slice(0, 6).forEach(jId => {
                const jInfo = coleccion[String(jId)] || (infoLista.juegosInfo && infoLista.juegosInfo[String(jId)]);
                if (jInfo && jInfo.caratula) {
                    caratulasHTML += `<img src="https://images.igdb.com/igdb/image/upload/t_cover_small/${jInfo.caratula}.jpg" style="width: 38px; height: 50px; object-fit: cover; border-radius: 6px; box-shadow: 0 2px 5px rgba(0,0,0,0.2);">`;
                }
            });
            contenedorExtra.innerHTML = `
                <div onclick="if(typeof window.abrirDetalleLista==='function') window.abrirDetalleLista('${idLista}')" style="width: 100%; border-radius: 16px; overflow: hidden; background: #ffffff; box-shadow: 0 4px 15px rgba(0,0,0,0.06); cursor: pointer; border: 1px solid rgba(0,0,0,0.05); display: flex; flex-direction: column;">
                    <div style="position: relative; width: 100%; height: 95px; background: ${banner}; background-size: cover; background-position: center;">
                        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.35);"></div>
                        <div style="position: relative; z-index: 1; padding: 14px; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; box-sizing: border-box;">
                            <h3 style="color: #ffffff; font-family: 'Cinzel', serif; margin: 0; font-size: 1.05rem; font-weight: 700;">${infoLista.titulo || 'Lista'}</h3>
                            ${infoLista.descripcion ? `<p style="color: #eeeeee; font-family: 'Outfit', sans-serif; margin: 2px 0 0 0; font-size: 0.78rem;">${infoLista.descripcion}</p>` : ''}
                        </div>
                    </div>
                    <div style="padding: 10px 14px; display: flex; align-items: center; justify-content: space-between; background: #fafafa; border-top: 1px solid #f0f0f0;">
                        <div style="display: flex; align-items: center; gap: 6px; font-family: 'Outfit', sans-serif; font-size: 0.8rem; color: #555; font-weight: 600;">
                            ${juegosIds.length} <span class="material-symbols-rounded" style="font-size: 16px; color: #666;">sports_esports</span>
                        </div>
                        <div style="display: flex; gap: 6px; overflow: hidden;">${caratulasHTML}</div>
                    </div>
                </div>
            `;
        }
    });

    // Ocultamos o mostramos el aviso nativo si ya existe
    const cajasNativasVacias = Array.from(overlay.querySelectorAll('div, p')).filter(el =>
        el.id !== 'msgSinListasParaEsteJuego' &&
        el.children.length <= 3 &&
        (el.textContent || '').includes('Este juego no está incluido en ninguna lista todavía')
    );

    let msgVacio = document.getElementById('msgSinListasParaEsteJuego');
    if (visibles === 0) {
        if (cajasNativasVacias.length > 0) {
            cajasNativasVacias.forEach(c => { c.style.display = ''; });
            if (msgVacio) msgVacio.style.display = 'none';
        } else if (tarjetas.length > 0) {
            if (!msgVacio) {
                msgVacio = document.createElement('div');
                msgVacio.id = 'msgSinListasParaEsteJuego';
                tarjetas[0].parentElement.appendChild(msgVacio);
            }
            msgVacio.style.cssText = 'background: #f5f6f8; border: 1px solid #e5e7eb; border-radius: 16px; padding: 30px 20px; text-align: center; width: 100%; box-sizing: border-box; margin-top: 10px; display: block;';
