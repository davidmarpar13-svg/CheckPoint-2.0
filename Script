window.toggleProfileTab = function(tabName, btnElement) {
    if (!btnElement) {
        console.error("Falta el botón en la llamada (this).");
        return;
    }

    console.log("Has hecho clic en la pestaña:", tabName);

    // 1. Redirigimos el nombre para usar el contenedor de reseñas del perfil
    if (tabName === 'resenas' || tabName === 'reviews') {
        tabName = 'resenasPerfil';
    }

    // 2. Ejecutamos la función de pintar reseñas si es la pestaña correcta
    if (tabName === 'resenasPerfil') {
        if (typeof window.pintarResenasPerfil === 'function') {
            console.log("Pintando reseñas...");
            window.pintarResenasPerfil();
        } else {
            console.error("¡La función pintarResenasPerfil no existe!");
        }
    }

    // 3. Los IDs exactos de los contenedores HTML
    const tabs = ['coleccion', 'resenasPerfil', 'listas', 'temas'];
    const btns = ['btnTabColeccion', 'btnTabResenas', 'btnTabListas', 'btnTabTemas'];

    // 4. Ocultar todos los contenedores primero
    tabs.forEach(t => {
        const tabEl = document.getElementById('tab-' + t);
        if (tabEl) {
            tabEl.style.display = 'none';
        }
    });

    // 5. Quitar la raya negra de todos los botones
    btns.forEach(b => {
        const btnEl = document.getElementById(b);
        if (btnEl) {
            btnEl.classList.remove('active-tab');
        }
    });

    // 6. Forzar visibilidad absoluta ignorando cualquier CSS global
    const selectedTab = document.getElementById('tab-' + tabName);
    if (selectedTab) {
        console.log("Mostrando contenedor: tab-" + tabName);
        selectedTab.style.setProperty('display', 'block', 'important'); 
    } else {
        console.error("¡No se ha encontrado el contenedor HTML llamado: tab-" + tabName + "!");
    }
    // 7. Poner la raya negra al botón pulsado
    btnElement.classList.add('active-tab');
};

