// =========================================================
    // SISTEMA MAESTRO DE EDICIÓN (FOTOS, NOMBRE Y BIO)
    // =========================================================
    
    // 1. SELECCIÓN DE ELEMENTOS
    const btnToggleEditMode = document.getElementById('btnToggleEditMode');
    const iconEditToggle = document.getElementById('iconEditToggle');
    const bannerEditOverlay = document.getElementById('bannerEditOverlay');
    const avatarEditOverlay = document.getElementById('avatarEditOverlay');
    
    const uploadBannerInput = document.getElementById('uploadBannerInput');
    const uploadAvatarInput = document.getElementById('uploadAvatarInput');
    const uploadingSpinner = document.getElementById('uploadingSpinner');
    const uploadingText = document.getElementById('uploadingText');

    const pUser = document.getElementById('profileUsername');
    const inName = document.getElementById('inputNewName');
    
    const pBio = document.getElementById('profileBio');
    const inBio = document.getElementById('inputNewBio');
    const bioCounterCont = document.getElementById('bioCounterContainer');
    const bioCounter = document.getElementById('bioCounter');

    let isEditingProfile = false; // Estado del perfil

    // 2. CONTADOR DE BIOGRAFÍA
    if (inBio) {
        inBio.addEventListener('input', () => {
            if (bioCounter) bioCounter.textContent = `${inBio.value.length}/150`;
        });
    }

    // 3. ACTIVAR CÁMARA/GALERÍA AL TOCAR LAS FOTOS (Esto era lo que faltaba)
    if (bannerEditOverlay) bannerEditOverlay.onclick = () => { if(uploadBannerInput) uploadBannerInput.click(); };
    if (avatarEditOverlay) avatarEditOverlay.onclick = () => { if(uploadAvatarInput) uploadAvatarInput.click(); };

    // 4. FUNCIÓN PARA COMPRIMIR Y SUBIR FOTOS A FIREBASE
    async function uploadImageToStorage(file, type) {
        const user = auth.currentUser;
        if (!user) return alert("Debes iniciar sesión.");
        
        try {
            uploadingSpinner.style.display = 'flex';
            uploadingText.innerText = `Preparando ${type}...`;
            
            const compressedBlob = await new Promise((resolve, reject) => {
                const img = new Image();
                img.src = URL.createObjectURL(file);
                img.onload = () => {
                    const canvas = document.createElement('canvas');
                    const MAX_WIDTH = type === 'banner' ? 1200 : 400;
                    const scaleSize = MAX_WIDTH / img.width;
                    let width = img.width;
                    let height = img.height;

                    if (scaleSize < 1) {
                        width = MAX_WIDTH;
                        height = img.height * scaleSize;
                    }

                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);

                    canvas.toBlob((blob) => { resolve(blob); }, 'image/jpeg', 0.7);
                };
                img.onerror = (e) => reject(e);
            });

            uploadingText.innerText = `Subiendo ${type}...`;
            
            const storageRef = ref(storage, `users/${user.uid}/${type}_${Date.now()}.jpg`);
            await uploadBytes(storageRef, compressedBlob);
            const downloadURL = await getDownloadURL(storageRef);
            
            const updateData = {};
            if (type === 'avatar') updateData.avatarUrl = downloadURL;
            if (type === 'banner') updateData.bannerUrl = downloadURL;
            await setDoc(doc(db, "users", user.uid), updateData, { merge: true });

            if (type === 'banner') document.getElementById('profileBanner').style.background = `url('${downloadURL}') center/cover no-repeat`;
            if (type === 'avatar') {
                document.getElementById('profileAvatarImg').src = downloadURL;
                document.getElementById('profileAvatarImg').style.display = 'block';
                document.getElementById('profileAvatarSvg').style.display = 'none';
            }

            uploadingSpinner.style.display = 'none';
            
        } catch (error) {
            uploadingSpinner.style.display = 'none';
            alert("Error al procesar la imagen: " + error.message);
        }
    }

    // Detectar cuando seleccionas una foto en el móvil/PC
    if (uploadBannerInput) uploadBannerInput.addEventListener('change', (e) => { if (e.target.files[0]) uploadImageToStorage(e.target.files[0], 'banner'); });
    if (uploadAvatarInput) uploadAvatarInput.addEventListener('change', (e) => { if (e.target.files[0]) uploadImageToStorage(e.target.files[0], 'avatar'); });

    // 5. LÓGICA DEL BOTÓN LÁPIZ (Sin errores de bloqueo)
    if (btnToggleEditMode) {
        // Truco: clonamos el botón para borrar clics atascados antiguos
        const newBtn = btnToggleEditMode.cloneNode(true);
        btnToggleEditMode.parentNode.replaceChild(newBtn, btnToggleEditMode);
        const finalBtn = document.getElementById('btnToggleEditMode');
        const finalIcon = document.getElementById('iconEditToggle');

        finalBtn.addEventListener('click', async (e) => {
            e.preventDefault();
            
            if (!isEditingProfile) {
                // ENTRAR EN MODO EDICIÓN
                isEditingProfile = true;
                
                bannerEditOverlay.classList.remove('hidden');
                avatarEditOverlay.classList.remove('hidden');
                
                pUser.classList.add('hidden');
                inName.classList.remove('hidden');
                inName.value = pUser.textContent;
                
                pBio.classList.add('hidden');
                inBio.classList.remove('hidden');
                inBio.value = (pBio.textContent === 'Sin descripción.') ? '' : pBio.textContent;
                
                bioCounterCont.classList.remove('hidden');
                if (bioCounter) bioCounter.textContent = `${inBio.value.length}/150`;
                
                inName.focus(); // El teclado del móvil se abrirá solo

                finalBtn.style.color = '#00ff88'; // Tick Verde
                finalIcon.innerHTML = '<polyline points="20 6 9 17 4 12"></polyline>'; 
                
            } else {
                // GUARDAR CAMBIOS Y SALIR
                const user = auth.currentUser;
                const newName = inName.value.trim();
                const newBio = inBio.value.trim();
                
                if (!user || !newName) {
                    alert("El nombre no puede estar vacío");
                    return;
                }
                
                finalBtn.style.color = '#f1c40f'; // Tick Amarillo (Cargando)
                
                try {
                    await updateProfile(user, { displayName: newName });
                    await setDoc(doc(db, "users", user.uid), { username: newName, bio: newBio }, { merge: true });
                    
                    pUser.textContent = newName;
                    pBio.textContent = newBio || 'Sin descripción.';
                    
                    // Apagar modo edición
                    isEditingProfile = false;
                    bannerEditOverlay.classList.add('hidden');
                    avatarEditOverlay.classList.add('hidden');
                    
                    pUser.classList.remove('hidden');
                    inName.classList.add('hidden');
                    
                    pBio.classList.remove('hidden');
                    inBio.classList.add('hidden');
                    bioCounterCont.classList.add('hidden');
                    
                    finalBtn.style.color = 'white'; // Vuelta al Lápiz Blanco
                    finalIcon.innerHTML = '<path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>';
                    
                } catch (error) {
                    alert("Error al guardar: " + error.message);
                    finalBtn.style.color = '#00ff88'; // Vuelve al verde si falla
                }
            }
        });
    }
// Función GLOBAL para navegar entre las pestañas del perfil
window.toggleProfileTab = function(tabName, btnElement) {
    
    // Verificación de seguridad
    if (!btnElement) {
        console.error("Falta el botón en la llamada (this).");
        return;
    }

    // Los IDs exactos de los textos (HTML)
    const tabs = ['coleccion', 'resenas', 'listas', 'temas'];
    // Los IDs exactos de los botones (HTML)
    const btns = ['btnTabColeccion', 'btnTabResenas', 'btnTabListas', 'btnTabTemas'];
    
    // 1. Ocultar todos los textos
    tabs.forEach(t => { 
        const tabEl = document.getElementById('tab-' + t);
        if (tabEl) {
            tabEl.style.display = 'none'; 
        }
    });
    
    // 2. Quitar la raya negra de todos los botones
    btns.forEach(b => { 
        const btnEl = document.getElementById(b);
        if (btnEl) {
            btnEl.classList.remove('active-tab'); 
        }
    });

    // 3. Mostrar el texto seleccionado
    const selectedTab = document.getElementById('tab-' + tabName);
    if (selectedTab) {
        selectedTab.style.display = 'block';
    }
    
    // 4. Poner la raya negra al botón pulsado
    btnElement.classList.add('active-tab');
};

