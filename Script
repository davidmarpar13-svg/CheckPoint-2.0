    // Dar o quitar Like a un Tema + Notificar al creador del tema
    toggleLikeTema: async function(idTema) {
        const tema = (this.temasActuales || []).find(function(t) { return t && t.id === idTema; });
        if (!tema) return;

        const usuario = this.obtenerUsuarioActivo();
        tema.likes = Array.isArray(tema.likes) ? tema.likes : [];
        tema.likesDetalle = Array.isArray(tema.likesDetalle) ? tema.likesDetalle : [];

        const idx = tema.likes.indexOf(usuario.uid);
        if (idx === -1) {
            tema.likes.push(usuario.uid);
            tema.likesDetalle.push({
                uid: usuario.uid,
                nombre: usuario.nombre,
                fecha: Date.now()
            });

            // Si quien da like no es el propio creador del tema, notificamos al creador del tema
            if (!this.esUsuarioCreadorDelTema(tema)) {
                window.enviarNotificacionAUsuarioDestino(tema.autorUid, tema.autorNombre, {
                    id: 'notif_like_tema_' + tema.id + '_' + (usuario.uid || usuario.nombre),
                    tipo: 'like_tema',
                    titulo: '❤️ A ' + usuario.nombre + ' le gusta tu tema',
                    mensaje: 'Ha dado Me gusta a tu tema "' + (tema.titulo || '') + '" en ' + (tema.juegoTitulo || this.datosJuegoActual.titulo || 'la comunidad') + '.',
                    imagen: tema.foto || this.datosJuegoActual.coverUrl || '',
                    icono: 'favorite',
                    colorIcono: '#e11d48',
                    idJuego: this.idJuegoActual || tema.idJuego || '',
                    idTema: tema.id
                });
            }
        } else {
            tema.likes.splice(idx, 1);
            tema.likesDetalle = tema.likesDetalle.filter(function(l) { return l && l.uid !== usuario.uid; });
        }

