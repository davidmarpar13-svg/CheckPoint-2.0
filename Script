                starEl.style.setProperty('-webkit-text-stroke', '1.3px #64748b', 'important');
                starEl.style.setProperty('filter', 'none', 'important');
                starEl.style.setProperty('opacity', '1', 'important');
                starEl.style.setProperty('font-size', '26px', 'important');
            }

            if (!starEl.dataset.hookClickEstrellaV15) {
                starEl.dataset.hookClickEstrellaV15 = 'true';
                starEl.addEventListener('click', function() {
                    setTimeout(function() { window.repararVisibilidadEstrellasModalResena(cajaModal, ta); }, 10);
                    setTimeout(function() { window.repararVisibilidadEstrellasModalResena(cajaModal, ta); }, 50);
