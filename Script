window.compartirResenaFormateada = async function(tituloJuego, notaTexto, comentarioTexto, autorNombre) {
    const usuario = window.ComunidadApp ? window.ComunidadApp.obtenerUsuarioActivo() : { nombre: 'Jugador' };
    const autorFinal = autorNombre || usuario.nombre || 'Jugador';
    const textoCompartir = '🎮 Mi reseña de ' + (tituloJuego || 'Videojuego') + ' en Checkpoint\n' +
                           '⭐ Nota: ' + (notaTexto || '10/10') + '\n' +
                           (comentarioTexto ? ('💬 "' + comentarioTexto + '"\n') : '') +
                           '— por ' + autorFinal;
    try {
        if (navigator.clipboard && navigator.clipboard.writeText) await navigator.clipboard.writeText(textoCompartir);
    } catch (e) {}
    if (navigator.share) {
        try { await navigator.share({ title: 'Reseña de ' + tituloJuego, text: textoCompartir }); return; } catch (err) {}
    }
    if (typeof window.mostrarToastAvisoEstreno === 'function') {
        window.mostrarToastAvisoEstreno('📤 ¡Reseña lista para compartir!', 'Se ha copiado al portapapeles.');
