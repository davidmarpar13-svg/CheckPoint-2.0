// NUEVA FUNCIÓN: Pinta los juegos y los filtra si hay texto
window.renderizarListaFavoritos = function(filtro) {
    const list = document.getElementById('favGameList');
    if (!list) return;

    if (!window.miColeccionActiva || Object.keys(window.miColeccionActiva).length === 0) {
        list.innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 40px 20px;"><p style="color: #666; font-family: 'Outfit', sans-serif; font-size: 1.1rem; font-weight: bold;">Tu colección está vacía.</p></div>`;
        return;
    }

    const textoFiltro = filtro.toLowerCase().trim();
    let html = '';
    let encontrados = 0;

    Object.values(window.miColeccionActiva).forEach(juego => {
        // Solo pintamos el juego si el nombre contiene lo que hemos escrito
        if (textoFiltro !== "" && !juego.nombre.toLowerCase().includes(textoFiltro)) {
            return;
        }

        encontrados++;
        const caratulaUrl = juego.caratula ? `https://images.igdb.com/igdb/image/upload/t_cover_small/${juego.caratula}.jpg` : 'https://via.placeholder.com/90x120/f3f4f6/111111?text=Sin+Portada';
        
        html += `
            <div onclick="window.guardarFavorito('${juego.id}')" style="cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                <img src="${caratulaUrl}" style="width: 100%; aspect-ratio: 3/4; object-fit: cover; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.15);">
                <span style="font-size: 0.75rem; color: #222; font-weight: 700; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.2;">${juego.nombre}</span>
            </div>
        `;
    });

    if (encontrados === 0) {
        html = `<div style="grid-column: 1/-1; text-align: center; padding: 30px; color: #999; font-family: 'Outfit', sans-serif;">No hemos encontrado ningún juego que coincida.</div>`;
    }

    list.innerHTML = html;
};

