                colorIcono: '#f59e0b',
                idJuego: window.ComunidadApp.idJuegoActual || tema.idJuego || '',
                idTema: tema.id
            });
        });

        if (inputTxt) inputTxt.value = '';
        this.quitarFotoComentario();

        await this.guardarTemasActuales();
        this.renderizarInteriorHilo(tema);

        const scrollBox = document.getElementById('contenedorScrollHilo');
