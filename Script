            // Si quien da like no es el propio autor del comentario, notificamos al creador del comentario
            if (!soyAutorCom) {
                window.enviarNotificacionAUsuarioDestino(comentario.autorUid, comentario.autorNombre, {
                    id: 'notif_like_com_' + comentario.id + '_' + (usuario.uid || usuario.nombre),
