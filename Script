    const contenedor10 = todosContenedores.find(function(el) {
        if (el.closest('.resena-glass-topbar') || el.closest('.resena-glass-game-row')) return false;
        return el.children.length === 10;
    });

    if (contenedor10) {
        contenedor10.classList.add('contenedor-estrellas-resena-glass');
        estrellas = Array.from(contenedor10.children);
    } else if (ta && ta.previousElementSibling && ta.previousElementSibling.children.length >= 5) {
        ta.previousElementSibling.classList.add('contenedor-estrellas-resena-glass');
        estrellas = Array.from(ta.previousElementSibling.children);
    } else {
        estrellas = Array.from(cajaModal.querySelectorAll('span, i, button, div, svg')).filter(function(el) {
            if (el.closest('.resena-glass-topbar') || el.closest('.resena-glass-game-row')) return false;
