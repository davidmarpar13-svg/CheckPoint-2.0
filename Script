            j.lanzamiento, j.fecha_lanzamiento, j.fecha, j.release_date, j.releaseDate, j.human_date
        ].map(x => String(x || '').toLowerCase().trim()).join(' ');

        if (/\b(pr[oó]ximamente|proximamente|tbd|tba|to be announced|to be determined|por determinar|por anunciar|coming soon|en desarrollo)\b/i.test(camposFecha)) {
            return true;
        }

        const ts = this.obtenerTimestampLanzamiento(j);
        const hoyFinDelDia = new Date();
        hoyFinDelDia.setHours(23, 59, 59, 999);

        if (ts && ts > hoyFinDelDia.getTime()) {
            return true;
        }

        const anioActual = new Date().getFullYear();
        if (anioDetectado > anioActual) return true;
        if (anioDetectado === 0 && (!camposFecha || camposFecha === 'desconocido' || camposFecha === 'sin fecha')) {
            return true;
        }
        return false;
    },

    tieneAfinidadConJuegoOrigen: function(juegoCandidato, devOrigen, generosOrigen, tituloOrigen, nombreSaga, descOrigen) {
        if (!window.esJuegoValidoParaAppGlobal(juegoCandidato)) return false;

        const sagaNorm = this.normalizarSinTildes(nombreSaga);
        const devCandNorm = this.normalizarSinTildes(
            juegoCandidato.desarrollador || juegoCandidato.developer || juegoCandidato.developers || ''
        );
        const descCandNorm = this.normalizarSinTildes(this.obtenerTextoDescripcionCompleto(juegoCandidato));
        const nombreCandNorm = this.normalizarSinTildes(juegoCandidato.nombre || juegoCandidato.name || '');

        if (sagaNorm === 'pokemon') {
            if (!nombreCandNorm.startsWith('pokemon')) return false;
            const esGameFreakOILCA = /\b(game\s*freak|ilca)\b/i.test(devCandNorm) || /\b(game\s*freak|ilca)\b/i.test(descCandNorm);
            const genCandNorm = this.normalizarSinTildes(
                juegoCandidato.genero || juegoCandidato.generos ||
                (Array.isArray(juegoCandidato.genres) ? juegoCandidato.genres.map(g => g.name || g).join(', ') : '') || ''
            );
            const esRPG = genCandNorm.includes('role-playing') || genCandNorm.includes('rpg') || genCandNorm.includes('adventure') || descCandNorm.includes('videojuegos de rol') || descCandNorm.includes('juego de rol');
            const tieneLorePrincipalPokemon = /\b(pokedex|gimnasio|gym\s+leader|liga\s+pokemon|pokemon\s+league|starter\s+pokemon|pokemon\s+inicial|kanto|johto|hoenn|sinnoh|hisui|unova|teselia|kalos|alola|galar|paldea|lumiose|luminalia|the\s+pokemon\s+company)\b/i.test(descCandNorm);
            return Boolean(esGameFreakOILCA || (esRPG && tieneLorePrincipalPokemon));
        }

        const devOrigNorm = this.normalizarSinTildes(devOrigen);
        const palabrasDevOrigen = devOrigNorm
            .replace(/\b(studios|studio|entertainment|interactive|games|game|software|co|ltd|inc|sl|s\.l\.|sa|corp|corporation|digital|works|team|group|publishing|desconocido|unknown|no especificado)\b/g, '')
            .trim()
            .split(/\s+/)
            .filter(w => w.length >= 3);

        const tituloOrigNorm = this.normalizarSinTildes(tituloOrigen);

        const coincideDesarrollador = palabrasDevOrigen.length > 0 && palabrasDevOrigen.some(palabra =>
            devCandNorm.includes(palabra) || descCandNorm.includes(palabra)
        );
        if (coincideDesarrollador) return true;

        if (tituloOrigNorm && tituloOrigNorm.length >= 8 && descCandNorm.includes(tituloOrigNorm)) {
            return true;
        }
        if (sagaNorm && new RegExp(`\\b(secuela|precuela|sequel|prequel|entrega|serie|saga|franquicia|franchise)\\b.*\\b${sagaNorm}\\b`, 'i').test(descCandNorm)) {
            return true;
        }

        const sagaEscapada = sagaNorm.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const tieneEstructuraFranquicia = new RegExp(
            `(^${sagaEscapada}(\\s+([0-9]+|[ivxlcdm]+))?(\\s*[:\\-]\\s*.+)?$)|` +
            `(^(the secret of|the curse of|escape from|tales of|return to|rise of the|shadow of the|dawn of the|war for the|call of|the legend of|legend of|legacy of|world of|the rogue|super|new|dmc)\\s*:?\\s*${sagaEscapada})`,
            'i'
        ).test(nombreCandNorm);

        if (tieneEstructuraFranquicia) {
            const genCandNorm = this.normalizarSinTildes(
                juegoCandidato.genero || juegoCandidato.generos ||
                (Array.isArray(juegoCandidato.genres) ? juegoCandidato.genres.map(g => g.name || g).join(', ') : '') || ''
            );
            const comparteGenero = !Array.isArray(generosOrigen) || generosOrigen.length === 0 ||
                generosOrigen.some(g => g.length >= 4 && genCandNorm.includes(g));

            if (comparteGenero) return true;
        }

        if (descOrigen && descCandNorm) {
            const stopwords = new Set(['para', 'como', 'este', 'esta', 'estos', 'entre', 'desde', 'hasta', 'donde', 'cuando', 'todo', 'todos', 'juego', 'juegos', 'historia', 'mundo', 'vida', 'anos', 'gran', 'nuevo', 'nueva', 'contra', 'tras', 'durante', 'tiene', 'solo', 'aventura', 'primera', 'segunda', 'tercera', 'parte']);
            const palabrasLoreOrigen = this.normalizarSinTildes(descOrigen)
                .split(/[^a-z0-9]+/)
                .filter(w => w.length >= 6 && !stopwords.has(w));
            const coincidenciasLore = palabrasLoreOrigen.filter(w => descCandNorm.includes(w));
            if (coincidenciasLore.length >= 2) return true;
        }

        return false;
    },

    // Detector preciso de códigos de descarga, armas equipables y DLCs (sin falsos positivos por decir "juego original")
