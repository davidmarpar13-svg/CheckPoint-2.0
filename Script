window.mostrarToastAvisoEstreno = function(tituloCabecera, subtextoIronico) {
    let toast = document.getElementById('toastAvisoEstreno');
    if (!toast) {
        toast = document.createElement('div');
        toast.id = 'toastAvisoEstreno';
        toast.onclick = function() { toast.classList.remove('visible'); };
        document.body.appendChild(toast);
    }

    toast.innerHTML = '<span class="material-symbols-rounded" style="color: #fbbf24; font-size: 26px; flex-shrink: 0; margin-top: 2px;">notifications_active</span>' +
        '<div style="flex: 1;">' +
