        window.switchPanel = (panelId) => {
    // 1. Ocultar todos los paneles principales
    const paneles = ['initialPanel', 'loginPanel', 'registerPanel', 'dashboardPanel', 'profilePanel', 'searchPanel', 'explorePanel', 'notificationsPanel'];
    paneles.forEach(id => {
        const panel = document.getElementById(id);
        if (panel) {
            panel.classList.add('hidden');
        }
    });

    // 2. Mostrar el panel solicitado
    const panelActivo = document.getElementById(panelId);
    if (panelActivo) {
        panelActivo.classList.remove('hidden');
    }

    // 3. Controlar los fondos de pantalla
    const background = document.getElementById('authBackground');
    const overlay = document.getElementById('authOverlay');
    const heroText = document.getElementById('heroText');
    const topLogo = document.getElementById('topLogo');

    if (panelId === 'dashboardPanel' || panelId === 'profilePanel' || panelId === 'searchPanel' || panelId === 'explorePanel' || panelId === 'notificationsPanel') {
        if(background) background.style.opacity = '0';
        if(overlay) overlay.style.opacity = '0';
        if(heroText) heroText.style.display = 'none';
        if(topLogo) topLogo.style.display = 'none';
    } else {
        if(background) background.style.opacity = '1';
        if(overlay) overlay.style.opacity = '1';
        if(heroText) heroText.style.display = 'flex';
        if(topLogo) topLogo.style.display = 'block';
    }

    // 4. ACTUALIZAR ESTADO DE LOS BOTONES DE NAVEGACIÓN INFERIOR
    const navButtons = document.querySelectorAll('#globalBottomNav .nav-item');
    navButtons.forEach(btn => btn.classList.remove('active'));
    
    navButtons.forEach(btn => {
        const onclickAttr = btn.getAttribute('onclick');
        if (onclickAttr && onclickAttr.includes(panelId)) {
            btn.classList.add('active');
        }
    });
};

