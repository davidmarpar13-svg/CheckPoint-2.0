document.addEventListener("DOMContentLoaded", function() {
    if (typeof firebase !== 'undefined' && firebase.auth) {
        firebase.auth().onAuthStateChanged(function(user) {
            const appWrapper = document.querySelector('.app-wrapper');
            const authBg = document.getElementById('authBackground');
            const authOverlay = document.getElementById('authOverlay');
            const dashboard = document.getElementById('dashboardPanel');
            const profile = document.getElementById('profilePanel');
            const navbar = document.querySelector('nav') || document.querySelector('.bottom-nav');

            if (user) {
                // Hay sesión: Ocultamos login, mostramos app
                if(appWrapper) appWrapper.style.display = 'none';
                if(authBg) authBg.style.display = 'none';
                if(authOverlay) authOverlay.style.display = 'none';
                if(navbar) navbar.style.display = '';
                if(dashboard) { dashboard.classList.remove('hidden'); dashboard.style.display = ''; }
                if(profile) { profile.classList.add('hidden'); }
            } else {
                // No hay sesión: Mostramos el inicio y ocultamos la app
                if(appWrapper) appWrapper.style.display = '';
                if(authBg) authBg.style.display = '';
                if(authOverlay) authOverlay.style.display = '';
                if(navbar) navbar.style.display = 'none';
                if(dashboard) dashboard.classList.add('hidden');
                if(profile) profile.classList.add('hidden');

                const initial = document.getElementById('initialPanel');
                const login = document.getElementById('loginPanel');
                const register = document.getElementById('registerPanel');
                if(initial) initial.classList.remove('hidden');
                if(login) login.classList.add('hidden');
                if(register) register.classList.add('hidden');
            }
        });
    }
});

