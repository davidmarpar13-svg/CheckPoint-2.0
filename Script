window.obtenerTodosLosTemasConNombreDeJuego = function(modoFiltro) {
    const usuario = window.ComunidadApp ? window.ComunidadApp.obtenerUsuarioActivo() : { uid: 'anon', nombre: 'David' };
    const miUid = String(usuario.uid || '').trim();
    const miNombre = String(usuario.nombre || 'David').trim().toLowerCase();
    const mapa = new Map();

    const resolverNombreJuego = function(t) {
        if (t && t.juegoTitulo && t.juegoTitulo.trim()) return t.juegoTitulo.trim();
        const idJ = String((t && t.idJuego) || '').trim();
        if (!idJ) return '';
        const jObj = (window.juegosCargados && window.juegosCargados[idJ]) ||
                     (window.miColeccionActiva && window.miColeccionActiva[idJ]) ||
                     (window.misAvisosEstreno && window.misAvisosEstreno[idJ]) ||
                     (window.SagaApp && window.SagaApp.registroJuegosIGDB && window.SagaApp.registroJuegosIGDB[idJ]) || {};
        return jObj.nombre || jObj.name || jObj.title || jObj.titulo || '';
    };

    try {
        for (let i = 0; i < localStorage.length; i++) {
            const key = localStorage.key(i);
            if (key && key.indexOf('checkpoint_comunidad_temas_') === 0) {
                const idJuegoKey = key.replace('checkpoint_comunidad_temas_', '');
                const arr = JSON.parse(localStorage.getItem(key) || '[]') || [];
                arr.forEach(function(t) {
                    if (!t || !t.id) return;
                    if (!t.idJuego) t.idJuego = idJuegoKey;
                    t.juegoTitulo = resolverNombreJuego(t) || t.juegoTitulo || '';

                    const esMio = (miUid && miUid !== 'anon' && String(t.autorUid || '') === miUid) ||
                                  (miNombre && String(t.autorNombre || '').trim().toLowerCase() === miNombre);

                    if (modoFiltro === 'seguidos') {
                        const segs = Array.isArray(t.seguidores) ? t.seguidores : [];
                        const sigue = !esMio && ((miUid && segs.indexOf(miUid) !== -1) ||
                                      (miNombre && segs.indexOf(miNombre) !== -1));
                        if (sigue) mapa.set(t.id, t);
                    } else if (modoFiltro === 'mios') {
                        if (esMio) mapa.set(t.id, t);
                    } else {
                        mapa.set(t.id, t);
                    }
                });
            }
        }
    } catch (e) {}

    const lista = Array.from(mapa.values());
    lista.sort(function(a, b) { return (b.fecha || 0) - (a.fecha || 0); });
    return lista;
};

