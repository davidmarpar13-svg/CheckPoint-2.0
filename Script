window.abrirCalendarioProximos = function() {
    try {
        const modal = document.getElementById('modalVerTodoProximos');
        if (!modal) return;
        
        document.body.appendChild(modal);
        modal.style.transition = 'none';
        modal.style.display = 'block';
        modal.style.visibility = 'visible';
        modal.style.transform = 'translateY(100%)';
        
        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                modal.style.transition = 'transform 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
                modal.style.transform = 'translateY(0)';
            });
        });
        
        // Ejecutamos el filtro nuevo en modo "todos" al abrir
        window.filtrarCalendarioAvanzado('todos');
    } catch (error) {
        console.error("Error al abrir el calendario:", error);
    }
};

window.cerrarCalendarioProximos = function() {
    const modal = document.getElementById('modalVerTodoProximos');
    if (!modal) return;
    
    modal.style.transform = 'translateY(100%)';
    setTimeout(() => {
        modal.style.visibility = 'hidden';
    }, 300);
