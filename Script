// Al cambiar de plataforma en "PARA TI", desmarca "Todos" y genera un nuevo "Para Ti" específico para esa plataforma
window.filtrarParaTiPorPlataforma = function(plataforma, btnEl) {
    if (window.plataformaActivaParaTi === plataforma && document.getElementById('exploreForYouGrid')?.children.length > 1) return;
    window.plataformaActivaParaTi = plataforma;

    const barra = document.getElementById('barraPlatParaTi');
    if (barra) {
        barra.querySelectorAll('.btn-plat-explorar, .platform-btn').forEach(b => b.classList.remove('active', 'activo'));
