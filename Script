window.obtenerTemaAbiertoActualmente = function() {
    const app = window.ComunidadApp;
    const idT = String(window._idTemaAbiertoActual || (app && (app.idTemaActual || (app.temaActual && app.temaActual.id))) || '').trim();
    const idJ = String(window._idJuegoTemaActual || (app && app.idJuegoActual) || '').trim();

    if (app && app.temaActual && (!idT || String(app.temaActual.id) === idT)) return app.temaActual;
    if (app && Array.isArray(app.temasActuales)) {
        const enc = app.temasActuales.find(function(t) { return t && String(t.id) === idT; });
        if (enc) return enc;
    }
    try {
        for (let i = 0; i < localStorage.length; i++) {
            const k = localStorage.key(i);
            if (k && k.indexOf('checkpoint_comunidad_temas_') === 0) {
                const idJuegoKey = k.replace('checkpoint_comunidad_temas_', '');
                const arr = JSON.parse(localStorage.getItem(k) || '[]') || [];
                const enc = arr.find(function(t) { return t && String(t.id) === idT; });
                if (enc) { if (!enc.idJuego) enc.idJuego = idJuegoKey; return enc; }
            }
        }
    } catch (e) {}

    // Fallback leyendo el título y autor reales desde el DOM del hilo abierto
    const overlayDet = document.getElementById('vistaDetalleTemaOverlay') || document.getElementById('comunidadJuegoOverlay');
    let tituloDom = '';
    let autorDom = '';
    if (overlayDet) {
        const topTitle = overlayDet.querySelector('.comunidad-top-bar div');
        if (topTitle && topTitle.textContent) tituloDom = topTitle.textContent.trim();
        const cardP = overlayDet.querySelector('.tema-card-titulo');
        if (cardP && cardP.textContent) tituloDom = cardP.textContent.trim();
    }
    return { id: idT, idJuego: idJ, titulo: tituloDom || 'Hilo', autorNombre: autorDom, descripcion: '' };
};

// Sigue/deja de seguir un tema de otro usuario y, al seguirlo, lleva a Perfil -> Temas -> Temas seguidos
window.toggleSeguirTemaActualDirecto = function(e) {
    if (e) e.stopPropagation();
    document.querySelectorAll('.dropdown-opciones-tema.abierto').forEach(function(m) { m.classList.remove('abierto'); });

    const tema = window.obtenerTemaAbiertoActualmente();
    if (!tema || !tema.id) return;

    // Si el tema es tuyo, no se puede seguir
    if (window.esTemaDelUsuarioActivo(tema)) return;

    const usuario = window.ComunidadApp ? window.ComunidadApp.obtenerUsuarioActivo() : { uid: 'anon', nombre: 'David' };
    const idJ = String(tema.idJuego || window._idJuegoTemaActual || (window.ComunidadApp && window.ComunidadApp.idJuegoActual) || '').trim();
    const storageKey = 'checkpoint_comunidad_temas_' + idJ;

    let siguiendoAhora = false;
    try {
        const arr = JSON.parse(localStorage.getItem(storageKey) || '[]') || [];
        const idx = arr.findIndex(function(t) { return t && String(t.id) === String(tema.id); });
        if (idx !== -1) {
            arr[idx].seguidores = Array.isArray(arr[idx].seguidores) ? arr[idx].seguidores : [];
            const pos = arr[idx].seguidores.indexOf(usuario.uid);
            if (pos === -1) {
                arr[idx].seguidores.push(usuario.uid);
                siguiendoAhora = true;
            } else {
                arr[idx].seguidores.splice(pos, 1);
                siguiendoAhora = false;
            }
            tema.seguidores = arr[idx].seguidores;
            localStorage.setItem(storageKey, JSON.stringify(arr));
            if (window.ComunidadApp && Array.isArray(window.ComunidadApp.temasActuales)) {
                const tMem = window.ComunidadApp.temasActuales.find(function(x) { return x && String(x.id) === String(tema.id); });
                if (tMem) tMem.seguidores = arr[idx].seguidores;
            }
        }
    } catch (err) {}

    window.asegurarBotonSeguirTemaVisibleEnHilo(true);

    if (typeof window.mostrarToastAvisoEstreno === 'function') {
        window.mostrarToastAvisoEstreno(
            siguiendoAhora ? '🔔 Siguiendo tema' : 'Has dejado de seguir el tema',
            siguiendoAhora ? 'Se ha añadido a tu pestaña de "Temas seguidos".' : 'Se ha quitado de "Temas seguidos".'
        );
    }

    // Si acaba de seguir el tema, lo llevamos directamente a Perfil -> TEMAS -> Temas seguidos
    if (siguiendoAhora) {
        setTimeout(function() {
            window._temaAbiertoDirectoDesdePerfil = false;
            document.body.classList.remove('abriendo-tema-desde-perfil');
            const overlayDet = document.getElementById('vistaDetalleTemaOverlay');
            if (overlayDet) overlayDet.style.display = 'none';
            const overlayCom = document.getElementById('comunidadJuegoOverlay');
            if (overlayCom) overlayCom.style.display = 'none';

            if (typeof window.switchPanel === 'function') window.switchPanel('profilePanel');
            const profilePanel = document.getElementById('profilePanel');
            if (profilePanel) {
                const tabBtnTemas = Array.from(profilePanel.querySelectorAll('div, span, button')).find(function(el) {
                    return el.children.length === 0 && (el.textContent || '').trim().toUpperCase() === 'TEMAS';
                });
                if (tabBtnTemas) (tabBtnTemas.closest('button, [onclick]') || tabBtnTemas.parentElement || tabBtnTemas).click();
            }
            window.cambiarSubTabTemasPerfil('seguidos');
        }, 180);
    }
};

// Muestra el botón "Seguir tema / Siguiendo" en la tarjeta del tema SOLO si el tema NO es tuyo
window.asegurarBotonSeguirTemaVisibleEnHilo = function(forzar) {
    const overlayDet = document.getElementById('vistaDetalleTemaOverlay');
    if (!overlayDet || overlayDet.style.display === 'none') return;

    const btnLikePrincipal = Array.from(overlayDet.querySelectorAll('button, span')).find(function(el) {
        return /Me\s+gusta/i.test((el.textContent || '').trim());
    });
    if (!btnLikePrincipal || !btnLikePrincipal.parentElement) return;

    const filaAutor = btnLikePrincipal.parentElement;
    const tema = window.obtenerTemaAbiertoActualmente();
    const esMio = window.esTemaDelUsuarioActivo(tema);

    let btnSeguir = filaAutor.querySelector('.btn-seguir-tema-inline');

    // Si el tema es tuyo, jamás debe salir el botón "Seguir tema"
    if (esMio) {
        if (btnSeguir) btnSeguir.remove();
        return;
    }

    const usuario = window.ComunidadApp ? window.ComunidadApp.obtenerUsuarioActivo() : { uid: 'anon', nombre: 'David' };
    const segs = (tema && Array.isArray(tema.seguidores)) ? tema.seguidores : [];
    const siguiendo = Boolean((usuario.uid && segs.indexOf(usuario.uid) !== -1) || (usuario.nombre && segs.indexOf(usuario.nombre.toLowerCase()) !== -1));

    if (!btnSeguir) {
        btnSeguir = document.createElement('button');
        btnSeguir.type = 'button';
        btnSeguir.className = 'btn-seguir-tema-inline';
        btnSeguir.onclick = function(ev) { window.toggleSeguirTemaActualDirecto(ev); };
        filaAutor.insertBefore(btnSeguir, btnLikePrincipal);
    }

    const firma = (tema ? tema.id : '') + '_' + (siguiendo ? '1' : '0');
    if (forzar || btnSeguir.dataset.firmaSeguir !== firma) {
        btnSeguir.dataset.firmaSeguir = firma;
        btnSeguir.classList.toggle('siguiendo', siguiendo);
        btnSeguir.innerHTML =
            '<span class="material-symbols-rounded" style="font-size: 16px;">' + (siguiendo ? 'notifications_active' : 'notifications_none') + '</span>' +
            '<span>' + (siguiendo ? 'Siguiendo' : 'Seguir tema') + '</span>';
    }
};

