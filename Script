// Añadir el juego a la lista seleccionada
window.anadirJuegoAListaExistente = async function(idLista) {
    const idJuego = window.idJuegoEnFichaActual ? String(window.idJuegoEnFichaActual) : null;
    if (!idJuego) {
        alert("No se pudo detectar el ID del juego actual.");
        return;
    }

    const usuarioActual = (typeof auth !== 'undefined' && auth.currentUser) ? auth.currentUser : null;
    if (!usuarioActual || typeof db === 'undefined') return;

    const infoLista = window.misListasCache ? window.misListasCache[idLista] : null;
    if (!infoLista) return;

    const juegosActuales = (infoLista.juegos || []).map(String);
    if (juegosActuales.includes(idJuego)) return;

    juegosActuales.push(idJuego);

    try {
        const listaRef = doc(db, 'users', usuarioActual.uid, 'listas', idLista);
        await setDoc(listaRef, { juegos: juegosActuales }, { merge: true });

        window.misListasCache[idLista].juegos = juegosActuales;
        window.abrirListasJuego(idJuego);

        if (typeof window.cargarListasDelPerfil === 'function') {
            window.cargarListasDelPerfil();
        }
    } catch (error) {
        console.error("❌ Error al añadir el juego a la lista:", error);
    }
};

