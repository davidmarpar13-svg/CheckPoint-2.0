window._buscandoListasLock = false;

window.ejecutarBusquedaListasGlobal = async function(textoFiltro) {
    if (window._buscandoListasLock) return;
    window._buscandoListasLock = true;

    try {
        const filtro = (textoFiltro || '').toLowerCase().trim();
        const searchPanel = document.getElementById('searchPanel') || document;

        let contenedorResultados = searchPanel.querySelector('#listasResultadosBusquedaContainer');
        if (!contenedorResultados) {
            const buscadorEl = searchPanel.querySelector('input[type="text"], input[type="search"]');
            if (buscadorEl && buscadorEl.parentElement) {
                contenedorResultados = document.createElement('div');
                contenedorResultados.id = 'listasResultadosBusquedaContainer';
                contenedorResultados.style.cssText = 'display: flex; flex-direction: column; gap: 16px; margin-top: 15px; width: 100%; box-sizing: border-box;';
                buscadorEl.parentElement.insertAdjacentElement('afterend', contenedorResultados);
            }
        }

        if (!contenedorResultados) {
            window._buscandoListasLock = false;
            return;
        }

        if (!filtro) {
            contenedorResultados.innerHTML = '';
            const msgVacio = searchPanel.querySelector('#msgBusquedaListasVacio');
            if (msgVacio) msgVacio.style.display = 'none';
            window._buscandoListasLock = false;
            return;
        }

        contenedorResultados.innerHTML = '<p style="color: #888; font-family: \'Outfit\', sans-serif; font-size: 0.85rem; text-align: center; padding: 20px;">Buscando listas...</p>';

        await window.asegurarListasCargadasYLimpia();

        const mapaUnicas = new Map();
        if (window.misListasCache) {
            Object.entries(window.misListasCache).forEach(([keyId, l]) => {
                if (l && typeof l === 'object') {
                    const idLista = String(l.id || keyId);
                    l.id = idLista;
                    mapaUnicas.set(idLista, l);
                }
            });
        }

        const coleccionGlobal = Object.assign({}, window.juegosExtraListasCache || {}, window.miColeccionActiva || {});
        const listaTotalListas = Array.from(mapaUnicas.values());

        const resultadosFiltrados = listaTotalListas.filter(infoLista => {
            if (!infoLista || typeof infoLista !== 'object') return false;

            const titulo = String(infoLista.titulo || '').toLowerCase();
            const desc = String(infoLista.descripcion || '').toLowerCase();

            let coincideTexto = titulo.includes(filtro) || desc.includes(filtro);
            let coincideJuego = false;

            if (Array.isArray(infoLista.juegos)) {
                coincideJuego = infoLista.juegos.some(idJuego => {
                    const datosJuego = coleccionGlobal[String(idJuego)] || (infoLista.juegosInfo && infoLista.juegosInfo[String(idJuego)]);
                    if (datosJuego && datosJuego.nombre) {
                        return String(datosJuego.nombre).toLowerCase().includes(filtro);
                    }
                    return false;
                });
            }

            return coincideTexto || coincideJuego;
        });

        const divsMensaje = Array.from(searchPanel.querySelectorAll('div, p, span')).filter(el =>
            (el.textContent || '').includes('Búsqueda no disponible')
        );
        divsMensaje.forEach(msg => { msg.style.display = 'none'; });

        if (resultadosFiltrados.length === 0) {
            contenedorResultados.innerHTML = '<p id="msgBusquedaListasVacio" style="color: #888; font-family: \'Outfit\', sans-serif; font-size: 0.85rem; text-align: center; padding: 20px;">No se encontraron listas con ese nombre o juego.</p>';
            window._buscandoListasLock = false;
            return;
        }

        let htmlResultados = '';
        const idsPintados = new Set();

        resultadosFiltrados.forEach(infoLista => {
            const idLista = String(infoLista.id);
            if (idsPintados.has(idLista)) return;
            idsPintados.add(idLista);

            const titulo = String(infoLista.titulo || 'Sin título');
            const descripcion = String(infoLista.descripcion || '');
            const banner = String(infoLista.banner || 'linear-gradient(135deg, #2b5876 0%, #4e4376 100%)');
            const juegosIds = Array.isArray(infoLista.juegos) ? infoLista.juegos : [];

            let caratulasHTML = '';
            juegosIds.slice(0, 6).forEach(idJuego => {
                const jInfo = coleccionGlobal[String(idJuego)] || (infoLista.juegosInfo && infoLista.juegosInfo[String(idJuego)]);
                if (jInfo && jInfo.caratula) {
                    caratulasHTML += `<img src="https://images.igdb.com/igdb/image/upload/t_cover_small/${jInfo.caratula}.jpg" style="width: 38px; height: 50px; object-fit: cover; border-radius: 6px; box-shadow: 0 2px 5px rgba(0,0,0,0.2);">`;
                }
            });

            htmlResultados += `
                <div onclick="if(typeof window.abrirDetalleLista==='function') window.abrirDetalleLista('${idLista}')" style="width: 100%; border-radius: 16px; overflow: hidden; background: #ffffff; box-shadow: 0 4px 15px rgba(0,0,0,0.06); cursor: pointer; border: 1px solid rgba(0,0,0,0.04);">
                    <div style="position: relative; width: 100%; height: 95px; background: ${banner}; background-size: cover; background-position: center;">
                        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.35); backdrop-filter: blur(1px);"></div>
                        <div style="position: relative; z-index: 1; padding: 14px; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; box-sizing: border-box;">
                            <h3 style="color: #ffffff; font-family: 'Cinzel', serif; margin: 0; font-size: 1.05rem; font-weight: 700; text-shadow: 0 2px 4px rgba(0,0,0,0.4);">${titulo}</h3>
                            ${descripcion ? `<p style="color: #eeeeee; font-family: 'Outfit', sans-serif; margin: 2px 0 0 0; font-size: 0.78rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${descripcion}</p>` : ''}
                        </div>
                    </div>
                    <div style="padding: 10px 14px; display: flex; align-items: center; justify-content: space-between; background: #fafafa; border-top: 1px solid #f0f0f0;">
                        <div style="display: flex; align-items: center; gap: 6px; font-family: 'Outfit', sans-serif; font-size: 0.8rem; color: #555; font-weight: 600;">
                            <span class="material-symbols-rounded" style="font-size: 16px; color: #e67e22;">sports_esports</span>
                            ${juegosIds.length} juegos
                        </div>
                        <div style="display: flex; gap: 6px; overflow: hidden;">
                            ${caratulasHTML || '<span style="color: #999; font-size: 0.75rem; font-style: italic; font-family: \'Outfit\',sans-serif;">Sin carátulas</span>'}
                        </div>
                    </div>
                </div>
            `;
        });

        contenedorResultados.innerHTML = htmlResultados;
    } catch (err) {
        console.error("Error en búsqueda de listas:", err);
    } finally {
        window._buscandoListasLock = false;
    }
};

