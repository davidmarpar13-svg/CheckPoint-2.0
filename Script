window.obtenerPortadaJuegoPorIdOTitulo = function(idJuego, textoNombreOMensaje) {
    const idStr = String(idJuego || '').trim();
    const extraerCoverDeObjeto = function(obj) {
        if (!obj) return '';
        if (window.SagaApp && typeof window.SagaApp.resolverUrlCaratula === 'function') {
            const c = window.SagaApp.resolverUrlCaratula(obj);
            if (c && c.indexOf('placeholder') === -1) return c;
        }
        return obj.cover || obj.caratula || obj.imagen || (obj.cover && obj.cover.url) || '';
    };
    if (idStr) {
        const jDirecto = (window.miColeccionActiva && window.miColeccionActiva[idStr]) ||
                         (window.juegosCargados && window.juegosCargados[idStr]) ||
                         (window.misAvisosEstreno && window.misAvisosEstreno[idStr]);
        const cov = extraerCoverDeObjeto(jDirecto);
        if (cov) return cov;
    }
    const covCom = document.getElementById('comunidadGameCover');
    if (covCom && covCom.src && covCom.src.indexOf('http') === 0 && (!idStr || (window.ComunidadApp && String(window.ComunidadApp.idJuegoActual) === idStr))) {
        return covCom.src;
    }
    const txtBusq = String(textoNombreOMensaje || '').toLowerCase().trim();
    if (txtBusq) {
        const buscarPorNombre = function(mapa) {
            if (!mapa || typeof mapa !== 'object') return '';
            for (const k of Object.keys(mapa)) {
                const item = mapa[k];
                if (!item) continue;
                const nom = String(item.nombre || item.name || item.title || item.titulo || '').toLowerCase().trim();
                if (nom && nom.length > 2 && txtBusq.indexOf(nom) !== -1) {
                    const c = extraerCoverDeObjeto(item);
                    if (c) return c;
                }
            }
            return '';
        };
        const hallada = buscarPorNombre(window.miColeccionActiva) || buscarPorNombre(window.juegosCargados) || buscarPorNombre(window._mapaMisResenasGuardadas);
        if (hallada) return hallada;
    }
    const gdCov = document.getElementById('gdCover');
    if (gdCov && gdCov.src && gdCov.src.indexOf('http') === 0) return gdCov.src;
    return '';
};

// Abre el destino exacto cuando el usuario hace clic en cualquier tarjeta de Notificación:
// - Si es Lista -> va al perfil, pestaña LISTAS y abre la lista correspondiente
// - Si es Reseña -> abre directamente la pantalla de Mi Reseña
// - Si es Tema o Comentario de Tema -> abre directamente el hilo del tema
window.abrirDestinoDesdeNotificacion = function(notifObj, textoTarjetaFallback) {
    const n = notifObj || {};
    const txt = (n.titulo || '') + ' ' + (n.mensaje || '') + ' ' + (textoTarjetaFallback || '');
    const tipo = String(n.tipo || '').toLowerCase();

    // 1. NOTIFICACIÓN DE LISTA -> Abre el modal de la lista DIRECTAMENTE sin cambiar al panel de Perfil
    if (tipo.indexOf('lista') !== -1 || /en tu lista|gustado tu lista/i.test(txt)) {
        const matchNombreLista = txt.match(/["“”]([^"“”]+)["“”]/);
        const nombreLista = (n.tituloLista || (matchNombreLista && matchNombreLista[1]) || '').trim();
        const idListaDirecto = String(n.idLista || '').trim();

        const tabListas = document.getElementById('tab-listas');
        if (tabListas) {
            const tarjetasLista = Array.from(tabListas.querySelectorAll('[onclick*="Lista"], [onclick*="lista"], .lista-card, div[style*="border-radius"]')).filter(function(el) {
                return el.id !== 'subNavListasPerfilWrap' && (el.getAttribute('onclick') || el.querySelector('[onclick]') || el.querySelector('img'));
            });
            const cardTarget = tarjetasLista.find(function(c) {
                const oc = (c.getAttribute('onclick') || '');
                if (idListaDirecto && oc.indexOf(idListaDirecto) !== -1) return true;
                return nombreLista && (c.textContent || '').toLowerCase().indexOf(nombreLista.toLowerCase()) !== -1;
            }) || tarjetasLista[0];

            if (cardTarget) {
                const clickable = cardTarget.getAttribute('onclick') ? cardTarget : (cardTarget.querySelector('[onclick]') || cardTarget);
                clickable.click();
                return;
            }
        }

        const fnAbrirLista = window.abrirDetalleLista || window.verDetalleLista || window.openListDetail;
        if (typeof fnAbrirLista === 'function' && idListaDirecto) {
            fnAbrirLista(idListaDirecto);
        }
        return;
    }

    // 2. NOTIFICACIÓN DE RESEÑA -> Abre directamente la reseña
    if (tipo.indexOf('resena') !== -1 || /en tu reseña|gustado tu reseña/i.test(txt)) {
        window.sincronizarMapaMisResenasDesdeDOM();
        const idJ = String(n.idJuego || '').trim();
        let datosRes = (idJ && window._mapaMisResenasGuardadas['id_' + idJ]) || null;

        if (!datosRes) {
            const claves = Object.keys(window._mapaMisResenasGuardadas || {});
            for (let i = 0; i < claves.length; i++) {
                const cand = window._mapaMisResenasGuardadas[claves[i]];
                if (cand && cand.titulo && txt.toLowerCase().indexOf(cand.titulo.toLowerCase()) !== -1) {
                    datosRes = cand;
                    break;
                }
            }
            if (!datosRes && claves.length > 0) datosRes = window._mapaMisResenasGuardadas[claves[0]];
        }

        if (datosRes) window.abrirPaginaMiResenaPropia(datosRes);
        return;
    }

    // 3. NOTIFICACIÓN DE TEMA O COMENTARIO -> Abre directamente el hilo con abrirTemaDesdePerfil
    let idJuegoDest = String(n.idJuego || '').trim();
    let idTemaDest = String(n.idTema || '').trim();
    const matchTituloComillas = txt.match(/["“”]([^"“”]+)["“”]/);
    const tituloTemaBusq = matchTituloComillas ? matchTituloComillas[1].trim().toLowerCase() : '';

    const todosTemas = window.obtenerTodosLosTemasConNombreDeJuego('todos');
    if (todosTemas.length > 0) {
        const encontrado = todosTemas.find(function(t) {
            if (idTemaDest && String(t.id) === idTemaDest) return true;
            if (tituloTemaBusq && String(t.titulo || '').trim().toLowerCase() === tituloTemaBusq) return true;
            return false;
        }) || todosTemas[0];

        if (encontrado) {
            idJuegoDest = String(encontrado.idJuego || idJuegoDest);
            idTemaDest = String(encontrado.id || idTemaDest);
        }
    }

    if (idJuegoDest || idTemaDest) {
        window.abrirTemaDesdePerfil(idJuegoDest, idTemaDest);
    }
};

// Limpiamos notificaciones rotas con título genérico "Tema" y vinculamos el clic de todas las tarjetas de notificación
window.reemplazarCorazonPorPortadaEnNotificacionesDOM = function() {
    Array.from(document.querySelectorAll('.notif-icon-list-badge')).forEach(function(badge) {
        const parent = badge.parentElement;
        if (parent && parent.children.length === 1 && !/Me gusta|lista|tema|reseña/i.test(parent.textContent || '')) {
            badge.remove();
        }
    });

    let listaGuardada = [];
    try {
        listaGuardada = JSON.parse(localStorage.getItem('checkpoint_notificaciones_app_v1') || '[]') || [];
        // Si había una notificación duplicada con 'Tu tema "Tema"' cuando existe la real, la corregimos
        const filtrada = listaGuardada.filter(function(n, idx, self) {
            if (!n) return false;
            if (/Tu tema "Tema"/i.test(n.mensaje || '') && self.some(function(o) { return o && o !== n && o.tipo === 'like_tema' && !/Tu tema "Tema"/i.test(o.mensaje || ''); })) {
                return false;
            }
            return true;
        });
        if (filtrada.length !== listaGuardada.length) {
            listaGuardada = filtrada;
            localStorage.setItem('checkpoint_notificaciones_app_v1', JSON.stringify(listaGuardada));
        }
    } catch (e) {}

    const tarjetasNotif = Array.from(document.querySelectorAll('div')).filter(function(el) {
        if (el.id === 'listaNotificacionesComunidadRender' || el.classList.contains('notif-icon-list-badge')) return false;
        const txt = (el.textContent || '');
        if (!/Me gusta|le ha gustado|respondido|comentado/i.test(txt)) return false;
        const rect = el.getBoundingClientRect();
        if (rect.height < 52 || rect.height > 135 || rect.width < 220) return false;
        const estilo = window.getComputedStyle(el);
        return estilo.display === 'flex' && (el.children.length === 2 || el.children.length === 3);
    });

    tarjetasNotif.forEach(function(card) {
        const textoTarjeta = (card.textContent || '');

        // Si es la tarjeta duplicada genérica 'Tu tema "Tema"', la ocultamos si ya está la del nombre real
        if (/Tu tema "Tema"/i.test(textoTarjeta) && tarjetasNotif.length > 1) {
            card.remove();
            return;
        }

        const notifMatch = listaGuardada.find(function(n) {
            return n && n.mensaje && textoTarjeta.indexOf(n.mensaje.slice(0, 18)) !== -1;
        });

        card.style.cursor = 'pointer';
        card.onclick = function(ev) {
            if (ev.target.closest('button')) return;
            window.abrirDestinoDesdeNotificacion(notifMatch, textoTarjeta);
        };

        const primerHijo = card.firstElementChild;
        const segundoHijo = card.children[1];
        if (!primerHijo || !segundoHijo) return;

        const esNotifLista = /en tu lista|gustado tu lista/i.test(textoTarjeta);
        if (esNotifLista) {
            if (!primerHijo.classList.contains('notif-icon-list-badge') && !primerHijo.querySelector('.notif-icon-list-badge')) {
                primerHijo.outerHTML = window.generarBadgeIconoListaHTML();
            }
            return;
        }

        const imgIzq = primerHijo.tagName === 'IMG' ? primerHijo : primerHijo.querySelector('img');
        if (imgIzq && imgIzq.src && imgIzq.src.indexOf('http') === 0 && (!imgIzq.complete || imgIzq.naturalWidth > 0)) {
            return;
        }

        const coverUrl = (notifMatch && (notifMatch.imagen || notifMatch.cover)) ||
                         window.obtenerPortadaJuegoPorIdOTitulo(notifMatch ? notifMatch.idJuego : '', textoTarjeta);

        if (coverUrl && coverUrl.indexOf('http') === 0) {
            primerHijo.style.cssText = 'width: 46px !important; height: 62px !important; min-width: 46px !important; border-radius: 10px !important; overflow: hidden !important; flex-shrink: 0 !important; background: #e5e7eb !important; display: flex !important; align-items: center !important; justify-content: center !important;';
            primerHijo.innerHTML = '<img class="notif-game-cover-left" src="' + coverUrl + '" alt="Portada" style="width: 100% !important; height: 100% !important; object-fit: cover !important; display: block !important;">';
        }
    });
};

