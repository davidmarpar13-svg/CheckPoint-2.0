window.juegosExtraListasCache = window.juegosExtraListasCache || {};

// 1. Capturamos siempre el ID y los datos visuales del juego al abrir su ficha
(function() {
    const originalOpenGameDetail = window.openGameDetail;
    if (typeof originalOpenGameDetail === 'function' && !window._openGameDetailHooked) {
        window._openGameDetailHooked = true;
        window.openGameDetail = function(idJuego) {
            const idLimpio = (idJuego && typeof idJuego === 'object') ? idJuego.id : idJuego;
            if (idLimpio !== undefined && idLimpio !== null && String(idLimpio).trim() !== '') {
                window.juegoActualEnFichaId = String(idLimpio).trim();
                window.currentGameId = window.juegoActualEnFichaId;
                window.idJuegoActual = window.juegoActualEnFichaId;
            }
            const res = originalOpenGameDetail.apply(this, arguments);
            setTimeout(window.capturarDatosVisualesJuegoActual, 100);
            setTimeout(window.capturarDatosVisualesJuegoActual, 350);
            return res;
        };
    }
})();

window.obtenerIdJuegoActualSeguro = function(idExplicito) {
    let id = String(
        idExplicito ||
        window.juegoActualEnFichaId ||
        window.currentGameId ||
        window.idJuegoActual ||
        window.juegoSeleccionadoId ||
        ''
    ).trim();

    if (id && id !== 'null' && id !== 'undefined') return id;

    // Si no estaba en variable global, buscamos por el título de la ficha abierta
    const detailScreen = document.getElementById('gameDetailScreen') || document;
    const titleEl = detailScreen.querySelector('h1, h2, [id*="Title"], [id*="title"]');
    const tituloFicha = titleEl ? (titleEl.textContent || '').trim() : '';

    if (tituloFicha && window.miColeccionActiva) {
        const encontrado = Object.entries(window.miColeccionActiva).find(([k, j]) =>
            j && String(j.nombre || j.name || '').trim().toLowerCase() === tituloFicha.toLowerCase()
        );
        if (encontrado) {
            id = String(encontrado[1].id || encontrado[0]);
            window.juegoActualEnFichaId = id;
            return id;
        }
    }

    if (tituloFicha) {
        id = 'juego_' + tituloFicha.toLowerCase().replace(/[^a-z0-9]+/g, '_');
        window.juegoActualEnFichaId = id;
        return id;
    }
    return '';
};

window.capturarDatosVisualesJuegoActual = function() {
    const id = window.obtenerIdJuegoActualSeguro();
    if (!id) return null;

    const coleccion = window.miColeccionActiva || {};
    if (coleccion[id] && coleccion[id].caratula) {
        window.juegosExtraListasCache[id] = {
            id: id,
            nombre: coleccion[id].nombre || 'Juego',
            caratula: coleccion[id].caratula
        };
        return window.juegosExtraListasCache[id];
    }

    const detailScreen = document.getElementById('gameDetailScreen') || document;
    const imgEl = detailScreen.querySelector('img[src*="igdb.com"]');
    const titleEl = detailScreen.querySelector('h1, h2, [id*="Title"], [id*="title"]');

    let caratulaHash = '';
    if (imgEl && imgEl.src) {
        const match = imgEl.src.match(/\/([a-z0-9_]+)\.(jpg|png|webp)/i);
        if (match && match[1]) caratulaHash = match[1];
    }
    const nombreJuego = titleEl ? (titleEl.textContent || '').trim() : 'Juego';

    if (caratulaHash || nombreJuego) {
        window.juegosExtraListasCache[id] = { id: id, nombre: nombreJuego, caratula: caratulaHash };
    }
    return window.juegosExtraListasCache[id] || { id: id, nombre: nombreJuego, caratula: '' };
};

// 2. Carga y normaliza todas tus listas asegurando siempre su clave ID
window.asegurarListasCargadasYLimpia = async function() {
    window.misListasCache = window.misListasCache || {};

    // Si aún no se han cargado las listas del perfil, llamamos a la función nativa
    if (Object.keys(window.misListasCache).length === 0 && typeof window.cargarListasDelPerfil === 'function') {
        try {
            window.cargarListasDelPerfil();
            for (let i = 0; i < 10; i++) {
                if (Object.keys(window.misListasCache).length > 0) break;
                await new Promise(r => setTimeout(r, 60));
            }
        } catch (e) {}
    }

    // Fallback directo a Firebase si sigue vacío
    const usuarioActual = (typeof auth !== 'undefined' && auth.currentUser) ? auth.currentUser : null;
    if (Object.keys(window.misListasCache).length === 0 && usuarioActual && typeof db !== 'undefined' && typeof collection !== 'undefined' && typeof getDocs !== 'undefined') {
        try {
            const snap = await getDocs(collection(db, 'users', usuarioActual.uid, 'listas'));
            snap.forEach(docSnap => {
                if (docSnap.exists()) {
                    const data = docSnap.data();
                    const idLista = String(data.id || docSnap.id);
                    data.id = idLista;
                    window.misListasCache[idLista] = data;
                }
            });
        } catch (e) {}
    }

    // Fallback de respaldo leyendo las tarjetas de listas ya pintadas en el DOM
    if (Object.keys(window.misListasCache).length === 0) {
        document.querySelectorAll('[onclick*="abrirDetalleLista"]').forEach(card => {
            const attr = card.getAttribute('onclick') || '';
            const m = attr.match(/abrirDetalleLista\(['"]([^'"]+)['"]\)/);
            if (m && m[1]) {
                const idLista = m[1];
                const h3 = card.querySelector('h3');
                const p = card.querySelector('p');
                window.misListasCache[idLista] = {
                    id: idLista,
                    titulo: h3 ? h3.textContent.trim() : 'Lista',
                    descripcion: p ? p.textContent.trim() : '',
                    juegos: []
                };
            }
        });
    }

    // Normalizamos el .id en cada entrada de window.misListasCache y limpiamos IDs corruptos
    for (const [keyId, lista] of Object.entries(window.misListasCache)) {
        if (!lista || typeof lista !== 'object') continue;
        lista.id = String(lista.id || keyId);

        if (lista.juegosInfo && typeof lista.juegosInfo === 'object') {
            Object.assign(window.juegosExtraListasCache, lista.juegosInfo);
        }

        if (Array.isArray(lista.juegos)) {
            const juegosLimpios = Array.from(new Set(
                lista.juegos
                    .map(x => String(x || '').trim())
                    .filter(x => x !== '' && x !== 'null' && x !== 'undefined')
            ));
            if (juegosLimpios.length !== lista.juegos.length) {
                lista.juegos = juegosLimpios;
                if (usuarioActual && typeof db !== 'undefined' && typeof doc !== 'undefined' && typeof setDoc !== 'undefined') {
                    try {
                        await setDoc(doc(db, 'users', usuarioActual.uid, 'listas', lista.id), lista, { merge: true });
                    } catch (e) {}
                }
            }
        } else {
            lista.juegos = [];
        }
    }

    return window.misListasCache;
};

// 3. Filtra las tarjetas en #listasJuegoOverlay manteniendo intacta la cabecera
window.filtrarTarjetasListasPorJuegoActual = async function(idJuegoExplicito) {
    const overlay = document.getElementById('listasJuegoOverlay');
    if (!overlay) return;

    await window.asegurarListasCargadasYLimpia();

    const idJuego = window.obtenerIdJuegoActualSeguro(idJuegoExplicito);
    if (!idJuego) return;

    const cacheListas = window.misListasCache || {};
    const coleccion = Object.assign({}, window.juegosExtraListasCache || {}, window.miColeccionActiva || {});
    const tarjetas = overlay.querySelectorAll('[onclick*="abrirDetalleLista"]');

    let visibles = 0;
    const idsTarjetasEnDOM = new Set();

    tarjetas.forEach(tarjeta => {
        const attrOnclick = tarjeta.getAttribute('onclick') || '';
        const match = attrOnclick.match(/abrirDetalleLista\(['"]([^'"]+)['"]\)/);
        if (match && match[1]) {
            const idLista = match[1];
            idsTarjetasEnDOM.add(idLista);
            const datosLista = cacheListas[idLista];
            const juegosEnLista = (datosLista && Array.isArray(datosLista.juegos))
                ? datosLista.juegos.map(String)
                : [];

            if (juegosEnLista.includes(idJuego)) {
                tarjeta.style.display = 'flex';
                visibles++;
            } else {
                tarjeta.style.display = 'none';
            }
        }
    });

    // Si acabamos de añadir el juego a una lista y su tarjeta aún no estaba en #listasJuegoOverlay, la pintamos
    Object.entries(cacheListas).forEach(([keyId, infoLista]) => {
        if (!infoLista || !Array.isArray(infoLista.juegos)) return;
        const idLista = String(infoLista.id || keyId);
        if (infoLista.juegos.map(String).includes(idJuego) && !idsTarjetasEnDOM.has(idLista)) {
            visibles++;
            let contenedorExtra = document.getElementById('contenedorTarjetasExtraListasJuego');
            if (!contenedorExtra) {
                contenedorExtra = document.createElement('div');
                contenedorExtra.id = 'contenedorTarjetasExtraListasJuego';
