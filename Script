                            </div>
                        </div>
                        
                        <!-- Medalla de Puntuación (Fondo doradito con icono) -->
                        <div style="display: flex; align-items: center; gap: 6px; background: #fffbeb; padding: 6px 14px; border-radius: 30px; border: 1px solid #fde68a;">
                            <svg style="width: 16px; height: 16px; fill: #d97706;" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                            <span style="color: #b45309; font-weight: 800; font-size: 1.05rem; letter-spacing: 0.5px;">${notaStr}</span>
                        </div>
                    </div>
                    
                    <!-- Texto de la Reseña -->
                    <div style="margin-top: 18px; padding-left: 15px; border-left: 3px solid #e5e7eb;">
                        <p style="margin: 0; font-size: 0.95rem; color: #444; line-height: 1.6; font-style: italic;">
                            ${textoResena}
                        </p>
                    </div>
                    
                </div>
            </div>
        `;
    });

    htmlResenas += `</div>`;
    contenedorResenas.innerHTML = htmlResenas;
};

const juegosConResena = Object.values(window.miColeccionActiva).filter(juego => 
        (juego.puntuacion && Number(juego.puntuacion) > 0) || (juego.reseña && juego.reseña.trim() !== "")
    );

    const contadorResenas = document.getElementById('statReviews');
    if (contadorResenas) {
        contadorResenas.innerText = juegosConResena.length;
    }
  

    </script>
