window.cargarAvisosEstrenoGuardados = function() {
    try {
        const raw = localStorage.getItem('checkpoint_avisos_estreno_v2');
        if (raw) {
            const parsed = JSON.parse(raw);
            if (parsed && typeof parsed === 'object') {
                window.misAvisosEstreno = Object.assign({}, parsed, window.misAvisosEstreno || {});
            }
        }
    } catch (e) {}

    try {
        const rawNotif = localStorage.getItem('checkpoint_notificaciones_v2');
        if (rawNotif) {
            const parsedN = JSON.parse(rawNotif);
            if (Array.isArray(parsedN) && (!window.misNotificacionesGenerales || window.misNotificacionesGenerales.length === 0)) {
                window.misNotificacionesGenerales = parsedN;
            }
        }
    } catch (e) {}
};

window.sincronizarAvisosDesdeFirebase = async function(userObj) {
    window.cargarAvisosEstrenoGuardados();
    try {
        const u = userObj || (typeof auth !== 'undefined' ? auth.currentUser : null);
        if (!u || !u.uid || typeof db === 'undefined' || typeof doc === 'undefined' || typeof getDoc === 'undefined') return;

        const userRef = doc(db, 'users', u.uid);
        const snap = await getDoc(userRef);
        if (snap && snap.exists()) {
            const data = snap.data() || {};
            if (data.avisosEstreno && typeof data.avisosEstreno === 'object') {
                window.misAvisosEstreno = Object.assign({}, window.misAvisosEstreno || {}, data.avisosEstreno);
                localStorage.setItem('checkpoint_avisos_estreno_v2', JSON.stringify(window.misAvisosEstreno));
            }
            if (Array.isArray(data.notificacionesGenerales) && data.notificacionesGenerales.length > 0) {
                const mapaNotifs = new Map();
                (window.misNotificacionesGenerales || []).concat(data.notificacionesGenerales).forEach(n => {
                    if (n && n.id) mapaNotifs.set(n.id, n);
                });
                window.misNotificacionesGenerales = Array.from(mapaNotifs.values()).sort((a, b) => (b.fecha || 0) - (a.fecha || 0));
                localStorage.setItem('checkpoint_notificaciones_v2', JSON.stringify(window.misNotificacionesGenerales));
            }
        }
        window.verificarEstrenosCumplidosAlIniciar();
        if (window.filtrosActivosColeccion && window.filtrosActivosColeccion.estado === 'avisos') {
            window.renderizarAvisosEnColeccionPerfil();
        }
    } catch (e) {
        console.error('Error al sincronizar avisos desde Firebase:', e);
    }
};

