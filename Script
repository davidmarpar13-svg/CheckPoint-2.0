window.manejarHoverEstrella = function(rating) { if (!window.reseñaBloqueada) window.pintarEstrellas(rating); };
window.seleccionarEstrella = function(rating) { if (!window.reseñaBloqueada) { window.notaActualReseña = rating; window.pintarEstrellas(rating); }};
window.restaurarEstrellas = function() { if (!window.reseñaBloqueada) window.pintarEstrellas(window.notaActualReseña); };
window.pintarEstrellas = function(rating) {
    for(let i = 1; i <= 10; i++) {
        const star = document.getElementById(`star-icon-${i}`);
        if(star) {
            const isFilled = i <= rating;
            star.style.fill = isFilled ? '#ffd700' : 'rgba(255,255,255,0.1)';
            star.style.filter = isFilled ? 'drop-shadow(0 0 5px rgba(255,215,0,0.5))' : 'none';
            star.style.stroke = isFilled ? '#ffaa00' : 'rgba(255,255,255,0.2)';
            star.style.cursor = window.reseñaBloqueada ? 'default' : 'pointer';
        }
    }
    const textoRating = document.getElementById('ratingTextLabel');
    if(textoRating) textoRating.innerText = rating > 0 ? `${rating} / 10` : 'Sin puntuar';
};
