window.guardarNuevaLista = window.guardarNuevoLista = async function() {
    console.log("💾 Intentando guardar la nueva lista...");

    const tituloInput = document.getElementById('inputTituloLista');
    const descInput = document.getElementById('inputDescLista');
    const inputArchivo = document.getElementById('inputBannerLista');

    const titulo = tituloInput ? tituloInput.value.trim() : '';
    const descripcion = descInput ? descInput.value.trim() : '';

    if (!titulo) {
        alert("¡Por favor, ponle un título a tu lista!");
        return;
    }

    const ejecutarGuardado = async (bannerFinalUrl) => {
        const juegosSeleccionados = [];
        const items = document.querySelectorAll('#contenedorCrearListaJuegos .juego-crear-lista-item');

        items.forEach(item => {
            const check = item.querySelector('.check-overlay');
            if (check && check.style.display === 'flex') {
                juegosSeleccionados.push(item.getAttribute('data-id'));
            }
        });

        const idLista = 'lista_' + Date.now();
        const nuevaListaData = {
            id: idLista,
            titulo: titulo,
            descripcion: descripcion,
            banner: bannerFinalUrl,
            juegos: juegosSeleccionados,
            fechaCreacion: Date.now()
        };

        // 1. Guardamos en caché local al instante
        if (!window.misListasCache) window.misListasCache = {};
        window.misListasCache[idLista] = nuevaListaData;

        // 2. Limpiamos el formulario y CERRAMOS LA VENTANA DE INMEDIATO
        if (tituloInput) tituloInput.value = '';
        if (descInput) descInput.value = '';
        if (inputArchivo) inputArchivo.value = '';
        
        const bannerDiv = document.getElementById('bannerListaVisual');
        if (bannerDiv) bannerDiv.style.backgroundImage = '';

        const contenidoBanner = document.getElementById('bannerListaContenido');
        if (contenidoBanner) {
            contenidoBanner.style.background = 'rgba(255, 255, 255, 0.85)';
            contenidoBanner.innerHTML = '<span class="material-symbols-rounded" style="color: #333; font-size: 36px; margin-bottom: 4px; display: block;">add_photo_alternate</span><div style="color: #444; font-family: \'Outfit\', sans-serif; font-size: 0.8rem; font-weight: 600;">Añadir banner de la lista</div>';
        }

        document.querySelectorAll('#contenedorCrearListaJuegos .juego-crear-lista-item').forEach(item => {
            const check = item.querySelector('.check-overlay');
            if (check) check.style.display = 'none';
            item.style.border = '2px solid transparent';
            item.style.transform = 'scale(1)';
        });

        window.cerrarCreadorListas();

        // 3. Guardamos en Firebase con el banner ya comprimido y ligero
        try {
            const usuarioActual = (typeof auth !== 'undefined' && auth.currentUser) ? auth.currentUser : null;
            if (usuarioActual && typeof db !== 'undefined') {
                const listaRef = doc(db, 'users', usuarioActual.uid, 'listas', idLista);
                await setDoc(listaRef, nuevaListaData);
                console.log("✅ Lista y banner ligero guardados en Firebase correctamente.");
            }
        } catch (error) {
            console.error("❌ Error al guardar en Firebase:", error);
        }

        if (typeof window.cargarListasDelPerfil === 'function') {
            window.cargarListasDelPerfil();
        }
    };

    // Si hay imagen subida, la comprimimos automáticamente a JPEG ligero (máx 800px) para no saturar Firebase
    if (inputArchivo && inputArchivo.files && inputArchivo.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            const img = new Image();
            img.onload = function() {
                const canvas = document.createElement('canvas');
                const maxWidth = 800;
                const scale = img.width > maxWidth ? (maxWidth / img.width) : 1;
                canvas.width = Math.round(img.width * scale);
                canvas.height = Math.round(img.height * scale);

                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

                // Exportamos comprimido al 70% de calidad (reduce varios MB a unos ~40 KB)
                const dataUrlComprimido = canvas.toDataURL('image/jpeg', 0.7);
                ejecutarGuardado(`url('${dataUrlComprimido}')`);
            };
            img.src = e.target.result;
        };
        reader.readAsDataURL(inputArchivo.files[0]);
    } else {
        ejecutarGuardado('linear-gradient(135deg, #2b5876 0%, #4e4376 100%)');
    }
};

window.cargarListasDelPerfil = async function() {
