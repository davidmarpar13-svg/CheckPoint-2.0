window.aplicarFiltroYVistaListasPerfil = function() {
    const tabListas = document.getElementById('tab-listas');
    if (!tabListas) return;
    const esMias = window.estadoSubTabListasPerfil !== 'seguidas';
    const contSeguidas = document.getElementById('contenedorListasSeguidasPerfil');
    const q = (window.busquedaListasPerfil || '').trim();

    Array.from(tabListas.children).forEach(function(hijo) {
        if (hijo.id === 'subNavListasPerfilWrap' || hijo.id === 'contenedorListasSeguidasPerfil') return;
        if (!esMias) {
            hijo.style.setProperty('display', 'none', 'important');
        } else {
            hijo.style.removeProperty('display');
            if (/CREAR\s+LISTA/i.test(hijo.textContent || '')) {
                if (hijo.tagName === 'BUTTON') {
                    hijo.classList.add('btn-crear-lista-centrado');
                    hijo.style.setProperty('display', 'flex', 'important');
                }
            } else if (q) {
                const tarjetas = hijo.querySelectorAll('[onclick*="Lista"], [onclick*="lista"], .lista-card');
                if (tarjetas.length > 0) {
                    tarjetas.forEach(function(c) {
                        c.style.display = window.coincideBusquedaFlexible(c.textContent || '', q) ? '' : 'none';
                    });
                } else if (!window.coincideBusquedaFlexible(hijo.textContent || '', q)) {
                    hijo.style.display = 'none';
                }
            } else {
                hijo.querySelectorAll('[style*="display: none"]').forEach(function(c) { c.style.display = ''; });
            }
        }
    });

    if (!contSeguidas) return;
    if (esMias) { contSeguidas.style.display = 'none'; return; }
    contSeguidas.style.display = 'block';
    window.cargarListasSeguidasYLikes();
    let seguidas = Object.values(window.misListasSeguidas || {});
    if (q) {
        seguidas = seguidas.filter(function(l) {
            return window.coincideBusquedaFlexible((l.titulo || '') + ' ' + (l.descripcion || ''), q);
        });
    }
    if (seguidas.length === 0) {
        contSeguidas.innerHTML = '<div style="text-align: center; padding: 45px 20px; color: #777; font-family: \'Outfit\', sans-serif;"><span class="material-symbols-rounded" style="font-size: 44px; color: #d1d5db; margin-bottom: 10px;">bookmark_border</span><div style="font-weight: 800; font-size: 0.92rem; color: #374151; margin-bottom: 6px;">No sigues ninguna lista todavía</div></div>';
        return;
    }
    const usuario = window.ComunidadApp ? window.ComunidadApp.obtenerUsuarioActivo() : { uid: 'anon' };
    contSeguidas.innerHTML = seguidas.map(function(lista) {
        const juegos = Array.isArray(lista.juegos) ? lista.juegos : [];
        const infoLikes = window.likesDeListas[lista.id] || { count: 0, users: [] };
        const dioLike = Array.isArray(infoLikes.users) && infoLikes.users.indexOf(usuario.uid) !== -1;
        const miniCovers = juegos.slice(0, 6).map(function(j) {
            return '<img src="' + (j.cover || j.caratula || '') + '" style="width: 48px; height: 64px; border-radius: 8px; object-fit: cover; flex-shrink: 0;" alt="Cover">';
        }).join('');
        return '<div style="background: #ffffff; border-radius: 20px; overflow: hidden; margin-bottom: 16px; box-shadow: 0 6px 20px rgba(0,0,0,0.06); border: 1px solid rgba(0,0,0,0.05);">' +
            '<div style="position: relative; height: 115px; background: #222; overflow: hidden;">' +
            (lista.banner ? '<img src="' + lista.banner + '" style="width: 100%; height: 100%; object-fit: cover; filter: brightness(0.72);">' : '') +
            '<div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.75) 100%); display: flex; flex-direction: column; justify-content: flex-end; padding: 14px 16px;">' +
            '<div style="font-family: \'Cinzel\', serif; font-size: 1.15rem; font-weight: 800; color: #fff;">' + (lista.titulo || 'LISTA') + '</div>' +
            '<div style="font-size: 0.76rem; color: rgba(255,255,255,0.85);">' + (lista.descripcion || '') + '</div></div></div>' +
            '<div style="padding: 12px 14px; display: flex; align-items: center; gap: 10px; overflow-x: auto;">' +
            '<div style="background: #f3f4f6; border-radius: 16px; padding: 6px 12px; font-size: 0.78rem; font-weight: 800; color: #111; display: inline-flex; align-items: center; gap: 5px; flex-shrink: 0;"><span>' + juegos.length + '</span><span class="material-symbols-rounded" style="font-size: 16px;">sports_esports</span></div>' +
            miniCovers +
            '<button type="button" class="btn-like-card-lista ' + (dioLike ? 'liked' : '') + '" style="margin-left: auto; flex-shrink: 0;" onclick="event.stopPropagation(); window.toggleLikeLista(\'' + lista.id + '\', \'' + (lista.titulo || '').replace(/'/g, '') + '\')"><span class="material-symbols-rounded" style="font-size: 15px;">' + (dioLike ? 'favorite' : 'favorite_border') + '</span><span>' + (infoLikes.count || 0) + '</span></button>' +
            '</div></div>';
    }).join('');
};

