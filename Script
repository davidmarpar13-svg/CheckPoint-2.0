    extraerTroncoSaga: function(titulo) {
        if (!titulo) return '';
        let base = String(titulo).trim();
        const baseNorm = this.normalizarSinTildes(base);

        if (/prince of persia/i.test(baseNorm)) return 'Prince of Persia';
        if (/devil may cry/i.test(baseNorm)) return 'Devil May Cry';
        if (/monkey island/i.test(baseNorm)) return 'Monkey Island';
        if (/\b(pokemon|pikachu|pokken)\b/i.test(baseNorm)) return 'Pokémon';
        if (/castlevania/i.test(baseNorm)) return 'Castlevania';
        if (/^runaway(\s*[23])?(\s*:\s*(a road adventure|the dream of the turtle|a twist of fate))?$/i.test(baseNorm)) return 'Runaway';
        if (/resident evil|biohazard/i.test(baseNorm)) return 'Resident Evil';
        if (/tomb raider/i.test(baseNorm)) return 'Tomb Raider';
        if (/legend of zelda|^zelda ii:/i.test(baseNorm)) return 'The Legend of Zelda';
        if (/kingdom hearts/i.test(baseNorm)) return 'Kingdom Hearts';

        if (base.includes(':')) base = base.split(':')[0].trim();
        else if (base.includes(' - ')) base = base.split(' - ')[0].trim();

        return base
            .replace(/^(the secret of|the curse of|escape from|tales of|return to|rise of the|shadow of the|dawn of the|war for the|planet of the|call of|legacy of|world of|age of|the rogue|super|new)\s+/i, '')
            .replace(/\b(complete edition|definitive edition|deluxe edition|special edition|vault edition|remake|remastered|hd|goty|rebirth|tamagotchi|requiem|village|catalyst|legacy of atlantis|version)\b/gi, '')
            .replace(/\s+(?:[0-9]+|[I]{1,3}|IV|V|VI{0,3}|VII|VIII|IX|X{1,3}|XI{0,3}|XIV|XV|XVI)$/i, '')
            .trim() || String(titulo).trim();
    },

