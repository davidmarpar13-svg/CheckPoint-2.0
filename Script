            'i'
        );

        // E) Detector de Spin-offs móviles y Minijuegos
        const regexNoPrincipalEnDescripcion = new RegExp(
            '\\b(tamagotchi|tamagochi|port[aá]til\\s+lcd|electronic\\s+lcd|handheld\\s+electronic|mascota\\s+virtual|virtual\\s+pet|game\\s*&\\s*watch|game\\s+watch|reloj\\s+lcd|' +
            'peak\\s+of\\s+combat|pinnacle\\s+of\\s+combat|devil\\s+may\\s+cry\\s+4\\s+refrain|nebulajoy|' +
            'mystery\\s+dungeon|mundo\\s+misterioso|pokemon\\s+ranger|pokemon\\s+snap|pokemon\\s+stadium|pokemon\\s+colosseum|gale\\s+of\\s+darkness|pokken|pokk[eé]n|detective\\s+pikachu|pokemon\\s+unite|pokemon\\s+go|pokemon\\s+sleep|pokemon\\s+masters|pokemon\\s+quest|pokemon\\s+rumble|pokemon\\s+shuffle|pokemon\\s+picross|pokemon\\s+trozei|pokemon\\s+cafe|pokepark|pok[eé]park|trading\\s+card\\s+game|juego\\s+de\\s+cartas\\s+coleccionables|pokemon\\s+conquest|battle\\s+revolution|hey\\s+you,\\s*pikachu|pokemon\\s+channel|pokemon\\s+dash|' +
            'card\\s+struggle|daifugou|daifug[oō]|kingdom\\s+hearts\\s+mobile|servicio\\s+m[oó]vil|fue\\s+descontinuado|uno\\s+de\\s+los\\s+tres\\s+minijuegos|' +
            'fue\\s+cancelado|proyecto\\s+fue\\s+cancelado|was\\s+cancelled|was\\s+canceled|cancelled\\s+game|canceled\\s+game|basado\\s+en\\s+la\\s+ubicaci[oó]n|location-based|' +
            'tres\\s+minijuegos|colecci[oó]n\\s+de\\s+minijuegos|minigame\\s+collection|experiencia\\s+de\\s+realidad\\s+virtual|vr\\s+experience|pinball|picross|mahjong|pachinko|pachislot|juego\\s+de\\s+mesa|board\\s+game|card\\s+&\\s+board\\s+game|browser\\s+game|juego\\s+de\\s+navegador|v-cast|v\\s+cast|on-rails\\s+shooter|light\\s+gun\\s+shooter|disparos\\s+sobre\\s+ra[ií]les)\\b',
            'i'
        );

        const regexPlataformaNoPrincipal = /\b(handheld electronic lcd|legacy mobile device|pokemon mini|pokémon mini|lcd|satellaview|cd-i|philips cd-i|zeebo|watch|apple watch|browser|web browser|dvd player|blu-ray)\b/i;
        const regexGeneroNoPrincipal = /\b(card\s*&\s*board\s*game|board\s*game|pinball|quiz|trivia|moba)\b/i;

        const esSoloMovil = /^(ios|android|ios,\s*android|android,\s*ios)$/i.test(plataforma);
        const esEpisodioSuelto = /\b(chapter|episode|cap[ií]tulo|episodio)\s*([2-9]|[1-9][0-9])\b/i.test(nombre);

        const esPortORemasterExplicito = [9, 10, 11].includes(cat) || regexPortORemasterEnDescripcion.test(desc) || tieneVinetasDeContenidoExtra || /\bspecial edition\b/i.test(nombre);
        const regexDescRemakeBueno = /\b(full remake|complete remake|remake completo|nueva versi[oó]n completa|re-imagining|reimagining|reimaginaci[oó]n|built from the ground up|hecho desde cero|remake del juego de|is a remake of)\b/i;
        const esRemakeBueno = ((cat === 8) || regexDescRemakeBueno.test(desc) || desarrollador.includes('grezzo')) &&
                              !esDLCoArmaPorDescripcion && !esPortORemasterExplicito && !esFanGame && !regexPlataformaNoPrincipal.test(plataforma) && !regexGeneroNoPrincipal.test(genero);

        const regexDescReboot = /\b(reboot|reborn|reinicio de la saga|historia de origen|origin story|young lara|joven lara|yamatai|endurance)\b/i;
        const esReboot = regexDescReboot.test(desc) && !esDLCoArmaPorDescripcion && !esFanGame && !esPortORemasterExplicito;

        const esComplementario =
            esDLCoArmaPorDescripcion ||
            esFanGame ||
            esEpisodioSuelto ||
            esSoloMovil ||
            esPortORemasterExplicito ||
            tieneVinetasDeContenidoExtra ||
            regexNoPrincipalEnDescripcion.test(desc) ||
            regexPlataformaNoPrincipal.test(plataforma) ||
            regexGeneroNoPrincipal.test(genero);

        const esNarrativaImportante = !esComplementario && superaCalidadGlobal && !tieneVinetasDeContenidoExtra;

        let motivoExclusion = '';
        if (esDLCoArmaPorDescripcion) motivoExclusion = 'DLC / Objeto';
        else if (esFanGame) motivoExclusion = 'Fan Game / Mod';
        else if (esEpisodioSuelto) motivoExclusion = 'Episodio';
        else if (/\b(cancelado|cancelled|canceled)\b/i.test(desc)) motivoExclusion = 'Cancelado';
        else if (tieneVinetasDeContenidoExtra) motivoExclusion = 'Recopilación / Extra';
        else if (esPortORemasterExplicito) motivoExclusion = 'Remaster / Edición';
        else if (esSoloMovil) motivoExclusion = 'Móvil / Spin-off';
        else if (/\b(tamagotchi|tamagochi|lcd)\b/i.test(desc + ' ' + nombre + ' ' + plataforma)) motivoExclusion = 'LCD / Extra';
        else if (regexGeneroNoPrincipal.test(genero) || /\b(daifugou|card struggle|kingdom hearts mobile)\b/i.test(desc + ' ' + nombre)) motivoExclusion = 'Minijuego Móvil';

        return {
            texto: desc,
            esDLCoArma: esDLCoArmaPorDescripcion,
            esFanGame: esFanGame,
            esPortORemaster: esPortORemasterExplicito,
            esComplementario: esComplementario,
            esNarrativaImportante: esNarrativaImportante,
            esRemakeBueno: esRemakeBueno,
            esReboot: esReboot,
            motivoExclusion: motivoExclusion
        };
    },

    abrir: async function(idJuegoParam) {
        const idJuego = String(idJuegoParam || window.juegoActualEnFichaId || window.currentGameId || '').trim();
        this.idJuegoRaizSaga = idJuego;
        this.volverASagaPendiente = false;

        const detailScreen = document.getElementById('gameDetailScreen') || document;
        const elTitulo = document.getElementById('gdTitle') || detailScreen.querySelector('h1, h2');
        const juegoCargado = (window.juegosCargados && window.juegosCargados[idJuego]) ||
                             this.registroJuegosIGDB[idJuego] ||
                             (window.miColeccionActiva && window.miColeccionActiva[idJuego]) || null;

        const tituloActual = (elTitulo ? elTitulo.textContent : (juegoCargado ? (juegoCargado.nombre || juegoCargado.name) : '')).trim();
        const devActual = this.obtenerDesarrolladorDeFicha(detailScreen) || (juegoCargado ? (juegoCargado.desarrollador || juegoCargado.developer || '') : '');
        const generosActuales = this.obtenerGenerosDeFicha(detailScreen, juegoCargado);
        const descOrigen = juegoCargado ? this.obtenerTextoDescripcionCompleto(juegoCargado) : '';
        const nombreSaga = this.extraerTroncoSaga(tituloActual) || tituloActual || 'Saga';
        const sagaKey = this.normalizarSinTildes(nombreSaga);

        const overlay = document.getElementById('sagaJuegoOverlay');
        if (!overlay) return;
        if (overlay.parentElement !== document.body) {
            document.body.appendChild(overlay);
        }

        const sub = document.getElementById('subtituloSagaInfo');
        if (sub) sub.style.display = 'none';

        document.getElementById('tituloSagaHeader').textContent = 'SAGA ' + nombreSaga.toUpperCase();
        document.getElementById('inputBuscadorInternoSaga').value = '';
        overlay.style.display = 'flex';

        this.acumuladosPorSaga[sagaKey] = this.acumuladosPorSaga[sagaKey] || [];
        let acumulados = this.acumuladosPorSaga[sagaKey];

        if (window.juegosCargados && typeof window.juegosCargados === 'object') {
            Object.values(window.juegosCargados).forEach(j => {
                if (j && this.esObjetoCompletoIGDB(j) && window.esJuegoValidoParaAppGlobal(j) && (j.nombre || j.name) && this.normalizarSinTildes(j.nombre || j.name).includes(sagaKey)) {
                    if (!acumulados.some(x => x && String(x.id) === String(j.id))) {
                        acumulados.push(j);
                    }
                }
            });
        }

        if (this.cacheSagas[sagaKey] && acumulados.length > 0) {
            this.procesarYActualizarVista(acumulados, nombreSaga, devActual, generosActuales, tituloActual, descOrigen, idJuego);
            this.cacheSagas[sagaKey] = {
                principales: this.estado.principales,
                todo: this.estado.todo
            };
            this.cambiarPestana('principales');
            return;
        }

        document.getElementById('contenedorGridSaga').innerHTML = `
            <div style="grid-column: 1 / -1; text-align: center; padding: 50px 20px; color: #888;">
                Cargando entregas principales de <b>${nombreSaga}</b>...
            </div>
        `;

        if (sagaKey === 'pokemon') {
            const lotesBasePokemon = await Promise.all([
                this.consultarIGDB('Pokémon Winds'),
                this.consultarIGDB('Pokémon Waves'),
                this.consultarIGDB('Pokémon Version'),
                this.consultarIGDB('Pokémon Legends'),
                this.consultarIGDB('Pokémon')
            ]);
            lotesBasePokemon.flat().forEach(j => acumulados.push(j));
        } else {
            const loteInicial = await this.consultarIGDB(nombreSaga);
            acumulados.push(...loteInicial);
        }

        this.procesarYActualizarVista(acumulados, nombreSaga, devActual, generosActuales, tituloActual, descOrigen, idJuego);

        const reglasSaga = this.REGLAS_PRINCIPALES_SAGA[sagaKey];
        if (reglasSaga) {
            const faltantes = reglasSaga.filter(regla => {
                return !acumulados.some(x => x && this.coincidePorTituloRealYFecha(x, regla));
            });

            const queriesUnicasFaltantes = Array.from(new Set(faltantes.map(f => f.query)));

            for (let i = 0; i < queriesUnicasFaltantes.length; i += 4) {
                const grupoQueries = queriesUnicasFaltantes.slice(i, i + 4);
                const respuestas = await Promise.all(grupoQueries.map(q => this.consultarIGDB(q)));
                respuestas.flat().forEach(juego => acumulados.push(juego));
                this.procesarYActualizarVista(acumulados, nombreSaga, devActual, generosActuales, tituloActual, descOrigen, idJuego);
                if (i + 4 < queriesUnicasFaltantes.length) {
                    await new Promise(r => setTimeout(r, 220));
                }
            }
        }

        this.cacheSagas[sagaKey] = {
            principales: this.estado.principales,
            todo: this.estado.todo
        };
        this.actualizarContadoresUI();
    },

    coincidePorTituloRealYFecha: function(juego, regla) {
        if (!window.esJuegoValidoParaAppGlobal(juego)) return false;

        const idStr = String(juego.id || '').trim();
        const nombreReal = String(juego.nombre || juego.name || '').trim();
        if (!nombreReal) return false;

