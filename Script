    window.misFavoritos[slotIndex] = gameId;

    document.getElementById('favGameModalOverlay').style.display = 'none';
    window.pintarTop3(); // Actualiza la pantalla rápido

    try {
        const user = auth.currentUser;
        if (user) {
            const userRef = doc(db, "users", user.uid);
            await updateDoc(userRef, { favoritos: window.misFavoritos });
        }
    } catch (error) { console.error("Error al guardar en Firebase:", error); }
};

