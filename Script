        <div style="font-family: 'Outfit', sans-serif; color: rgba(255,255,255,0.4); font-size: 0.4rem; text-align: center; letter-spacing: 1.5px; margin: 0px 0 0px 0; text-transform: uppercase;">Todos mis favoritos</div>`;
    }
    // 5.2 MENSAJES DE VACÍO (Evita que se rompa el HTML)
    if (juegosAMostrar.length === 0) {
        if (esPestanaFavoritos) {
            htmlFinal += '<div style="text-align: center; color: rgba(255,255,255,0.5); padding: 30px; font-style: italic; font-size: 13px;">Aún no has marcado ningún juego con la estrella.</div>';
        } else {
            htmlFinal += '<div style="text-align: center; color: #888; padding: 40px; font-style: italic; font-size: 14px;">Nada por aquí con este filtro...</div>';
        }
        contenedor.innerHTML = htmlFinal;
        return; 
    }

    // 5.3 EL GRID INFERIOR (Todos o Favoritos)
    htmlFinal += '<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; padding: 10px 10px; width: 100%; box-sizing: border-box;">';
    
