        // 2. ACTUALIZAMOS EL CARRUSEL
        async function loadHypeGames() {
            const carousel = document.querySelector('.hype-carousel');
            try {
                const separador = APPS_SCRIPT_URL.includes('?') ? '&' : '?';
                const urlFinal = `${APPS_SCRIPT_URL}${separador}action=hype&platform=${window.currentHypePlatform || 'todos'}&t=${Date.now()}`;
                
                const json = await fetchConReintentos(urlFinal);
                
                if(json && json.success && json.data.length > 0) {
                carousel.innerHTML = '';
                
                // 1. ORDENAMOS LOS JUEGOS POR FECHA
                json.data.sort((a, b) => a.first_release_date - b.first_release_date);

                json.data.forEach(game => {
            // 1. GUARDAMOS EN MEMORIA (Para que el modal funcione al hacer clic)
            window.juegosCargados[game.id] = game;

            const dateObj = new Date(game.first_release_date * 1000);
            const dateStr = dateObj.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }).toUpperCase();
            const platforms = game.platforms ? game.platforms.map(p => p.abbreviation || 'PC').join(', ') : 'PC, Consolas';

            const coverId = game.cover?.image_id || 'null';
            const safeTitle = game.name ? game.name.replace(/'/g, "\\'").replace(/"/g, "&quot;") : "Juego";
            
            // 2. PARA EL CARRUSEL: Priorizamos el ARTWORK para que quede bonito. 
            // Si un juego indie no tiene artwork, usamos screenshot como plan B.
            const artworkId = game.artworks?.[0]?.image_id;
            const thumbnailId = artworkId || game.screenshots?.[0]?.image_id || 'null';
            const imgUrl = thumbnailId !== 'null' ? `https://images.igdb.com/igdb/image/upload/t_screenshot_med/${thumbnailId}.jpg` : '';

            // 3. ONCLICK CORTO: Solo pasamos el ID. El modal se encargará de buscar la screenshot.
            carousel.innerHTML += `
                <div class="hype-card glass-panel" onclick="openGameDetail('${game.id}', 'not_owned')" style="cursor: pointer;">
                    <div class="hype-date" style="position: absolute !important; top: 10px !important; left: 10px !important; background: rgba(0, 0, 0, 0.55) !important; backdrop-filter: blur(6px) !important; color: #ffffff !important; padding: 4px 9px !important; border-radius: 5px !important; font-weight: 700 !important; font-size: 11px !important; z-index: 20 !important;">
                        ${dateStr}
                    </div>
                    <img src="${imgUrl}" alt="${safeTitle}">
                    <div class="hype-info">
                        <h3>${game.name}</h3>
                        <p>${platforms}</p>
                    </div>
                </div>
            `;
        });
            }
            } catch(e) { console.error("Error hype:", e); }
        }

