window.transformarPapeleraEnTresPuntosLista = function() {
    const nodos = Array.from(document.querySelectorAll('div, span, h3, h4'));
    const etiquetaJuegosLista = nodos.find(function(el) {
        return el.children.length <= 2 && /Juegos de la lista/i.test((el.textContent || '').trim()) && window.esElementoVisibleEnPantalla(el);
    });
    if (!etiquetaJuegosLista) return;

    const modalLista = etiquetaJuegosLista.closest('[id*="Modal"], [id*="modal"], [id*="Lista"], [id*="lista"], [class*="modal"]') ||
                       etiquetaJuegosLista.parentElement.parentElement.parentElement;
    if (!modalLista) return;

    let filaCabeceraJuegos = etiquetaJuegosLista;
    while (filaCabeceraJuegos.parentElement && filaCabeceraJuegos.parentElement !== modalLista && !filaCabeceraJuegos.nextElementSibling) {
        filaCabeceraJuegos = filaCabeceraJuegos.parentElement;
    }
    const contenedorGridJuegos = filaCabeceraJuegos.nextElementSibling || Array.from(modalLista.querySelectorAll('div')).find(function(d) {
        return d.querySelectorAll('img').length >= 1;
    });
    if (contenedorGridJuegos) {
        contenedorGridJuegos.classList.add('grid-juegos-lista-tres-columnas');
        contenedorGridJuegos.style.setProperty('display', 'grid', 'important');
        contenedorGridJuegos.style.setProperty('grid-template-columns', 'repeat(3, minmax(0, 1fr))', 'important');
        contenedorGridJuegos.style.setProperty('gap', '10px', 'important');
    }

    const btnPapeleraOriginal = Array.from(modalLista.querySelectorAll('button, span, div')).find(function(el) {
        const txt = (el.textContent || '').trim();
        return (txt === 'delete' || txt === 'delete_outline' || txt === '🗑️') && el.tagName !== 'DIV';
    });

    const botonContenedorPapelera = btnPapeleraOriginal ? (btnPapeleraOriginal.closest('button') || btnPapeleraOriginal) : null;
    const contenedorBanner = botonContenedorPapelera ? botonContenedorPapelera.parentElement : modalLista.firstElementChild;
    if (!contenedorBanner) return;

    const nodoTitulo = modalLista.querySelector('h1, h2, [style*="Cinzel"]') || contenedorBanner.querySelector('div, h2');
    const tituloLista = (nodoTitulo ? nodoTitulo.textContent : 'Lista').replace(/\d+\s*Juegos en total|\d+\s*Juegos.*/i, '').trim();
    const idLista = modalLista.dataset.listaIdActual || ('lista_' + tituloLista.toLowerCase().replace(/[^a-z0-9]/g, '_'));

    if (botonContenedorPapelera && !botonContenedorPapelera.dataset.ocultadoPorMenu) {
        botonContenedorPapelera.dataset.ocultadoPorMenu = 'true';
        botonContenedorPapelera.style.setProperty('display', 'none', 'important');
        window._ultimoBotonBorrarListaNativo = botonContenedorPapelera;
    }

    const btnEditar = Array.from(modalLista.querySelectorAll('button, div')).find(function(el) {
        return /Editar lista/i.test((el.textContent || '').trim());
    });
    const esListaMia = Boolean(btnEditar && window.esElementoVisibleEnPantalla(btnEditar));

    let barraAcciones = modalLista.querySelector('.acciones-top-derecha-lista');
    if (!barraAcciones) {
        barraAcciones = document.createElement('div');
        barraAcciones.className = 'acciones-top-derecha-lista';
        contenedorBanner.style.position = 'relative';
