window.esJuegoValidoParaAppGlobal = function(j) {
    if (!j || typeof j !== 'object') return false;

    const idStr = String(j.id || '').trim();
    if (idStr && window.miColeccionActiva && window.miColeccionActiva[idStr]) {
        return true;
    }
    if (j._esFallbackOficial) return true;

    const nombre = String(j.nombre || j.name || j.titulo || j.title || '').trim();
    if (!nombre) return false;

    if (/[\u3000-\u9fff\uff00-\uffef]/.test(nombre)) return false;

    const tienePortada = Boolean(
        (j.caratula && String(j.caratula).trim() !== '') ||
        (j.cover && (typeof j.cover === 'string' || j.cover.image_id || j.cover.url)) ||
        j.portada || j.imagen || j.coverUrl
    );
    if (!tienePortada) return false;

    let dev = String(
        j.desarrollador || j.developer || j.developers || j.compania || j.estudio ||
        (Array.isArray(j.involved_companies)
            ? j.involved_companies.map(c => (c && c.company && c.company.name) || c).filter(Boolean).join(', ')
            : '') || ''
    ).trim();

    if (!dev || /^(desconocido|no especificado|unknown|n\/a|none|null|undefined|sin especificar|sin desarrollador|ninguno|-)$/i.test(dev)) {
        return false;
    }

    let gen = String(
        j.generos || j.genero || j.genre ||
        (Array.isArray(j.genres)
            ? j.genres.map(g => (g && g.name) || g).filter(Boolean).join(', ')
            : (typeof j.genres === 'string' ? j.genres : '')) || ''
    ).trim();

    if (!gen || /^(no especificado|desconocido|unknown|n\/a|none|null|undefined|sin especificar|sin genero|sin género|ninguno|-)$/i.test(gen)) {
        return false;
    }

    const desc = String(
        j.sinopsis || j.descripcion || j.resumen || j.summary || j.storyline || j.description || j.historia || ''
    ).replace(/\s+/g, ' ').trim();

    if (!desc || desc.length < 90) return false;

    const numPalabras = desc.split(' ').filter(w => w.length >= 2).length;
    if (numPalabras < 14) return false;

    if (/^(sin descripci[oó]n|no hay descripci[oó]n|descripci[oó]n no disponible|no disponible|sin sinopsis|coming soon|tba|tbd)/i.test(desc)) {
        return false;
    }

    if (/\b(fan\s*game|fangame|fan-game|fan\\s*made|fan-made|hecho por fans|creado por fans|juego de fans|rom\s*hack|romhack|bootleg|unofficial|no oficial)\b/i.test(nombre + ' ' + desc)) {
        return false;
    }

    return true;
};

window.esArrayDeJuegosIGDB = function(arr) {
    if (!Array.isArray(arr) || arr.length === 0) return false;
    const muestra = arr.slice(0, 5).filter(x => x && typeof x === 'object');
    if (muestra.length === 0) return false;
    return muestra.some(x =>
        (x.id !== undefined) &&
        (x.nombre !== undefined || x.name !== undefined) &&
        (x.caratula !== undefined || x.cover !== undefined || x.sinopsis !== undefined || x.summary !== undefined || x.desarrollador !== undefined || x.plataformas !== undefined)
    );
};

window.limpiarRespuestaServidorIGDB = function(respuesta) {
    if (!respuesta) return respuesta;

    if (Array.isArray(respuesta)) {
        if (window.esArrayDeJuegosIGDB(respuesta)) {
            return respuesta.filter(window.esJuegoValidoParaAppGlobal);
        }
        return respuesta;
    }

    if (typeof respuesta === 'object') {
        Object.keys(respuesta).forEach(k => {
            const val = respuesta[k];
            if (Array.isArray(val) && window.esArrayDeJuegosIGDB(val)) {
                respuesta[k] = val.filter(window.esJuegoValidoParaAppGlobal);
            } else if (val && typeof val === 'object' && !Array.isArray(val)) {
                Object.keys(val).forEach(subK => {
                    if (Array.isArray(val[subK]) && window.esArrayDeJuegosIGDB(val[subK])) {
                        val[subK] = val[subK].filter(window.esJuegoValidoParaAppGlobal);
                    }
                });
            }
        });
    }
    return respuesta;
};

window.limpiarTarjetasBasuraEnDOM = function() {
    if (!window.juegosCargados || typeof window.juegosCargados !== 'object') return;

    Object.entries(window.juegosCargados).forEach(([id, juego]) => {
        if (!juego || typeof juego !== 'object') return;
        if (juego.desarrollador === undefined && juego.sinopsis === undefined && juego.summary === undefined && juego.generos === undefined) return;

        if (!window.esJuegoValidoParaAppGlobal(juego)) {
            const selectores = [
                `[onclick*="openGameDetail('${id}')"]`,
                `[onclick*="openGameDetail(${id})"]`,
                `[onclick*='openGameDetail("${id}")']`
            ].join(', ');

            document.querySelectorAll(selectores).forEach(el => {
                if (el.closest('#profilePanel, #miColeccionContainer, #detalleListaContenido')) return;
                el.style.setProperty('display', 'none', 'important');
            });

            delete window.juegosCargados[id];
        }
    });
};

(function interceptarGoogleScriptRunEnTodaLaApp() {
    const envolverRunner = (runnerObj) => {
        if (!runnerObj || runnerObj._interceptadoGlobal) return runnerObj;
        try {
            const origSuccess = runnerObj.withSuccessHandler;
            const origFailure = runnerObj.withFailureHandler;

            if (typeof origSuccess === 'function') {
                runnerObj.withSuccessHandler = function(cb) {
                    const cbLimpio = function(res) {
                        const limpio = window.limpiarRespuestaServidorIGDB(res);
                        const out = cb ? cb.call(this, limpio) : undefined;
                        setTimeout(window.limpiarTarjetasBasuraEnDOM, 60);
                        return out;
                    };
                    const nuevoRunner = origSuccess.call(this, cbLimpio);
                    return envolverRunner(nuevoRunner);
                };
            }

            if (typeof origFailure === 'function') {
                runnerObj.withFailureHandler = function(cbErr) {
                    const nuevoRunner = origFailure.call(this, cbErr);
                    return envolverRunner(nuevoRunner);
                };
            }
            runnerObj._interceptadoGlobal = true;
        } catch (e) {}
        return runnerObj;
    };

    if (window.google && window.google.script && window.google.script.run) {
        envolverRunner(window.google.script.run);
    }
    setTimeout(window.limpiarTarjetasBasuraEnDOM, 300);
    setTimeout(window.limpiarTarjetasBasuraEnDOM, 1200);
    setTimeout(window.limpiarTarjetasBasuraEnDOM, 2800);
})();


