window.filtrarColeccion = function(tipo, valor, elementoDiv) {
    // 1. GESTIÓN VISUAL Y DE TEXTOS EN LOS BOTONES
    if (tipo === 'todos' || tipo === 'favoritos') {
        window.filtrosActivosColeccion.pestana = tipo;
        window.filtrosActivosColeccion.plataforma = null;
        window.filtrosActivosColeccion.estado = null;
        window.filtrosActivosColeccion.genero = null;

        // Limpiamos los botones de los desplegables y restauramos sus textos originales
        document.querySelectorAll('.filtro-dropdown').forEach(drop => {
            const btn = drop.querySelector('.filtro-btn');
            if (btn) {
                btn.classList.remove('activo');
                if (drop.id === 'drop-plataforma') btn.innerHTML = '<span class="material-symbols-rounded">sports_esports</span> Plataformas <span class="material-symbols-rounded flecha-drop">expand_more</span>';
                if (drop.id === 'drop-estado') btn.innerHTML = '<span class="material-symbols-rounded">bookmark</span> Estados <span class="material-symbols-rounded flecha-drop">expand_more</span>';
                if (drop.id === 'drop-genero') btn.innerHTML = '<span class="material-symbols-rounded">category</span> Género <span class="material-symbols-rounded flecha-drop">expand_more</span>';
            }
        });

        // Activamos el botón principal (Todos/Favoritos)
        document.querySelectorAll('.filtros-container > .filtro-btn').forEach(b => b.classList.remove('activo'));
        if (elementoDiv) elementoDiv.classList.add('activo');
    } 
    else {
        window.filtrosActivosColeccion[tipo] = valor;

        if (elementoDiv) {
            const dropdown = elementoDiv.closest('.filtro-dropdown');
            if (dropdown) {
                const btnDropdown = dropdown.querySelector('.filtro-btn');
                if (btnDropdown) {
                    btnDropdown.classList.add('activo');
                    let icono = 'sports_esports';
                    if (tipo === 'estado') icono = 'bookmark';
                    if (tipo === 'genero') icono = 'category';

                    btnDropdown.innerHTML = `<span class="material-symbols-rounded">${icono}</span> ${valor} <span class="material-symbols-rounded flecha-drop">expand_more</span>`;
                }
                dropdown.classList.remove('open');
                const menu = dropdown.querySelector('.dropdown-menu');
                if (menu) menu.classList.remove('show');
            }
        }
    }

    // 2. MOTOR DE FILTRADO ACUMULATIVO
    const contenedor = document.getElementById('realCollection');
    if (!contenedor || !window.miColeccionActiva) return;

    contenedor.innerHTML = '';

    let juegosAMostrar = Object.values(window.miColeccionActiva);
    let esPestanaFavoritos = (window.filtrosActivosColeccion.pestana === 'favoritos');

    // --- PASO 3: FILTRO DE BÚSQUEDA POR TEXTO (LUPA) ---
    if (window.filtroBusquedaTexto) {
        const query = window.filtroBusquedaTexto;
        juegosAMostrar = juegosAMostrar.filter(juego => {
            const nombre = (juego.nombre || juego.title || '').toLowerCase();
            return nombre.includes(query);
        });
    }

    if (esPestanaFavoritos) {
        juegosAMostrar = juegosAMostrar.filter(juego => juego.favorito === true);
    }

    if (window.filtrosActivosColeccion.plataforma) {
        const valPlat = window.filtrosActivosColeccion.plataforma.toLowerCase();
        juegosAMostrar = juegosAMostrar.filter(juego => {
            const infoPlat = JSON.stringify(juego.plataformas || juego.plataforma || '').toLowerCase();
            return infoPlat.includes(valPlat);
        });
    }

    if (window.filtrosActivosColeccion.estado) {
        const valEst = window.filtrosActivosColeccion.estado.toUpperCase().trim();
        juegosAMostrar = juegosAMostrar.filter(juego => {
            const estadoActual = (juego.estado || '').toUpperCase().trim();
            return estadoActual === valEst;
        });
    }

    if (window.filtrosActivosColeccion.genero) {
        const valGen = window.filtrosActivosColeccion.genero.toLowerCase();
        juegosAMostrar = juegosAMostrar.filter(juego => {
            const infoGen = JSON.stringify(juego.generos || juego.genres || '').toLowerCase();
            return infoGen.includes(valGen);
        });
    }

    let htmlFinal = '';

    if (esPestanaFavoritos) {
        htmlFinal += `
        <div style="width: 100%; margin-bottom: 20px; padding-top: 5px;">
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; padding: 0 10px; max-width: 450px; margin: 0 auto;">`;
        
        const top3Array = window.misFavoritos || [null, null, null];
        for (let i = 0; i < 3; i++) {
            const gameId = top3Array[i];
            const juegoTop = (gameId && window.miColeccionActiva[gameId]) ? window.miColeccionActiva[gameId] : null;
            
            if (juegoTop) {
                const coverUrl = juegoTop.caratula ? `https://images.igdb.com/igdb/image/upload/t_cover_big/${juegoTop.caratula}.jpg` : 'https://via.placeholder.com/90x128';
                htmlFinal += `
                <div style="position: relative; border-radius: 8px; overflow: hidden; background: transparent;">
                    <img onclick="window.openGameDetail('${juegoTop.id}')" src="${coverUrl}" style="width: 100%; aspect-ratio: 3/4; object-fit: cover; cursor: pointer; display: block;">
                    <div onclick="window.abrirSelectorTop3(${i})" style="position: absolute; top: 6px; right: 6px; background: rgba(0,0,0,0.6); border-radius: 50%; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(4px); cursor: pointer; border: 1px solid rgba(255,255,255,0.2);">
                        <span class="material-symbols-rounded" style="color: white; font-size: 15px;">swap_horiz</span>
                    </div>
                    <div style="position: absolute; bottom: 0; left: 0; width: 100%; background: linear-gradient(to top, rgba(0,0,0,0.95), transparent); padding: 15px 5px 5px 5px; text-align: center; pointer-events: none;">
                        <span style="color: white; font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 0.75rem; text-shadow: 0 2px 4px black;">
                            <span class="material-symbols-rounded" style="font-size: 13px; vertical-align: -3px; color: #fbbf24; font-variation-settings: 'FILL' 1;">star</span> TOP ${i + 1}
                        </span>
                    </div>
                </div>`;
            } else {
                htmlFinal += `
                <div onclick="window.abrirSelectorTop3(${i})" style="aspect-ratio: 3/4; border-radius: 8px; border: 2px dashed rgba(255,255,255,0.25); display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(0,0,0,0.1); cursor: pointer;">
                    <span class="material-symbols-rounded" style="color: rgba(255,255,255,0.4); font-size: 28px; margin-bottom: 5px;">add_circle</span>
                    <span style="color: rgba(255,255,255,0.4); font-family: 'Outfit', sans-serif; font-size: 0.7rem; font-weight: 700;">TOP ${i + 1}</span>
                </div>`;
            }
        }
        
        htmlFinal += `
            </div>
        </div>
        <div style="font-family: 'Outfit', sans-serif; color: rgba(255,255,255,0.4); font-size: 0.7rem; text-align: center; letter-spacing: 1.5px; margin: 4px 0 6px 0; text-transform: uppercase;">Todos mis favoritos</div>`;
    }

    if (juegosAMostrar.length === 0) {
        contenedor.innerHTML = htmlFinal + '<div style="text-align: center; color: #888; padding: 40px; font-style: italic; font-size: 14px;">Ningún juego coincide con la búsqueda o filtros.</div>';
        return;
    }

    htmlFinal += '<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; padding: 5px 10px; width: 100%; box-sizing: border-box;">';
    
    juegosAMostrar.forEach(juego => {
        const coverUrl = juego.caratula ? `https://images.igdb.com/igdb/image/upload/t_cover_big/${juego.caratula}.jpg` : 'https://via.placeholder.com/90x128/f3f4f6/111111?text=Sin+Portada';
        const starIcon = juego.favorito ? `<span class="material-symbols-rounded" style="position: absolute; top: 5px; right: 5px; color: #fbbf24; font-size: 18px; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8)); font-variation-settings: 'FILL' 1;">star</span>` : '';
        
        htmlFinal += `
        <div onclick="window.openGameDetail('${juego.id}')" style="cursor: pointer; position: relative; border-radius: 8px; overflow: hidden; background: transparent;">
            <img src="${coverUrl}" style="width: 100%; aspect-ratio: 3/4; object-fit: cover; display: block; background: transparent;">
            ${starIcon}
        </div>`;
    });

    htmlFinal += '</div>';
    contenedor.innerHTML = htmlFinal;
};
window.marcarComoFavoritoDesdeFicha = function(gameId) {
    // 1. Verificamos que el juego esté en tu colección
    if (!window.miColeccionActiva || !window.miColeccionActiva[gameId]) {
        alert("Primero debes añadir el juego a tu colección para marcarlo como favorito.");
        return;
    }

    // Buscamos el icono de la estrella dentro del botón de la ficha y la palabra "FAVORITO"
    const btnIcon = document.querySelector('#btn-fav-ficha .material-symbols-rounded');
    const btnText = document.querySelector('#btn-fav-ficha span:nth-child(2)'); 
    
    if (!btnIcon) return;

    // 2. Averiguamos si ya era favorito y lo invertimos (Toggle)
    let esFavActualmente = window.miColeccionActiva[gameId].favorito === true;
    let nuevoEstadoFav = !esFavActualmente;

    // 3. Lo actualizamos en la memoria local al instante
    window.miColeccionActiva[gameId].favorito = nuevoEstadoFav;

    // ==========================================
    // 4. ANIMACIÓN Y CAMBIO VISUAL INMEDIATO
    // ==========================================
    
    // Primero, hacemos un pequeño 'zoom' para que se vea que lo has tocado
    btnIcon.style.transition = 'transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
    btnIcon.style.transform = 'scale(0.5)'; // Se encoge rápido

    setTimeout(() => {
        if (nuevoEstadoFav) {
            btnIcon.style.fontVariationSettings = "'FILL' 1"; // Rellena la estrella
            btnIcon.style.color = '#fbbf24'; 
            btnIcon.style.filter = 'drop-shadow(0 0 8px rgba(251, 191, 36, 0.6))';
            if(btnText) btnText.style.color = '#fbbf24';
        } else {
            btnIcon.style.fontVariationSettings = "'FILL' 0"; // Vacía la estrella
            btnIcon.style.color = '#fbbf24'; 
            btnIcon.style.filter = 'none'; 
            if(btnText) btnText.style.color = 'white';
        }
        
        btnIcon.style.transform = 'scale(1.2)';
        setTimeout(() => { btnIcon.style.transform = 'scale(1) translateY(-1px)'; }, 150);
    }, 100);

    // ==========================================
    // 5. GUARDAMOS EN FIREBASE Y REPINTAMOS PERFIL
    // ==========================================
    const usuarioActual = auth.currentUser;
    if (usuarioActual) {
        const juegoRef = doc(db, 'users', usuarioActual.uid, 'coleccion', gameId.toString());
        
        setDoc(juegoRef, { favorito: nuevoEstadoFav }, { merge: true })
            .then(() => {
                // AQUÍ ES DONDE SUCEDE LA MAGIA PARA EL PERFIL:
                // Llamamos a pintarColeccionPerfil para que el Top 3 (o la pestaña) se actualice en segundo plano
                if (typeof window.pintarColeccionPerfil === "function") {
                    window.pintarColeccionPerfil();
                }
            })
            .catch(error => console.error("Error al guardar favorito en Firebase:", error));
    }
};

window.abrirSelectorTop3 = function(index) {
    const juegosFavoritos = Object.values(window.miColeccionActiva || {}).filter(j => j.favorito === true);

    if (juegosFavoritos.length === 0) {
        alert("¡Primero debes marcar algunos juegos con la estrella de favorito en tu colección para poder añadirlos al Top 3.");
        return;
    }

    let modalOverlay = document.getElementById('modalSelectorTop3');
