window.confirmLogout = function() {
    // 1. Cerramos el popup rojito
    if(window.closeLogoutModal) window.closeLogoutModal();

    // 2. Ejecutamos el cierre de sesión en Firebase
    if (typeof firebase !== 'undefined' && firebase.auth) {
        firebase.auth().signOut()
            .then(() => {
                console.log("Sesión cerrada correctamente en Firebase.");
                // Gracias al bloque "Control Maestro" que tienes escuchando a Firebase,
                // al cerrarse la sesión, la app cambiará a la pantalla de inicio automáticamente.
            })
            .catch((error) => {
                showCustomAlert('Error', 'No se pudo cerrar sesión: ' + error.message);
            });
    }
};

