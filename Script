window.generarDescripcionBienvenidaComunidadIGDB = function(datos, juegoObj) {
    const titulo = (datos && datos.titulo) ? datos.titulo : 'este juego';

    const traducirGeneroNatural = function(genRaw) {
        if (!genRaw) return '';
        const mapaGen = {
            'adventure': 'aventura',
            'puzzle': 'puzles',
            'role-playing (rpg)': 'rol (RPG)',
            'rpg': 'rol (RPG)',
            'shooter': 'acción y disparos',
            'platform': 'plataformas',
            'hack and slash/beat \'em up': 'acción y hack and slash',
            'point-and-click': 'aventura gráfica point-and-click',
            'fighting': 'lucha',
            'strategy': 'estrategia',
            'simulator': 'simulación',
            'sport': 'deportes',
            'racing': 'carreras',
            'indie': 'indie',
            'arcade': 'arcade'
        };
        const partes = String(genRaw).split(',').map(function(p) {
            const k = p.trim().toLowerCase();
            return mapaGen[k] || p.trim();
        }).filter(Boolean);
        if (partes.length === 0) return '';
        if (partes.length === 1) return partes[0];
        return partes.slice(0, -1).join(', ') + ' y ' + partes[partes.length - 1];
    };

    const generoEsp = traducirGeneroNatural(datos && datos.genero);
    const fechaEsp = (datos && datos.fecha && !/cl[áa]sico|no especificado/i.test(datos.fecha)) ? datos.fecha : '';

    let datoJuego = '';
    if (generoEsp && fechaEsp) {
        datoJuego = 'Esta joya de ' + generoEsp + ' (' + fechaEsp + ') tiene aquí su punto de encuentro: ';
    } else if (generoEsp) {
        datoJuego = 'Este título de ' + generoEsp + ' tiene aquí su punto de encuentro: ';
    } else {
        datoJuego = 'Tu espacio para fans del juego: ';
    }

    return '👋 ¡Te damos la bienvenida a la comunidad de ' + titulo + '! ' +
           datoJuego + 'aquí podrás crear temas, hablar con otros jugadores, resolver dudas y compartir tus mejores momentos.';
};

