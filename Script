window.openGameDetail = function(id, estado = 'not_owned') {
    let game = window.juegosCargados[id];
    let esDeFirebase = false; // Bandera para saber de dónde viene
    
    if (!game) {
        if (window.miColeccionActiva && window.miColeccionActiva[id]) {
            game = window.miColeccionActiva[id]; 
            esDeFirebase = true;
        } else {
             console.error("❌ ERROR: El juego no existe.");
             return;
        }
    }
    
    
    // ==========================================
    // PARCHE V2: Adaptar datos de Firebase al Modal (CORREGIDO)
    // ==========================================
    if (esDeFirebase) {
        if (!game.name && game.nombre) game.name = game.nombre;
        if (!game.cover && game.caratula) game.cover = { image_id: game.caratula };

        if (game.plataformas && !game.platforms) game.platforms = game.plataformas.map(p => typeof p === 'string' ? {name: p} : p);
        if (game.generos && !game.genres) game.genres = game.generos.map(g => typeof g === 'string' ? {name: g} : g);
        if (game.empresas && !game.involved_companies) game.involved_companies = game.empresas.map(e => typeof e === 'string' ? { developer: true, company: { name: e } } : e);
        if (game.lanzamiento && !game.first_release_date) game.first_release_date = game.lanzamiento;

        // Reconstruimos la galería y los vídeos a partir de los textos de Firebase
        if (game.screenshots && Array.isArray(game.screenshots)) {
            game.screenshots = game.screenshots.map(s => typeof s === 'string' ? { image_id: s } : s);
        } else {
            game.screenshots = [];
        }

        if (game.videos && Array.isArray(game.videos)) {
            game.videos = game.videos.map(v => typeof v === 'string' ? { video_id: v } : v);
        } else {
            game.videos = [];
        }

        // EL SECRETO DEL FONDO PERFECTO:
        // Borramos cualquier rastro de "artworks" para evitar choques con IGDB
        game.artworks = []; 
        
        // Si tenemos un fondo guardado en Firebase, lo inyectamos a la fuerza
        // como una falsa "captura de pantalla" y como un "artwork" falso.
        // Así obligamos a las funciones de abajo a usar esta imagen y ninguna otra.
        if (game.fondo) {
            // Lo ponemos al principio de las capturas para que se vea en la galería
            const fondoExiste = game.screenshots.find(s => s.image_id === game.fondo);
            if (!fondoExiste) game.screenshots.unshift({ image_id: game.fondo });
            
            // Y creamos el artwork falso para que el fondo se pinte
            game.artworks = [{ image_id: game.fondo }];
        }
    }
    // ==========================================
    // FILTRO RETRO V3: Ejecutado DESPUÉS de Firebase para que no lo borre
    // ==========================================
    let releaseYear = 2026; 
    if (game.first_release_date) {
        let timestamp = game.first_release_date;
        if (String(timestamp).length <= 10) timestamp = timestamp * 1000;
        releaseYear = new Date(timestamp).getFullYear();
    } else if (game.lanzamiento) {
        let timestamp = game.lanzamiento;
        if (String(timestamp).length <= 10) timestamp = timestamp * 1000;
        releaseYear = new Date(timestamp).getFullYear();
    }

    if (releaseYear < 2017 && game.artworks && game.artworks.length > 0) {
        let artId = game.artworks[0].image_id;
        
        // Aplastamos lo que haya dejado Firebase o IGDB
        if (!game.screenshots) game.screenshots = [];
        
        // Filtramos para asegurarnos de no duplicar la imagen si abres y cierras
        game.screenshots = game.screenshots.filter(s => s.image_id !== artId);
        
        // ¡LA CLAVE! Usamos push() para poner el Artwork al FINAL de la lista,
        // que es justo donde tu aplicación va a ir a buscar el fondo.
        game.screenshots.push({ image_id: artId });
        
        // Actualizamos también la variable "fondo" por si la necesitas al guardar
        game.fondo = artId;
    }
    // ==========================================
    
    const modal = document.getElementById('gameDetailScreen');
    // Hacer el modal visible y ponerlo por encima de todo
    if (modal) {
