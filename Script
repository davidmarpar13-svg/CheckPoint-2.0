    clearTimeout(window._timerToastAvisoEstreno);
    window._timerToastAvisoEstreno = setTimeout(() => {
        toast.classList.remove('visible');
    }, 4800);
};

// Extrae la fecha de lanzamiento real sin confundirse con el icono de calendario
window.obtenerFechaLanzamientoFicha = function(detailScreen, juegoObj) {
    const posiblesIds = ['gdRelease', 'gdReleaseDate', 'gdDate', 'gameReleaseDate'];
    for (let i = 0; i < posiblesIds.length; i++) {
        const el = document.getElementById(posiblesIds[i]);
        if (el && el.textContent && el.textContent.trim()) {
            return el.textContent.trim();
        }
    }

    const nodos = Array.from(detailScreen.querySelectorAll('div, span, p'));
    for (let j = 0; j < nodos.length; j++) {
        const el = nodos[j];
        const txt = (el.textContent || '').replace(/calendar_today|event/gi, '').trim().toUpperCase();
        if (txt === 'LANZAMIENTO' && el.nextElementSibling) {
            const val = (el.nextElementSibling.textContent || '').trim();
            if (val && val.toUpperCase() !== 'LANZAMIENTO') return val;
        }
    }

    if (juegoObj) {
        if (juegoObj.first_release_date) {
            const ts = juegoObj.first_release_date < 10000000000 ? juegoObj.first_release_date * 1000 : juegoObj.first_release_date;
            return new Date(ts).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
        }
        const f = juegoObj.lanzamiento || juegoObj.fecha_lanzamiento || juegoObj.release_date || '';
        if (f && String(f).trim()) return String(f).trim();
    }
    return '';
};

// Convierte cualquier aviso guardado en un objeto compatible con openGameDetail y lo inyecta en window.juegosCargados
window.hidratarAvisoEnJuegosCargados = function(aviso) {
    if (!aviso || !aviso.id) return null;
    const idStr = String(aviso.id).trim();
    window.juegosCargados = window.juegosCargados || {};

    // Si ya existe en juegosCargados con todos sus datos de IGDB, lo respetamos
    const existente = window.juegosCargados[idStr];
    if (existente && (existente.summary || existente.sinopsis) && (existente.platforms || existente.plataformas)) {
        return existente;
    }

    const coverUrl = aviso.caratula && String(aviso.caratula).startsWith('http')
        ? aviso.caratula
        : (aviso.caratula ? ('https://images.igdb.com/igdb/image/upload/t_cover_big/' + aviso.caratula + '.jpg') : '');

    const matchHash = coverUrl.match(/\/([a-z0-9_]+)\.(jpg|png|webp)/i);
    const imageId = aviso.coverImageId || (matchHash ? matchHash[1] : '');

    const platStr = aviso.plataformas || 'Próximamente';
    const genStr = aviso.generos || 'Adventure';
    const devStr = aviso.desarrollador || 'Confirmado';
    const sinopsisStr = aviso.sinopsis || '';

    const objetoHidratado = Object.assign({}, existente || {}, {
        id: Number(idStr) || idStr,
        name: aviso.nombre || 'Juego',
        nombre: aviso.nombre || 'Juego',
        title: aviso.nombre || 'Juego',
        titulo: aviso.nombre || 'Juego',
        caratula: imageId || coverUrl,
        portada: coverUrl,
        coverUrl: coverUrl,
        cover: imageId ? { id: Number(idStr) || 1, image_id: imageId, url: coverUrl } : { url: coverUrl },
        first_release_date: aviso.first_release_date || (aviso.timestampEstreno ? Math.floor(aviso.timestampEstreno / 1000) : undefined),
        lanzamiento: aviso.lanzamiento || 'Próximamente',
        fecha_lanzamiento: aviso.lanzamiento || 'Próximamente',
        release_date: aviso.lanzamiento || 'Próximamente',
        plataformas: platStr,
        platforms: Array.isArray(aviso.platformsRaw) && aviso.platformsRaw.length > 0
            ? aviso.platformsRaw
            : platStr.split(',').map(function(s) { return { name: s.trim() }; }).filter(function(p) { return p.name; }),
        generos: genStr,
        genres: Array.isArray(aviso.genresRaw) && aviso.genresRaw.length > 0
            ? aviso.genresRaw
            : genStr.split(',').map(function(s) { return { name: s.trim() }; }).filter(function(g) { return g.name; }),
        desarrollador: devStr,
        developer: devStr,
        involved_companies: Array.isArray(aviso.companiesRaw) && aviso.companiesRaw.length > 0
            ? aviso.companiesRaw
            : [{ developer: true, company: { name: devStr } }],
        summary: sinopsisStr,
        sinopsis: sinopsisStr,
        descripcion: sinopsisStr,
        artworks: aviso.artworks || [],
        screenshots: aviso.screenshots || [],
        videos: aviso.videos || []
    });

    window.juegosCargados[idStr] = objetoHidratado;
    if (window.SagaApp && window.SagaApp.registroJuegosIGDB) {
        window.SagaApp.registroJuegosIGDB[idStr] = objetoHidratado;
    }
    return objetoHidratado;
};

window.hidratarTodosLosAvisosEnMemoria = function() {
    if (!window.misAvisosEstreno || typeof window.misAvisosEstreno !== 'object') return;
    Object.values(window.misAvisosEstreno).forEach(function(aviso) {
        window.hidratarAvisoEnJuegosCargados(aviso);
    });
};

// Abre un juego desde Avisos o Notificaciones asegurándose de que exista siempre en window.juegosCargados
window.abrirJuegoDesdeAviso = async function(idJuegoParam) {
    const idJuego = String(idJuegoParam || '').trim();
    if (!idJuego) return;

    window.cargarAvisosEstrenoGuardados();
    const aviso = window.misAvisosEstreno ? window.misAvisosEstreno[idJuego] : null;

    if (aviso) {
        window.hidratarAvisoEnJuegosCargados(aviso);
    }

    const juegoEnMemoria = window.juegosCargados ? window.juegosCargados[idJuego] : null;
    const faltaFichaCompleta = !juegoEnMemoria || !juegoEnMemoria.summary && !juegoEnMemoria.sinopsis;

    // Si es un aviso antiguo que se guardó sin sinopsis o sin desarrollador, lo pedimos a IGDB antes de abrir
    if (faltaFichaCompleta && aviso && aviso.nombre && window.SagaApp && typeof window.SagaApp.consultarIGDB === 'function') {
        try {
            const resultados = await window.SagaApp.consultarIGDB(aviso.nombre);
            const encontrado = (resultados || []).find(function(x) { return x && String(x.id) === idJuego; }) ||
                               (resultados || []).find(function(x) { return x && (x.name || x.nombre || '').toLowerCase() === aviso.nombre.toLowerCase(); }) ||
                               resultados[0];

            if (encontrado) {
                window.juegosCargados[idJuego] = encontrado;
                // Actualizamos el aviso con los datos completos para que ya queden guardados en Firebase
                aviso.plataformas = encontrado.plataformas || (Array.isArray(encontrado.platforms) ? encontrado.platforms.map(function(p) { return p.name || p; }).join(', ') : aviso.plataformas);
                aviso.generos = encontrado.generos || (Array.isArray(encontrado.genres) ? encontrado.genres.map(function(g) { return g.name || g; }).join(', ') : aviso.generos);
                aviso.desarrollador = encontrado.desarrollador || encontrado.developer ||
                    (Array.isArray(encontrado.involved_companies) ? encontrado.involved_companies.map(function(c) { return c && c.company && c.company.name; }).filter(Boolean).join(', ') : aviso.desarrollador);
                aviso.sinopsis = encontrado.sinopsis || encontrado.summary || encontrado.descripcion || aviso.sinopsis || '';
                aviso.first_release_date = encontrado.first_release_date || aviso.first_release_date;
                aviso.artworks = encontrado.artworks || [];
                aviso.screenshots = encontrado.screenshots || [];
                window.guardarAvisosEstreno();
            }
        } catch (e) {}
    }

    if (typeof window.openGameDetail === 'function') {
        window.openGameDetail(idJuego);
    }
};

window.toggleAvisoEstreno = function(idJuegoParam) {
    const idJuego = String(idJuegoParam || window.juegoActualEnFichaId || window.currentGameId || '').trim();
    if (!idJuego) return;

    window.cargarAvisosEstrenoGuardados();

    if (window.misAvisosEstreno[idJuego]) {
        delete window.misAvisosEstreno[idJuego];
        window.misNotificacionesGenerales = (window.misNotificacionesGenerales || []).filter(function(n) { return n && String(n.idJuego) !== idJuego; });
        window.guardarAvisosEstreno();
        window.guardarNotificacionesGenerales();

        window.mostrarToastAvisoEstreno("Aviso desactivado", "Hemos quitado la alerta de este juego.");
        window.prepararInterfazFichaSinBucle();
        window.actualizarCampanaYPanelNotificaciones();
        if (window.filtrosActivosColeccion && window.filtrosActivosColeccion.estado === 'avisos') {
            window.renderizarAvisosEnColeccionPerfil();
        }
        return;
    }

    const detailScreen = document.getElementById('gameDetailScreen') || document;
    const juegoObj = (window.juegosCargados && window.juegosCargados[idJuego]) ||
                     (window.SagaApp && window.SagaApp.registroJuegosIGDB[idJuego]) || {};

    const elTitulo = document.getElementById('gdTitle') || detailScreen.querySelector('h1, h2');
    const nombre = (elTitulo ? elTitulo.textContent : (juegoObj.nombre || juegoObj.name || 'Juego')).trim();

    const gdCover = document.getElementById('gdCover');
    const coverSrc = (gdCover && gdCover.src) ? gdCover.src : (window.SagaApp ? window.SagaApp.resolverUrlCaratula(juegoObj) : '');

    const fechaExtraida = window.obtenerFechaLanzamientoFicha(detailScreen, juegoObj);
    const fechaTexto = fechaExtraida || 'Próximamente';

    const tsEstreno = window.SagaApp
        ? window.SagaApp.obtenerTimestampLanzamiento(Object.assign({}, juegoObj, { lanzamiento: fechaTexto }))
        : null;

    // Extraemos también desarrollador, plataformas, géneros y sinopsis para que la ficha funcione siempre al abrirse desde Avisos
    const devFicha = (window.SagaApp && typeof window.SagaApp.obtenerDesarrolladorDeFicha === 'function')
        ? window.SagaApp.obtenerDesarrolladorDeFicha(detailScreen)
        : '';
    const descEl = document.getElementById('gdSynopsis') || document.getElementById('gdSummary') || document.getElementById('gdDescription');
    const sinopsisFicha = (descEl && descEl.textContent) ? descEl.textContent.trim() : (juegoObj.sinopsis || juegoObj.summary || juegoObj.descripcion || '');

    window.misAvisosEstreno[idJuego] = {
        id: idJuego,
        nombre: nombre,
        caratula: coverSrc,
        coverImageId: (juegoObj.cover && juegoObj.cover.image_id) ? juegoObj.cover.image_id : '',
        lanzamiento: fechaTexto,
        first_release_date: juegoObj.first_release_date || (tsEstreno ? Math.floor(tsEstreno / 1000) : null),
        timestampEstreno: tsEstreno,
        plataformas: juegoObj.plataformas || (Array.isArray(juegoObj.platforms) ? juegoObj.platforms.map(function(p) { return p.name || p; }).join(', ') : ''),
        platformsRaw: Array.isArray(juegoObj.platforms) ? juegoObj.platforms : [],
        generos: juegoObj.generos || (Array.isArray(juegoObj.genres) ? juegoObj.genres.map(function(g) { return g.name || g; }).join(', ') : ''),
        genresRaw: Array.isArray(juegoObj.genres) ? juegoObj.genres : [],
        desarrollador: devFicha || juegoObj.desarrollador || juegoObj.developer ||
            (Array.isArray(juegoObj.involved_companies) ? juegoObj.involved_companies.map(function(c) { return c && c.company && c.company.name; }).filter(Boolean).join(', ') : ''),
        companiesRaw: Array.isArray(juegoObj.involved_companies) ? juegoObj.involved_companies : [],
        sinopsis: sinopsisFicha,
        artworks: Array.isArray(juegoObj.artworks) ? juegoObj.artworks.slice(0, 3) : [],
        screenshots: Array.isArray(juegoObj.screenshots) ? juegoObj.screenshots.slice(0, 5) : [],
        estado: 'avisos',
        notificado3Dias: false,
        notificadoEstreno: false
    };

    window.hidratarAvisoEnJuegosCargados(window.misAvisosEstreno[idJuego]);
    window.guardarAvisosEstreno();

    const frase = window.FRASES_IRONICAS_AVISO_ESTRENO[window._idxFraseAvisoEstreno++ % window.FRASES_IRONICAS_AVISO_ESTRENO.length];
    const tituloToast = (fechaExtraida && fechaExtraida.toLowerCase() !== 'próximamente')
        ? ('Se te notificará el día del lanzamiento (' + fechaExtraida + ')')
        : 'Se te notificará el día del lanzamiento';

    window.mostrarToastAvisoEstreno(tituloToast, frase);

    window.prepararInterfazFichaSinBucle();
    window.verificarEstrenosCumplidosAlIniciar();
};

window.verificarEstrenosCumplidosAlIniciar = function() {
    window.cargarAvisosEstrenoGuardados();
    window.hidratarTodosLosAvisosEnMemoria();
    const ahora = Date.now();
    let huboCambios = false;

    Object.values(window.misAvisosEstreno).forEach(function(aviso) {
        if (!aviso || !aviso.timestampEstreno) return;
        const diasRestantes = Math.ceil((aviso.timestampEstreno - ahora) / (1000 * 60 * 60 * 24));

        if (diasRestantes <= 0 && !aviso.notificadoEstreno) {
            aviso.notificadoEstreno = true;
            huboCambios = true;
            window.crearNotificacionApp({
                id: 'estreno_hoy_' + aviso.id,
                tipo: 'estreno_hoy',
                titulo: '🎉 ¡Hoy se estrena ' + aviso.nombre + '!',
                mensaje: 'Ya está disponible. Toca para añadirlo a tu colección.',
                imagen: aviso.caratula,
                idJuego: aviso.id
            });
        } else if (diasRestantes >= 1 && diasRestantes <= 3 && !aviso.notificado3Dias) {
            aviso.notificado3Dias = true;
            huboCambios = true;
            const txtDias = diasRestantes === 1 ? 'Falta 1 día' : ('Faltan ' + diasRestantes + ' días');
            window.crearNotificacionApp({
                id: 'estreno_3dias_' + aviso.id,
                tipo: 'estreno_proximo',
                titulo: '⏳ ¡' + txtDias + ' para ' + aviso.nombre + '!',
                mensaje: 'Se estrena el ' + aviso.lanzamiento + '.',
                imagen: aviso.caratula,
                idJuego: aviso.id
            });
        }
    });

    if (huboCambios) window.guardarAvisosEstreno();
    window.actualizarCampanaYPanelNotificaciones();
};

window.actualizarCampanaYPanelNotificaciones = function() {
    window.cargarAvisosEstrenoGuardados();
    window.hidratarTodosLosAvisosEnMemoria();
    const listaNotifs = Array.isArray(window.misNotificacionesGenerales) ? window.misNotificacionesGenerales : [];

    const btnCampana = document.querySelector('#globalBottomNav button[onclick*="notificationsPanel"]');
    if (btnCampana) {
        let badge = btnCampana.querySelector('.badge-campana-notif');
        if (!badge) {
            badge = document.createElement('span');
            badge.className = 'badge-campana-notif';
            btnCampana.appendChild(badge);
        }
        const noLeidas = listaNotifs.filter(function(n) { return n && !n.leida; }).length;
        if (noLeidas > 0) {
            badge.textContent = noLeidas;
            badge.classList.add('activo');
        } else {
            badge.classList.remove('activo');
        }
    }

    let panel = document.getElementById('notificationsPanel');
    if (!panel) {
        panel = document.createElement('div');
        panel.id = 'notificationsPanel';
