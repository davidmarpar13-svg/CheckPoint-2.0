window.filtrarCalendarioAvanzado = async function(tipo) {
    try {
        const btnTodos = document.getElementById('btnMesTodos');
        const inputMes = document.getElementById('filtroMesSelect');
        const inputDia = document.getElementById('filtroDiaSelect');
        const selectPlataforma = document.getElementById('filtroPlataforma');
        const selectGenero = document.getElementById('filtroGenero');
        
        const grid = document.getElementById('gridVerTodoProximos'); 
        if (!grid) return; 
        
        grid.innerHTML = '<div style="grid-column: span 3; text-align:center; color:#888; padding: 30px 0;">Cargando catálogo filtrado...</div>';

        // Lógica visual de los botones
        if (tipo === 'todos') {
            if(btnTodos) btnTodos.classList.add('active');
            if(inputMes) inputMes.value = "";
            if(inputDia) inputDia.value = "";
            if(selectPlataforma) selectPlataforma.value = "";
            if(selectGenero) selectGenero.value = "";
        } else {
            if(btnTodos) btnTodos.classList.remove('active');
            if(tipo === 'mes' && inputDia) inputDia.value = "";
            if(tipo === 'dia' && inputMes) inputMes.value = "";
        }

        let mesParam = "";
        let anioParam = "";

        if (inputMes && inputMes.value) {
            const partes = inputMes.value.split('-');
            anioParam = partes[0];
            mesParam = partes[1];
        } else if (inputDia && inputDia.value) {
            const partes = inputDia.value.split('-');
            anioParam = partes[0];
            mesParam = partes[1];
        }

        // 1. CAPTURAR VALORES DE LOS NUEVOS FILTROS
        let plataformaVal = selectPlataforma ? selectPlataforma.value : "";
        let generoVal = selectGenero ? selectGenero.value : "";

        // 2. AÑADIRLOS A LA URL DE GOOGLE APPS SCRIPT
        const separador = APPS_SCRIPT_URL.includes('?') ? '&' : '?';
        let urlFinal = `${APPS_SCRIPT_URL}${separador}action=upcoming`;
        
        if (mesParam && anioParam) {
            urlFinal += `&mes=${mesParam}&anio=${anioParam}`;
        }
        if (plataformaVal) urlFinal += `&plataforma=${plataformaVal}`;
        if (generoVal) urlFinal += `&genero=${generoVal}`;
        
        urlFinal += `&t=${Date.now()}`; 

        const respuesta = await fetch(urlFinal);
        const json = await respuesta.json();
        
        let juegosFiltrados = Array.isArray(json) ? json : (json.data || []);
        
        // Filtrar día exacto en el frontend
        if ((tipo === 'dia' || inputDia.value) && inputDia && inputDia.value) {
             const partes = inputDia.value.split('-');
             const diaBuscado = parseInt(partes[2], 10);
             const mesBuscado = parseInt(partes[1], 10) - 1; 
             const anioBuscado = parseInt(partes[0], 10);
             
             juegosFiltrados = juegosFiltrados.filter(juego => {
                 if(!juego.first_release_date) return false;
                 const fecha = new Date(juego.first_release_date * 1000);
                 return fecha.getDate() === diaBuscado && fecha.getMonth() === mesBuscado && fecha.getFullYear() === anioBuscado;
             });
        }

        // 3. PINTAR RESULTADOS
        if (juegosFiltrados.length === 0) {
            grid.innerHTML = '<div style="grid-column: span 3; text-align:center; color:#888; padding: 30px 0;">No se encontraron juegos con estos filtros.</div>';
            return;
        }

        let html = "";
        juegosFiltrados.forEach((juego, index) => {
            
            // ¡MAGIA SIMPLE! Guardamos el juego TAL CUAL viene del servidor
            if(!window.juegosCargados) window.juegosCargados = {};
            window.juegosCargados[juego.id] = juego;

            const caratulaUrl = juego.cover && juego.cover.image_id ? `https://images.igdb.com/igdb/image/upload/t_cover_big/${juego.cover.image_id}.jpg` : 'https://via.placeholder.com/90x120';
            const fechaObj = new Date(juego.first_release_date * 1000);
            const fechaStr = fechaObj.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
            const safeTitle = juego.name ? juego.name.replace(/'/g, "\\'").replace(/"/g, '&quot;') : "Juego";

            html += `
                <div class="animate-fade-up" style="cursor: pointer; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; animation-delay: ${(index % 10) * 0.05}s;" onclick="if(window.cerrarCalendarioProximos) window.cerrarCalendarioProximos(); if(window.openGameDetail) window.openGameDetail('${juego.id}')">
                    <img src="${caratulaUrl}" style="width: 100%; aspect-ratio: 3/4; object-fit: cover; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
                    <span style="font-family: 'Outfit', sans-serif; font-size: 0.75rem; font-weight: 700; color: #222; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.2;">${safeTitle}</span>
                    <span style="font-family: 'Outfit', sans-serif; font-size: 0.7rem; color: #be185d; font-weight: 700; background: #fce7f3; padding: 2px 6px; border-radius: 8px;">🗓 ${fechaStr}</span>
                </div>
            `;
        });
        
        grid.innerHTML = html;

    } catch (error) {
        console.error("Error al filtrar:", error);
        const gridError = document.getElementById('gridVerTodoProximos');
        if (gridError) gridError.innerHTML = '<div style="grid-column: span 3; text-align:center; color:red; padding: 30px 0;">Error de conexión con IGDB.</div>';
    }
};
// 3. CARGAR "PARA TI" (Genera recomendaciones personalizadas por Plataforma + Colección + Favoritos)
window.cargarParaTi = async function(forzarRecarga = false) {
    window.asegurarBarrasFiltrosExplorar();
    if (window.isFetchingExplore && !forzarRecarga) return;

    const contenedor = document.getElementById('exploreForYouGrid');
    const loading = document.getElementById('exploreLoadingMore');
    if (!contenedor || !loading) return;

    const platSeleccionada = window.plataformaActivaParaTi || 'Todos';
    const miRequestId = ++window._paraTiRequestId;

    if (forzarRecarga) {
        window.exploreRecOffset = 0;
        window.idsMostradosParaTi = new Set();
        contenedor.innerHTML = "";
    }

    if (window.exploreRecOffset === 0) {
        window.idsMostradosParaTi = new Set();
        loading.style.display = 'none';
        const fraseParaTi = (window.FRASES_CARGA_PARA_TI && window.FRASES_CARGA_PARA_TI.length)
            ? window.FRASES_CARGA_PARA_TI[window._idxFraseParaTi++ % window.FRASES_CARGA_PARA_TI.length]
            : 'Analizando tus gustos...';
        contenedor.innerHTML = `<div class="texto-carga-explorar">${fraseParaTi}</div>`;
        await new Promise(resolve => setTimeout(resolve, forzarRecarga ? 450 : 1200));
        if (miRequestId !== window._paraTiRequestId) return;
    } else {
        loading.style.display = 'block';
    }

    window.isFetchingExplore = true;

    try {
        const separador = APPS_SCRIPT_URL.includes('?') ? '&' : '?';

        let favIds = [];
        if (window.misFavoritos && window.misFavoritos.length > 0) {
            favIds = window.misFavoritos.filter(id => id && id !== "null" && id !== "undefined");
        }

        let colIds = [];
        if (window.miColeccionActiva) {
            const todosIds = Object.keys(window.miColeccionActiva).filter(id => id && id !== "null" && id !== "undefined");
            // Si el usuario ha elegido una consola en "Para Ti", priorizamos tomar como semilla los juegos de su colección de esa consola
            let idsCandidatos = todosIds;
            if (platSeleccionada !== 'Todos') {
                const idsDeEstaConsola = todosIds.filter(id => window.juegoCumpleFiltroPlataforma(window.miColeccionActiva[id], platSeleccionada));
                if (idsDeEstaConsola.length > 0) {
                    idsCandidatos = idsDeEstaConsola;
                }
                const favsDeEstaConsola = favIds.filter(id => window.miColeccionActiva[id] && window.juegoCumpleFiltroPlataforma(window.miColeccionActiva[id], platSeleccionada));
                if (favsDeEstaConsola.length > 0) {
                    favIds = favsDeEstaConsola;
                }
            }
            const restoIds = idsCandidatos.filter(id => !favIds.includes(id));
            colIds = restoIds.sort(() => 0.5 - Math.random()).slice(0, 5);
        }

        let juegosParaMostrar = [];
        let intentos = 0;
        const maxIntentos = platSeleccionada === 'Todos' ? 1 : 3;
        const minimoJuegosPorLote = platSeleccionada === 'Todos' ? 1 : 9;

        // Si filtramos por plataforma, pedimos hasta reunir un bloque completo de juegos de esa consola
        while (juegosParaMostrar.length < minimoJuegosPorLote && intentos < maxIntentos) {
            let urlFinal = "";
            if ((favIds.length > 0 || colIds.length > 0) && intentos < 2) {
                urlFinal = `${APPS_SCRIPT_URL}${separador}action=recommended&favs=${favIds.join(',')}&col=${colIds.join(',')}&offset=${window.exploreRecOffset}`;
            } else {
                urlFinal = `${APPS_SCRIPT_URL}${separador}action=popular&offset=${window.exploreRecOffset}`;
            }

            const respuesta = await fetch(urlFinal);
            const json = await respuesta.json();
            if (miRequestId !== window._paraTiRequestId) return;

            const lote = Array.isArray(json) ? json : (json?.data || []);
            window.exploreRecOffset += 18;
            intentos++;

            if (lote.length === 0) break;

            lote.forEach(juego => {
                if (!juego || !juego.id) return;
                const idStr = String(juego.id);
                if (window.idsMostradosParaTi.has(idStr)) return;

                if (platSeleccionada === 'Todos' || window.juegoCumpleFiltroPlataforma(juego, platSeleccionada)) {
                    window.idsMostradosParaTi.add(idStr);
                    juegosParaMostrar.push(juego);
                }
            });
        }

        if (miRequestId !== window._paraTiRequestId) return;

        if (juegosParaMostrar.length === 0 && contenedor.querySelectorAll('[onclick*="openGameDetail"]').length === 0) {
            contenedor.innerHTML = `<div class="texto-carga-explorar">No hemos encontrado más recomendaciones de ${platSeleccionada} por ahora.</div>`;
            loading.style.display = 'none';
            window.isFetchingExplore = false;
            return;
        }

        let html = "";
        juegosParaMostrar.forEach((juego) => {
            if (!window.juegosCargados) window.juegosCargados = {};
            window.juegosCargados[juego.id] = juego;

            const coverId = (juego.cover && juego.cover.image_id) ? juego.cover.image_id : 'null';
            const caratulaUrl = coverId !== 'null'
                ? `https://images.igdb.com/igdb/image/upload/t_cover_big/${coverId}.jpg`
                : 'https://via.placeholder.com/264x352';
            const tituloLimpio = juego.name ? juego.name.replace(/"/g, '&quot;') : 'Juego';

            html += `
