window.actualizarContadoresPerfil = function() {
    if (!window.miColeccionActiva) return;

    const juegos = Object.values(window.miColeccionActiva);

    // 1. Actualizar el número total de la Colección
    const statColeccion = document.getElementById('statCollection');
    if (statColeccion) {
        statColeccion.textContent = juegos.length;
    }

    // 2. Calcular y actualizar el número de Reseñas
    const totalResenas = juegos.filter(juego => {
        const tieneNota = (juego.puntuacion && Number(juego.puntuacion) > 0);
        const tieneTexto = (juego.reseña && typeof juego.reseña === 'string' && juego.reseña.trim() !== "");
        return tieneNota || tieneTexto; // Cuenta como reseña si tiene nota o texto
    }).length;

    const statReviews = document.getElementById('statReviews');
    if (statReviews) {
        statReviews.textContent = totalResenas;
    }

    // 3. Actualizar dinámicamente tu Tarjeta de Jugador
    const pcReviewFilled = document.getElementById('pcReviewFilled');
    const pcReviewEmpty = document.getElementById('pcReviewEmpty');
    if (pcReviewFilled && pcReviewEmpty) {
        pcReviewFilled.style.display = totalResenas > 0 ? 'block' : 'none';
        pcReviewEmpty.style.display = totalResenas > 0 ? 'none' : 'block';
    }
};

