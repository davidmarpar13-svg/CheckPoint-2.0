// Menú de 3 puntitos del tema:
// - Si el tema ES TUYO: NO sale "Seguir tema"; salen Compartir, Ir a la comunidad, Ir al juego y Borrar tema.
// - Si el tema NO ES TUYO: Sale Seguir tema / Siguiendo tema, Compartir, Ir a la comunidad e Ir al juego.
window.enriquecerMenuTresPuntosDelTema = function() {
    const menus = Array.from(document.querySelectorAll('.dropdown-opciones-tema')).filter(function(m) {
        return m.id !== 'dropdownOpcionesListaActiva' && m.id !== 'dropdownTresPuntosMiResenaPropia' && m.id !== 'dropdownTresPuntosResenaModal';
    });
    const tema = window.obtenerTemaAbiertoActualmente();
    const esMio = window.esTemaDelUsuarioActivo(tema);
    const usuario = window.ComunidadApp ? window.ComunidadApp.obtenerUsuarioActivo() : { uid: 'anon', nombre: 'David' };
    const segs = (tema && Array.isArray(tema.seguidores)) ? tema.seguidores : [];
    const siguiendo = Boolean((usuario.uid && segs.indexOf(usuario.uid) !== -1) || (usuario.nombre && segs.indexOf(usuario.nombre.toLowerCase()) !== -1));

    menus.forEach(function(menu) {
        // Eliminamos cualquier botón de "Seguir tema" si el tema es tuyo
        Array.from(menu.querySelectorAll('button')).forEach(function(b) {
            const txtB = (b.textContent || '').trim().toLowerCase();
            if (esMio && (txtB.indexOf('seguir tema') !== -1 || txtB.indexOf('siguiendo tema') !== -1 || b.classList.contains('btn-extra-seguir-tema'))) {
                b.remove();
            }
            if (!esMio && b.classList.contains('borrar')) {
                b.remove();
            }
        });

        if (!esMio) {
            let btnSegExistente = menu.querySelector('.btn-extra-seguir-tema');
            if (!btnSegExistente) {
                btnSegExistente = document.createElement('button');
                btnSegExistente.type = 'button';
                btnSegExistente.className = 'item-opcion-tema btn-extra-seguir-tema';
                btnSegExistente.onclick = function(ev) { window.toggleSeguirTemaActualDirecto(ev); };
                menu.insertBefore(btnSegExistente, menu.firstChild);
            }
            btnSegExistente.innerHTML =
                '<span class="material-symbols-rounded" style="font-size: 18px; color: #f59e0b;">' + (siguiendo ? 'notifications_active' : 'notifications_none') + '</span>' +
                '<span>' + (siguiendo ? 'Siguiendo tema' : 'Seguir tema') + '</span>';
        }

        if (menu.querySelector('.btn-extra-ir-comunidad')) return;

        const btnCompartir = document.createElement('button');
        btnCompartir.type = 'button';
        btnCompartir.className = 'item-opcion-tema btn-extra-compartir-tema';
        btnCompartir.onclick = function(ev) { window.compartirTemaDesdeMenu(ev); };
        btnCompartir.innerHTML = '<span class="material-symbols-rounded" style="font-size: 18px; color: #2563eb;">share</span><span>Compartir</span>';

        const btnCom = document.createElement('button');
        btnCom.type = 'button';
        btnCom.className = 'item-opcion-tema btn-extra-ir-comunidad';
        btnCom.onclick = function(ev) { window.irAComunidadDesdeMenuTema(ev); };
        btnCom.innerHTML = '<span class="material-symbols-rounded" style="font-size: 18px; color: #ec4899;">forum</span><span>Ir a la comunidad</span>';

        const btnJuego = document.createElement('button');
        btnJuego.type = 'button';
        btnJuego.className = 'item-opcion-tema btn-extra-ir-juego';
        btnJuego.onclick = function(ev) { window.irAlJuegoDesdeMenuTema(ev); };
        btnJuego.innerHTML = '<span class="material-symbols-rounded" style="font-size: 18px; color: #10b981;">sports_esports</span><span>Ir al juego</span>';

        const btnBorrarExistente = menu.querySelector('.borrar');
        if (btnBorrarExistente) {
            menu.insertBefore(btnCompartir, btnBorrarExistente);
            menu.insertBefore(btnCom, btnBorrarExistente);
            menu.insertBefore(btnJuego, btnBorrarExistente);
        } else {
            menu.appendChild(btnCompartir);
            menu.appendChild(btnCom);
            menu.appendChild(btnJuego);
        }
    });
};

window.abrirTemaDesdePerfil = async function(idJuego, idTema) {
    if (!window.ComunidadApp) return;
    let idJ = String(idJuego || '').trim();
    let idT = String(idTema || '').trim();

    const todos = window.obtenerTodosLosTemasConNombreDeJuego('todos');
    if ((!idJ || !idT) && todos.length > 0) {
        const enc = todos.find(function(t) { return t && (String(t.id) === idT || String(t.idJuego) === idJ); }) || todos[0];
        if (enc) {
            if (!idJ) idJ = String(enc.idJuego || '');
            if (!idT) idT = String(enc.id || '');
        }
    }

    window._temaAbiertoDirectoDesdePerfil = true;
    window._idJuegoTemaActual = idJ;
    window._idTemaAbiertoActual = idT;

    document.body.classList.add('abriendo-tema-desde-perfil');

    const overlayCom = document.getElementById('comunidadJuegoOverlay');
    if (overlayCom) {
        overlayCom.classList.remove('comunidad-oculta-desde-perfil', 'modo-oculto-perfil');
        overlayCom.style.display = 'flex';
    }

    try {
        await window.ComunidadApp.abrir(idJ);
    } catch (err) {}

    if (typeof window.ComunidadApp.abrirHilo === 'function') {
        window.ComunidadApp.abrirHilo(idT);
    } else if (overlayCom) {
        const card = Array.from(overlayCom.querySelectorAll('.tema-foro-card, [onclick]')).find(function(c) {
            return idT && (c.getAttribute('onclick') || '').indexOf(idT) !== -1;
        }) || overlayCom.querySelector('.tema-foro-card');
        if (card) card.click();
    }

    const overlayDet = document.getElementById('vistaDetalleTemaOverlay');
    if (overlayDet) overlayDet.style.display = 'flex';

    setTimeout(function() {
        if (typeof window.asegurarBotonSeguirTemaVisibleEnHilo === 'function') window.asegurarBotonSeguirTemaVisibleEnHilo(true);
        if (typeof window.enriquecerMenuTresPuntosDelTema === 'function') window.enriquecerMenuTresPuntosDelTema();
    }, 30);
};

