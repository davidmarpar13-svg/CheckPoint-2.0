            'no\\s+oficial|unofficial|bootleg|fangames|rpg\\s*maker|mugen|openbor|zelda\\s+classic|solarus|ags|adventure\\s+game\\s+studio)\\b',
            'i'
        );

        const tieneNumeroDecimalFan = /\b[1-9]\.5\b/.test(nombre) && !/kingdom hearts/i.test(nombre);
        const esFanGame = !superaCalidadGlobal || regexFanGame.test(desc) || regexFanGame.test(nombre) || tieneNumeroDecimalFan || /\b(alter|revamp|redux|recomp|snes port|nes port)\b/i.test(nombre);

        // C) Detector de viñetas de contenido extra / galerías
        const tieneVinetasDeContenidoExtra = /[・•●▪■◆★※]/.test(desc) ||
            /\b(galer[ií]a\s+digital|sonido\s+y\s+arte|galer[ií]a\s+de\s+arte|galer[ií]a\s+de\s+sonido|sound\s+and\s+art|digital\s+gallery|reproductor\s+de\s+m[uú]sica|music\s+player|libro\s+de\s+arte\s+digital|digital\s+artbook|modo\s+museo|museum\s+mode|estados\s+de\s+guardado|save\s+states|funci[oó]n\s+de\s+rebobinado|rewind\s+feature|filtros\s+crt)\b/i.test(desc);

        // D) Detector de PORTS / REMASTERS / RECOPILATORIOS / EDICIONES
        const regexPortORemasterEnDescripcion = new RegExp(
            '\\b(ha\\s+sido\\s+remasterizado|remasterizado\\s+para|versi[oó]n\\s+remasterizada|remastered\\s+version|hd\\s+remaster|remasterizaci[oó]n|special\\s+edition|edici[oó]n\\s+especial|devil\\s+hunter\\s+bundle|deluxe\\s+edition|' +
            'jugable\\s+en\\s+pc\\s+modernas|pc\\s+modernas|sistemas\\s+modernos|capcom\\s+y\\s+gog|\\bgog\\b|gog\\.com|' +
