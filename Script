        const tieneSinopsis = Boolean(j.summary || j.sinopsis || j.descripcion);
        return Boolean(j._esIGDBCompleto || tienePlataformas || tieneGenerosODev || tieneSinopsis);
    },

    normalizarObjetoIGDB: function(j) {
        if (!j || typeof j !== 'object') return j;

        const titulo = String(j.name || j.nombre || j.titulo || j.title || '').trim();
        if (titulo) {
            j.name = j.name || titulo;
            j.title = j.title || titulo;
            j.nombre = j.nombre || titulo;
            j.titulo = j.titulo || titulo;
        }

        const coverUrl = this.resolverUrlCaratula(j);
        if (coverUrl) {
            const matchHash = coverUrl.match(/\/([a-z0-9_]+)\.(jpg|png|webp)/i);
            const hash = matchHash ? matchHash[1] : '';
            if (!j.caratula && hash) j.caratula = hash;
            j.portada = j.portada || coverUrl;
            j.imagen = j.imagen || coverUrl;
            j.coverUrl = j.coverUrl || coverUrl;
            if (!j.cover || typeof j.cover === 'string') {
                j.cover = { image_id: hash, url: coverUrl };
            }
        }

        j._esIGDBCompleto = true;
        return j;
    },

