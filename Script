window.registrarNotificacionDirectaEnMiPanel = function(notifData) {
    if (!notifData || !notifData.id) return;
    const esLista = /lista/i.test(notifData.tipo || notifData.titulo || '');
    if (!esLista && !notifData.imagen) {
        notifData.imagen = window.obtenerPortadaJuegoPorIdOTitulo(notifData.idJuego, notifData.mensaje || notifData.titulo);
        notifData.cover = notifData.imagen;
    }
    if (typeof window.crearNotificacionApp === 'function') {
        try { window.crearNotificacionApp(notifData); } catch (e) {}
    }
    try {
        const key = 'checkpoint_notificaciones_app_v1';
        let lista = JSON.parse(localStorage.getItem(key) || '[]') || [];
        const idxPrev = lista.findIndex(function(n) { return n && n.id === notifData.id; });
        if (idxPrev !== -1) lista.splice(idxPrev, 1);
        lista.unshift(Object.assign({ fecha: Date.now(), leida: false }, notifData));
        window.misNotificacionesApp = lista;
        localStorage.setItem(key, JSON.stringify(lista));
    } catch (e) {}
    if (typeof window.renderizarPanelNotificaciones === 'function') {
        try { window.renderizarPanelNotificaciones(); } catch (e) {}
    }
    window.asegurarRenderizadoNotificacionesEnDOM();
    setTimeout(window.reemplazarCorazonPorPortadaEnNotificacionesDOM, 30);
};

window.eliminarNotificacionDirectaDeMiPanel = function(idNotif) {
    if (!idNotif) return;
    try {
        const key = 'checkpoint_notificaciones_app_v1';
        let lista = JSON.parse(localStorage.getItem(key) || '[]') || [];
        lista = lista.filter(function(n) { return n && n.id !== idNotif; });
        window.misNotificacionesApp = lista;
        localStorage.setItem(key, JSON.stringify(lista));
    } catch (e) {}
    const cardDom = document.querySelector('[data-notif-id="' + idNotif + '"]');
    if (cardDom) cardDom.remove();
};

window.toggleLikeLista = function(idLista, tituloLista) {
    if (!idLista) return;
    window.cargarListasSeguidasYLikes();
    const usuario = window.ComunidadApp ? window.ComunidadApp.obtenerUsuarioActivo() : { uid: 'anon', nombre: 'David' };

    if (!window.likesDeListas[idLista]) window.likesDeListas[idLista] = { count: 0, users: [] };
    const registro = window.likesDeListas[idLista];
    registro.users = Array.isArray(registro.users) ? registro.users : [];

    const idx = registro.users.indexOf(usuario.uid);
    let dioLikeAhora = false;
    if (idx === -1) {
        registro.users.push(usuario.uid);
        registro.count = registro.users.length;
        dioLikeAhora = true;
    } else {
        registro.users.splice(idx, 1);
        registro.count = Math.max(0, registro.users.length);
    }

    window.guardarListasSeguidasYLikes();
    window.aplicarFiltroYVistaListasPerfil();

    const btnLikeModal = document.getElementById('btnLikeDetalleListaActiva');
    if (btnLikeModal) {
        const activo = registro.users.indexOf(usuario.uid) !== -1;
        btnLikeModal.classList.toggle('liked', activo);
        btnLikeModal.innerHTML = '<span class="material-symbols-rounded" style="font-size: 18px;">' + (activo ? 'favorite' : 'favorite_border') + '</span> <span>' + registro.count + '</span>';
    }

    const idNotifLista = 'notif_like_lista_' + idLista;
    if (dioLikeAhora) {
        window.registrarNotificacionDirectaEnMiPanel({
            id: idNotifLista,
            tipo: 'like_lista',
            titulo: '❤️ Nuevo Me gusta en tu lista',
            mensaje: 'A alguien le ha gustado tu lista "' + (tituloLista || 'Mis juegos') + '".',
            tituloLista: tituloLista || '',
            idLista: idLista,
            imagen: '',
            cover: '',
            icono: 'format_list_bulleted',
            colorIcono: '#f59e0b',
            leida: false
        });
    } else {
        window.eliminarNotificacionDirectaDeMiPanel(idNotifLista);
    }
};

