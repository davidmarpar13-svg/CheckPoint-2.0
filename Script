// 5. Media de la Comunidad (Diseño corregido sin estrellas extra)
window.calcularMediaComunidad = async function(gameId) {
    const ratingContainer = document.getElementById('gdCommunityRating');
    if (!ratingContainer) return;
    
    // Texto mientras carga
    ratingContainer.innerHTML = `Calculando...`;
    
    try {
        const usuariosSnap = await getDocs(collection(db, 'users'));
        let totalPuntuacion = 0;
        let totalVotos = 0;
        
        for (const usuarioDoc of usuariosSnap.docs) {
            // Buscamos si este usuario tiene este juego en su colección
            const juegoRef = doc(db, 'users', usuarioDoc.id, 'coleccion', gameId.toString());
            const juegoSnap = await getDoc(juegoRef);
            
            if (juegoSnap.exists()) {
                const datos = juegoSnap.data();
                // Si el juego existe y tiene una nota mayor que 0, la sumamos
                if (datos.puntuacion && Number(datos.puntuacion) > 0) {
                    totalPuntuacion += Number(datos.puntuacion);
                    totalVotos++;
                }
            }
        }
        
        // El SVG de tu estrella para cuando HAYA votos
        const estrellaAmarilla = `<svg width="16" height="16" viewBox="0 0 24 24" fill="#f1c40f" stroke="#f1c40f" stroke-width="2" style="margin-right: 5px; vertical-align: middle;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>`;

        if (totalVotos > 0) {
            const notaMedia = (totalPuntuacion / totalVotos).toFixed(1);
            const textoVotos = totalVotos === 1 ? 'VOTO' : 'VOTOS';
            
            ratingContainer.innerHTML = `
                <div style="display: inline-flex; align-items: center; color: #ffd700; font-weight: bold; text-shadow: 0 0 5px rgba(255,215,0,0.5);">
                    ${estrellaAmarilla}
                    ${notaMedia}
                </div> 
                <span style="opacity: 0.5; margin-left: 5px; margin-right: 5px; color: white;">|</span> 
                <span style="color: white; font-weight: 700;">${totalVotos} ${textoVotos}</span>
            `;
        } else {
            // Diseño limpio sin estrella si no hay votos
            ratingContainer.innerHTML = `0 VOTOS`;
        }
        
    } catch (error) {
        console.error("Error al calcular media:", error);
        ratingContainer.innerHTML = `0 VOTOS`;
    }
};

