    cargarTemasDelJuego: async function(idJuego) {
        const contenedor = document.getElementById('listaTemasComunidad');
        if (contenedor) {
            contenedor.innerHTML = '<div class="texto-carga-explorar">Cargando temas de la comunidad...</div>';
        }

        const claveLocal = 'checkpoint_comunidad_temas_' + idJuego;
        let listaLocal = [];
        try {
            const raw = localStorage.getItem(claveLocal);
            if (raw) listaLocal = JSON.parse(raw) || [];
        } catch (e) {}

        let listaRemota = [];
        try {
            if (typeof db !== 'undefined' && typeof doc !== 'undefined' && typeof getDoc !== 'undefined') {
                const docRef = doc(db, 'comunidades_juegos', String(idJuego));
                const snap = await getDoc(docRef);
                if (snap && snap.exists()) {
                    const data = snap.data() || {};
                    if (Array.isArray(data.temas)) {
                        listaRemota = data.temas;
                        // Si en Firebase ya se borró algún tema, respetamos la lista remota actualizada
                        this.temasActuales = listaRemota.sort(function(a, b) { return (b.fecha || 0) - (a.fecha || 0); });
                        try {
                            localStorage.setItem(claveLocal, JSON.stringify(this.temasActuales));
                        } catch (err) {}
                        this.renderizarListaTemas();
                        window.sincronizarNotificacionesDeComunidad();
                        return;
                    }
                }
            }
        } catch (e) {}

        const mapa = new Map();
        listaLocal.concat(listaRemota).forEach(function(t) {
            if (t && t.id) mapa.set(t.id, t);
        });

        this.temasActuales = Array.from(mapa.values()).sort(function(a, b) { return (b.fecha || 0) - (a.fecha || 0); });
        this.guardarTemasActuales();
        this.renderizarListaTemas();
        window.sincronizarNotificacionesDeComunidad();
    },

    guardarTemasActuales: async function() {
        const idJuego = this.idJuegoActual;
        if (!idJuego) return;

        try {
            localStorage.setItem('checkpoint_comunidad_temas_' + idJuego, JSON.stringify(this.temasActuales || []));
        } catch (e) {}

        try {
            if (typeof db !== 'undefined' && typeof doc !== 'undefined' && typeof setDoc !== 'undefined') {
                const docRef = doc(db, 'comunidades_juegos', String(idJuego));
                await setDoc(docRef, {
                    idJuego: String(idJuego),
                    tituloJuego: this.datosJuegoActual.titulo || '',
                    actualizado: Date.now(),
                    temas: this.temasActuales || []
                }, { merge: true });
            }
        } catch (e) {}
    },

    formatearFechaRelativa: function(ts) {
        if (!ts) return 'Hace un momento';
        const seg = Math.floor((Date.now() - ts) / 1000);
        if (seg < 60) return 'Ahora mismo';
        const min = Math.floor(seg / 60);
        if (min < 60) return 'Hace ' + min + ' min';
        const h = Math.floor(min / 60);
        if (h < 24) return 'Hace ' + h + ' h';
        const d = Math.floor(h / 24);
        if (d < 30) return 'Hace ' + d + (d === 1 ? ' día' : ' días');
        return new Date(ts).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
    },

