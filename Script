window.aplicarDisenoBuscadorLupa = function() {
    const searchPanel = document.getElementById('searchPanel');
    const raiz = searchPanel || document;

    // Mapa de iconos para cada pestaña
    const iconosPorPestana = {
        'juegos': 'sports_esports',
        'listas': 'format_list_bulleted',
        'temas': 'forum',
        'usuarios': 'group'
    };

    // 1. Localizamos la barra de pestañas (o la recuperamos si ya la marcamos antes)
    let filaPestanas = document.getElementById('barraPestanasLupa');
    if (!filaPestanas) {
        const candidatos = Array.from(raiz.querySelectorAll('button, div, span')).filter(el => {
            if (el.children.length > 1) return false;
            const txt = (el.textContent || '').trim().toLowerCase();
            return Object.prototype.hasOwnProperty.call(iconosPorPestana, txt);
        });
        if (candidatos.length >= 2) {
            filaPestanas = candidatos[0].parentElement;
            if (filaPestanas) filaPestanas.id = 'barraPestanasLupa';
        }
    }

    if (filaPestanas) {
        filaPestanas.classList.add('header-pestanas-lupa');

        // Evitamos que cualquier contenedor padre encoja las pestañas al mostrar resultados
        let ancestro = filaPestanas.parentElement;
        while (ancestro && ancestro !== document.body) {
            if (ancestro.id !== 'searchPanel') {
                ancestro.style.setProperty('flex-shrink', '0', 'important');
            } else {
                ancestro.style.setProperty('justify-content', 'flex-start', 'important');
            }
            ancestro = ancestro.parentElement;
        }

        // Creamos la píldora deslizante si aún no existe
        let slider = document.getElementById('sliderPestanaLupa');
        const botonesHijos = Array.from(filaPestanas.children).filter(el => el.id !== 'sliderPestanaLupa');

        if (!slider) {
            slider = document.createElement('div');
            slider.id = 'sliderPestanaLupa';
            slider.className = 'slider-pestana-lupa';
            filaPestanas.appendChild(slider);
        }

        botonesHijos.forEach((btn, idx) => {
            btn.classList.add('btn-pestana-lupa');

            // Guardamos el nombre limpio de la pestaña y le inyectamos su icono
            if (!btn.dataset.nombrePestana) {
                const textoOriginal = (btn.textContent || '').trim();
                const clave = textoOriginal.toLowerCase();
                btn.dataset.nombrePestana = clave;
                const nombreIcono = iconosPorPestana[clave] || 'star';

                btn.innerHTML = `
                    <span class="material-symbols-rounded icono-pestana-lupa">${nombreIcono}</span>
                    <span>${textoOriginal}</span>
                `;
            }

            // Detectamos si era la pestaña activa
            const bgInline = (btn.getAttribute('style') || '').toLowerCase();
            const bgComp = window.getComputedStyle(btn).backgroundColor;
            const eraOscuro = bgInline.includes('#111') || bgInline.includes('#000') || bgComp === 'rgb(17, 17, 17)';

            if (eraOscuro && !filaPestanas.dataset.initDone) {
                botonesHijos.forEach(b => b.classList.remove('activa-lupa'));
                btn.classList.add('activa-lupa');
            }

            // Evento para deslizar la píldora al tocar la pestaña
            if (!btn.dataset.lupaSliderBound) {
                btn.dataset.lupaSliderBound = 'true';
                btn.addEventListener('click', function() {
                    botonesHijos.forEach(b => b.classList.remove('activa-lupa'));
                    this.classList.add('activa-lupa');
                    window.moverSliderPestanaLupa(this);
                });
            }
        });

        if (!filaPestanas.dataset.initDone) {
            filaPestanas.dataset.initDone = 'true';
            if (!filaPestanas.querySelector('.activa-lupa') && botonesHijos[0]) {
                botonesHijos[0].classList.add('activa-lupa');
            }
        }

        const btnActivoActual = filaPestanas.querySelector('.btn-pestana-lupa.activa-lupa') || botonesHijos[0];
        setTimeout(() => window.moverSliderPestanaLupa(btnActivoActual), 30);
    }

    // 2. Unificamos el cajón de búsqueda en Glass Blanco (sobre el contenedor padre)
    const inputBusqueda = searchPanel
        ? searchPanel.querySelector('input[type="text"], input[type="search"], input:not([type="file"])')
        : document.querySelector('input[placeholder*="Buscar"], input[placeholder*="buscar"]');

    if (inputBusqueda) {
        inputBusqueda.classList.remove('cajon-glass-blanco');
        inputBusqueda.classList.add('input-interno-glass');

        const contenedorPadre = inputBusqueda.parentElement;
        if (contenedorPadre && contenedorPadre !== searchPanel) {
            contenedorPadre.classList.add('cajon-glass-blanco');
        } else {
            inputBusqueda.classList.add('cajon-glass-blanco');
        }
    }
};

