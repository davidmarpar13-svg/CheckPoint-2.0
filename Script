window.misTemasCreadosCache = window.misTemasCreadosCache || [];

// 1. Obtiene todos los temas creados por el usuario
window.obtenerMisTemasCreados = function() {
    const usuario = window.ComunidadApp ? window.ComunidadApp.obtenerUsuarioActivo() : { uid: 'anon', nombre: '' };
    const mapaTemas = new Map();

    try {
        for (let i = 0; i < localStorage.length; i++) {
            const key = localStorage.key(i);
            if (key && key.indexOf('checkpoint_comunidad_temas_') === 0) {
                const raw = localStorage.getItem(key);
                if (!raw) continue;
                const arr = JSON.parse(raw) || [];
                arr.forEach(function(t) {
                    if (!t || !t.id) return;
                    const mismoUid = (t.autorUid && usuario.uid && t.autorUid === usuario.uid);
                    const mismoNombre = (t.autorNombre && usuario.nombre && t.autorNombre.toLowerCase() === usuario.nombre.toLowerCase());
                    if (mismoUid || mismoNombre || usuario.uid === 'anon') {
                        mapaTemas.set(t.id, t);
                    }
                });
            }
        }
    } catch (e) {}

    const lista = Array.from(mapaTemas.values());
    lista.sort(function(a, b) { return (b.fecha || 0) - (a.fecha || 0); });
    window.misTemasCreadosCache = lista;
    return lista;
};

// Sincroniza las comunidades desde Firebase Firestore
window.sincronizarTemasUsuarioDesdeFirebase = async function() {
    try {
        if (typeof db !== 'undefined' && typeof collection !== 'undefined' && typeof getDocs !== 'undefined') {
            const snap = await getDocs(collection(db, 'comunidades_juegos'));
            snap.forEach(function(docSnap) {
                const data = docSnap.data() || {};
                const idJuego = docSnap.id;
                if (Array.isArray(data.temas)) {
                    try {
                        localStorage.setItem('checkpoint_comunidad_temas_' + idJuego, JSON.stringify(data.temas));
                    } catch (e) {}
                }
            });
        }
    } catch (e) {}
    window.actualizarContadorTemasEnPerfil();
};

// 2. Actualiza el contador de la pestaña TEMAS en el Perfil
window.actualizarContadorTemasEnPerfil = function() {
    const misTemas = window.obtenerMisTemasCreados();
    const profilePanel = document.getElementById('profilePanel') || document;

    const nodos = Array.from(profilePanel.querySelectorAll('div, span, p'));
    const labelTemas = nodos.find(function(el) {
        return el.children.length === 0 && (el.textContent || '').trim().toUpperCase() === 'TEMAS';
    });

    if (labelTemas && labelTemas.parentElement) {
        const contenedorTab = labelTemas.parentElement;
        const hermanoNumero = labelTemas.previousElementSibling || contenedorTab.firstElementChild;
        if (hermanoNumero && hermanoNumero !== labelTemas) {
            hermanoNumero.textContent = String(misTemas.length);
        }
    }
    return misTemas;
};

// 3. Obtiene siempre el contenedor nativo #tab-temas SIN cambiarle nunca su ID
window.obtenerContenedorPestanaTemasPerfil = function() {
    // Si en una sesión previa se renombró por error a contenedorMisTemasPerfil, le devolvemos su ID nativo "tab-temas"
    const renombradoPrevio = document.getElementById('contenedorMisTemasPerfil');
    if (renombradoPrevio && !document.getElementById('tab-temas')) {
        renombradoPrevio.id = 'tab-temas';
    }

    let tabTemas = document.getElementById('tab-temas');
    if (tabTemas) return tabTemas;

    const profilePanel = document.getElementById('profilePanel');
    if (!profilePanel) return null;

    // Si no existiera en el HTML, lo creamos con el ID exacto "tab-temas" que espera la app
    const refHermano = document.getElementById('tab-listas') || document.getElementById('tab-resenasPerfil') || document.getElementById('tab-coleccion');
    if (refHermano && refHermano.parentElement) {
        tabTemas = document.createElement('div');
        tabTemas.id = 'tab-temas';
        tabTemas.className = refHermano.className || '';
        refHermano.parentElement.appendChild(tabTemas);
        return tabTemas;
    }

    return null;
};

