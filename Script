window.esTabResenasActivaEnDOM = function(detailScreen) {
    if (!detailScreen) return false;
    const nodos = Array.from(detailScreen.querySelectorAll('button, div, span'));
    const tabRes = nodos.find(function(el) { return el.children.length <= 1 && (el.textContent || '').trim().toUpperCase() === 'RESEÑAS'; });
    const tabFicha = nodos.find(function(el) { return el.children.length <= 1 && /^FICHA\s+T[ÉE]CNICA$/i.test((el.textContent || '').trim()); });
    const tabMulti = nodos.find(function(el) { return el.children.length <= 1 && (el.textContent || '').trim().toUpperCase() === 'MULTIMEDIA'; });

    if (tabRes) {
        const cls = (tabRes.className || '') + ' ' + (tabRes.parentElement ? tabRes.parentElement.className : '');
        if (/\b(active|activo|selected)\b/i.test(cls)) return true;
        const st = window.getComputedStyle(tabRes);
        if (parseFloat(st.borderBottomWidth) > 1.5 && st.borderBottomStyle !== 'none' && st.borderBottomColor !== 'rgba(0, 0, 0, 0)' && st.borderBottomColor !== 'transparent') {
            return true;
        }
    }
    if (tabFicha || tabMulti) {
        const checkActiva = function(el) {
            if (!el) return false;
            if (/\b(active|activo|selected)\b/i.test(el.className || '')) return true;
            const s = window.getComputedStyle(el);
            return parseFloat(s.borderBottomWidth) > 1.5 && s.borderBottomColor !== 'rgba(0, 0, 0, 0)' && s.borderBottomColor !== 'transparent';
        };
        if (checkActiva(tabFicha) || checkActiva(tabMulti)) return false;
    }
    return window._pestanaActivaEnFichaJuego === 'resenas';
};

