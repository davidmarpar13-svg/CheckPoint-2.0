window.esContenedorDeJuegoOPerfil = function(el) {
    if (!el || el === document.body || el === document.documentElement) return true;
    const id = el.id || '';
    if (id === 'gameDetailScreen' || id === 'profilePanel' || id === 'gdIconsContainer') return true;
    if (el.classList && (el.classList.contains('app-wrapper') || el.classList.contains('game-content-wrapper') || el.classList.contains('glass-header-card'))) {
        return true;
    }
    if (el.querySelector && (el.querySelector('#gdCover') || el.querySelector('#gdTitle') || el.querySelector('#gdIconsContainer') || el.querySelector('#realCollection'))) {
        return true;
    }
    return false;
};

window.esElementoVisibleEnPantalla = function(el) {
    if (!el || el.getClientRects().length === 0) return false;
    let actual = el;
    while (actual && actual !== document.body && actual !== document.documentElement) {
        if (actual.classList && (actual.classList.contains('hidden') || actual.classList.contains('resena-modal-cerrado-seguro'))) return false;
        const st = window.getComputedStyle(actual);
        if (st.display === 'none' || st.visibility === 'hidden' || parseFloat(st.opacity) === 0 || st.pointerEvents === 'none') {
            return false;
        }
        actual = actual.parentElement;
    }
    return true;
};

