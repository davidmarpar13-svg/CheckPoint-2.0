window.filtrarProximamentePorPlataforma = function(plataforma, btnEl) {
    window.plataformaActivaProximamente = plataforma;
    const barra = document.getElementById('barraPlatProximamente');
    if (barra) {
        barra.querySelectorAll('.btn-plat-explorar, .platform-btn').forEach(b => b.classList.remove('active', 'activo'));
