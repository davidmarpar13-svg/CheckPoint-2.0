// 1. ABRIR / CERRAR DESPLEGABLES CON ANIMACIÓN
window.toggleDropdown = function(id, event) {
    if(event) event.stopPropagation(); // Evita que se cierre instantáneamente
    
    // Primero, cerramos todos los que estén abiertos
    document.querySelectorAll('.filtro-dropdown').forEach(drop => {
        if (drop.id !== id) {
            drop.classList.remove('open');
            drop.querySelector('.dropdown-menu').classList.remove('show');
        }
    });

    // Luego, abrimos o cerramos el que hemos clicado
    const dropdown = document.getElementById(id);
    if(dropdown) {
        dropdown.classList.toggle('open');
        dropdown.querySelector('.dropdown-menu').classList.toggle('show');
    }
};

// 2. CERRAR SI HACES CLIC FUERA DEL MENÚ (Cualquier parte de la pantalla)
document.addEventListener('click', function(event) {
