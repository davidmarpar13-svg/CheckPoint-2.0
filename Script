                        ${enColeccion ? `<div style="position: absolute; top: 6px; right: 6px; width: 22px; height: 22px; border-radius: 50%; background: #10b981; color: #fff; display: flex; align-items: center; justify-content: center; z-index: 2; box-shadow: 0 2px 6px rgba(0,0,0,0.25);"><span class="material-symbols-rounded" style="font-size: 14px;">check</span></div>` : ''}
                    </div>
