        finalBtn.addEventListener('click', async (e) => {
            e.preventDefault();
            
            if (!isEditingProfile) {
                /// ENTRAR EN MODO EDICIÓN
    isEditingProfile = true;

    bannerEditOverlay.classList.remove('hidden');
    avatarEditOverlay.classList.remove('hidden');

    pUser.classList.add('hidden');
    inName.classList.remove('hidden');
    inName.value = pUser.textContent;

    pBio.classList.add('hidden');
    inBio.classList.remove('hidden');
    inBio.value = (pBio.textContent === 'Sin descripción.') ? '' : pBio.textContent;

    bioCounterCont.classList.remove('hidden');

    // AQUÍ ESTÁ EL CAMBIO: Botón en negro con el icono de Guardar (save) en vez de verde
    finalBtn.style.background = '#1e1e1e'; // Fondo negro/gris oscuro
    finalBtn.style.color = '#ffffff';      // Texto e iconos en blanco/negro
    finalBtn.style.borderColor = '#1e1e1e';
    finalBtn.innerHTML = '<span class="material-symbols-rounded" style="font-size: 16px;">save</span> <span style="margin-top: 1px;">Guardar</span>';
                
            } else {
                // 2. SALIR DEL MODO EDICIÓN Y GUARDAR
                isEditingProfile = false;

                // 2.1 Ocultamos los botones de subir fotos
                bannerEditOverlay.classList.add('hidden');
                avatarEditOverlay.classList.add('hidden');

                // 2.2 Actualizamos el nombre en la pantalla al instante
                const nuevoNombre = inName.value.trim();
                if (nuevoNombre !== '') pUser.textContent = nuevoNombre;
                pUser.classList.remove('hidden');
                inName.classList.add('hidden');

                // 2.3 Actualizamos la biografía en la pantalla
                const nuevaBio = inBio.value.trim();
                pBio.textContent = nuevaBio === '' ? 'Sin descripción.' : nuevaBio;
                pBio.classList.remove('hidden');
                inBio.classList.add('hidden');
                bioCounterCont.classList.add('hidden');

                // 2.4 Devolvemos el botón a su estado normal ("Editar Perfil")
                finalBtn.style.background = 'rgba(0,0,0,0.04)';
                finalBtn.style.color = '#111111';
                finalBtn.style.border = '1px solid rgba(0,0,0,0.1)'; // <- ESTA ES LA LÍNEA QUE QUITA EL BORDE NEGRO
                finalBtn.innerHTML = '<span class="material-symbols-rounded" style="font-size: 16px;">edit</span> <span style="margin-top: 1px;">Editar Perfil</span>';

                // 2.5 Guardamos en Firebase en segundo plano sin recargar nada
                try {
