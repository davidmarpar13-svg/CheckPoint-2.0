                mensaje: 'En "' + (tema.titulo || 'tu tema') + '": "' + (nuevoCom.texto ? nuevoCom.texto.slice(0, 60) : 'Ha subido una imagen') + '"',
                imagen: tema.foto || nuevoCom.foto || this.datosJuegoActual.coverUrl || '',
                icono: 'forum',
                colorIcono: '#2563eb',
                idJuego: this.idJuegoActual || tema.idJuego || '',
                idTema: tema.id
            });
