// Función que filtra instantáneamente al escribir en la caja blanca
window.filtrarJuegosModalTop = function(texto) {
    const filtro = (texto || '').toLowerCase().trim();
    const items = document.querySelectorAll('#contenedorListaJuegosTopModal .item-juego-top-modal');

    items.forEach(item => {
        const nombre = item.getAttribute('data-nombre') || '';
        if (!filtro || nombre.includes(filtro)) {
            item.style.setProperty('display', 'flex', 'important');
        } else {
            item.style.setProperty('display', 'none', 'important');
        }
    });
};

// Función para guardar la selección en memoria y en Firebase
window.asignarJuegoTop3 = function(index, gameId) {
    if (!window.misFavoritos) window.misFavoritos = [null, null, null];
    window.misFavoritos[index] = gameId;

    // Ocultamos el modal
    const modal = document.getElementById('modalSelectorTop3');
    if (modal) modal.style.display = 'none';

    // Repintamos el perfil para ver el cambio al instante
    if (typeof window.pintarColeccionPerfil === "function") {
        window.pintarColeccionPerfil();
    }

    // Guardamos en Firebase (en el documento del usuario)
    const usuarioActual = auth.currentUser;
    if (usuarioActual) {
        const userRef = doc(db, 'users', usuarioActual.uid);
        setDoc(userRef, { misFavoritos: window.misFavoritos }, { merge: true })
            .catch(err => console.error("Error al guardar Top 3 en Firebase:", err));
    }
};

window.alternarBuscadorColeccion = function() {
    const contenedorBuscador = document.getElementById('contenedorBuscadorColeccion');
    const input = document.getElementById('inputBuscadorColeccion');
    const btnTodos = document.getElementById('btnTabTodos');
    const btnFav = document.getElementById('btnTabFavoritos');
    const btnLupa = document.getElementById('btnToggleBuscador');

    if (btnLupa) btnLupa.style.transform = 'scale(1.1)';

    setTimeout(() => {
        if (btnLupa) btnLupa.style.transform = 'scale(1)';
        if (btnTodos) {
            btnTodos.style.opacity = '0';
            btnTodos.style.transform = 'scaleX(0.5)';
            btnTodos.style.pointerEvents = 'none';
        }
        if (btnFav) {
            btnFav.style.opacity = '0';
            btnFav.style.transform = 'scaleX(0.5)';
            btnFav.style.pointerEvents = 'none';
        }

        if (contenedorBuscador) {
