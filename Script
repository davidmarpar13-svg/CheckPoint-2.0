    resolverUrlCaratula: function(juego, hashFallback) {
        let raw = '';
        if (juego && juego.caratula && typeof juego.caratula === 'string') {
            raw = juego.caratula.trim();
        } else if (juego && juego.cover) {
            if (typeof juego.cover === 'string') raw = juego.cover.trim();
            else if (juego.cover.image_id) raw = String(juego.cover.image_id).trim();
            else if (juego.cover.url) raw = String(juego.cover.url).trim();
        } else if (juego && (juego.coverUrl || juego.imagen || juego.portada)) {
            raw = String(juego.coverUrl || juego.imagen || juego.portada).trim();
        }

        if (!raw && hashFallback) raw = hashFallback;
        if (!raw) return '';

        if (raw.startsWith('http://') || raw.startsWith('https://') || raw.startsWith('//')) {
            const urlCompleta = raw.startsWith('//') ? ('https:' + raw) : raw;
            return urlCompleta.replace(/t_[a-z0-9_]+/i, 't_cover_big');
        }
        const hashLimpio = raw.replace(/\.(jpg|png|webp)$/i, '');
        return `https://images.igdb.com/igdb/image/upload/t_cover_big/${hashLimpio}.jpg`;
    },

    extraerAnioJuego: function(j) {
        const ts = this.obtenerTimestampLanzamiento(j);
        if (ts) {
            const y = new Date(ts).getFullYear();
            if (y >= 1970 && y <= 2035) return y;
        }
        const campos = [
            j.anio, j.year, j.release_year, j.first_release_date,
            j.release_date, j.releaseDate, j.fecha_lanzamiento, j.lanzamiento, j.fecha
        ];
        for (const val of campos) {
            if (val === undefined || val === null || val === '') continue;
            if (typeof val === 'number' && val >= 1970 && val <= 2035) return val;
            if (typeof val === 'string') {
                const m = val.match(/\b(19[7-9]\d|20[0-3]\d)\b/);
                if (m) return Number(m[1]);
            }
        }
        if (Array.isArray(j.release_dates)) {
            for (const rd of j.release_dates) {
                if (rd && rd.y && rd.y >= 1970 && rd.y <= 2035) return Number(rd.y);
            }
        }
        return 0;
    },

    consultarIGDB: function(queryTexto) {
        return new Promise((resolve) => {
            if (!window.google || !window.google.script || !window.google.script.run) return resolve([]);

            if (!this._fnServidor) {
                const scriptsText = Array.from(document.querySelectorAll('script')).map(s => s.textContent).join('\n');
                const pos = scriptsText.indexOf('RESPUESTA IGDB');
                if (pos !== -1) {
                    const trozo = scriptsText.substring(Math.max(0, pos - 350), Math.min(scriptsText.length, pos + 600));
                    const matches = trozo.match(/\.([a-zA-Z0-9_]+)\s*\(/g) || [];
                    for (const m of matches) {
                        const fn = m.replace(/^\.|\s*\($/g, '');
                        if (!['log', 'error', 'withSuccessHandler', 'withFailureHandler', 'forEach', 'map', 'filter', 'includes', 'trim', 'toLowerCase', 'getElementById', 'querySelector'].includes(fn)) {
                            this._fnServidor = fn;
                            break;
                        }
                    }
                }
            }

            const candidatos = [this._fnServidor, 'buscarJuegosIGDB', 'buscarIGDB', 'searchIGDB', 'buscarJuegos'].filter(Boolean);
            const runner = window.google.script.run
                .withSuccessHandler(res => {
                    const datosBrutos = (res && Array.isArray(res.data)) ? res.data : (Array.isArray(res) ? res : []);
                    const datos = datosBrutos.filter(window.esJuegoValidoParaAppGlobal);
                    datos.forEach(item => {
                        if (item && item.id !== undefined) {
                            const normalizado = this.normalizarObjetoIGDB(item);
                            this.registroJuegosIGDB[String(item.id)] = normalizado;
                            this.inyectarEnCachesNativos(normalizado);
                        }
                    });
                    resolve(datos);
                })
                .withFailureHandler(() => resolve([]));

            for (const nombreFn of candidatos) {
                if (typeof runner[nombreFn] === 'function') {
                    this._fnServidor = nombreFn;
                    runner[nombreFn](queryTexto);
                    return;
                }
            }
            resolve([]);
        });
    },

    inyectarEnCachesNativos: function(juegoRaw) {
        if (!juegoRaw || juegoRaw.id === undefined) return;
        if (!this.esObjetoCompletoIGDB(juegoRaw)) return;

        const idStr = String(juegoRaw.id);

        window.juegosCargados = window.juegosCargados || {};
        window.juegosCargados[idStr] = juegoRaw;

        if (!this._variablesCacheDetectadas) {
            const vars = new Set([
                'juegosCargados', 'ultimosResultadosBusqueda', 'resultadosBusqueda',
                'juegosBuscados', 'cacheBusqueda', 'juegosCache', 'igdbCache', 'searchResults'
            ]);
            this._variablesCacheDetectadas = Array.from(vars);
        }

        this._variablesCacheDetectadas.forEach(nombreVar => {
            try {
                const ref = window[nombreVar];
                if (Array.isArray(ref)) {
                    const idx = ref.findIndex(x => x && String(x.id) === idStr);
                    if (idx === -1) ref.push(juegoRaw);
                    else ref[idx] = juegoRaw;
                } else if (ref && typeof ref === 'object' && ref !== window && ref !== document && ref !== window.miColeccionActiva && ref !== window.misListasCache) {
                    ref[idStr] = juegoRaw;
                }
            } catch (e) {}
        });
    },

