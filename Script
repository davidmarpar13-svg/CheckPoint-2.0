window.switchGameTab = function(tabName, btnElement) {
    // 1. Quitar la clase 'active' de todos los botones de las pestañas
    const btns = document.querySelectorAll('.game-tab-btn');
    btns.forEach(b => b.classList.remove('active'));

    // 2. Ocultar todas las secciones de contenido
    const sections = document.querySelectorAll('#gameDetailScreen .tab-section');
    sections.forEach(s => {
        s.style.display = 'none';
        s.classList.remove('active');
    });

    // 3. Poner la clase 'active' al botón pulsado (para que se vea la raya debajo)
    btnElement.classList.add('active');

    // 4. Mostrar la sección seleccionada
    const tabToActivate = document.querySelector(`#gameDetailScreen #tab-${tabName}`);
    if (tabToActivate) {
        tabToActivate.style.display = 'block';
        tabToActivate.classList.add('active');
    }
};

window.pintarColeccionPerfil = function() {
    window.actualizarContadoresPerfil(); // <--- AHORA SÍ ESTÁ EN SU SITIO
    const contenedor = document.getElementById('realCollection');
    const contadorRef = document.getElementById('statCollection');

    // --- NUEVO: FORZAR QUE "TODOS" ESTÉ MARCADO AL ENTRAR AL PERFIL ---
    const botonesFiltro = document.querySelectorAll('.filtros-container .filtro-btn');
    if (botonesFiltro.length > 0) {
        // Comprobamos si hay alguno activo ya
        const hayActivo = Array.from(botonesFiltro).some(btn => btn.classList.contains('activo'));
        // Si no hay ninguno (cuando acabas de entrar), activamos el primero ("Todos")
        if (!hayActivo) {
            botonesFiltro[0].classList.add('activo');
        }
    }
    // ----------------------------------------------------------------

    // ... (el resto de tu función pintarColeccionPerfil sigue normal aquí abajo)
    let totalJuegos = 0;
    if (window.miColeccionActiva) {
        totalJuegos = Object.keys(window.miColeccionActiva).length;
    }

    // 2. Actualizamos el número grande de arriba
    if (contadorRef) {
        contadorRef.innerText = totalJuegos;
    }

    if (!contenedor) return;

    // 3. Si no hay juegos en la colección
    if (totalJuegos === 0) {
        contenedor.innerHTML = '<div style="text-align: center; color: #888; padding: 40px; font-style: italic; font-size: 14px;">Por ahora no hay nada que ver aquí...</div>';
        return;
    }

    // 4. Aseguramos que haya un botón activo visualmente
    let botonActivo = document.querySelector('.filtros-container .filtro-btn.activo');
    if (!botonActivo) {
        const btnTodos = document.querySelector('.filtros-container .filtro-btn:first-child');
        if (btnTodos) {
            btnTodos.classList.add('activo');
            botonActivo = btnTodos;
        }
    }

    // 5. FILTRAMOS Y PINTAMOS LOS JUEGOS (CÓDIGO A PRUEBA DE FALLOS)
    let htmlFinal = '';
    let juegosAMostrar = Object.values(window.miColeccionActiva || {});
    let esPestanaFavoritos = false;
    let filtroActual = botonActivo ? botonActivo.textContent.trim().toLowerCase() : "todos";

    if (filtroActual.includes('favorito')) {
        esPestanaFavoritos = true;
        juegosAMostrar = juegosAMostrar.filter(juego => juego.favorito === true);
