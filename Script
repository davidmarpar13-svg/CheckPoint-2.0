document.addEventListener('DOMContentLoaded', () => {
    let searchTimeout = null;
    const searchInput = document.getElementById('mainSearchInput');
    const searchResults = document.getElementById('searchResults');

    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            const query = e.target.value.trim();
            
            // 1. Averiguamos qué pestaña está marcada actualmente
            const activeTabBtn = document.querySelector('.tab-btn.active');
            const activeTab = activeTabBtn ? activeTabBtn.getAttribute('data-tab') : 'games';

            // 2. Si borras o hay menos de 2 letras, limpiamos
            if (query.length < 2) {
                searchResults.innerHTML = '';
                return;
            }

            // 3. LA MAGIA: Si no estamos en la pestaña de juegos, paramos aquí y avisamos
            if (activeTab !== 'games') {
                searchResults.innerHTML = '<div style="text-align: center; color: #555; padding: 20px; font-weight: 500;">Búsqueda no disponible en esta sección todavía.</div>';
                return; // El return hace que el código se detenga y no llame al servidor
            }

            searchResults.innerHTML = '<div style="text-align: center; color: #555; padding: 20px; font-weight: 500;">Buscando...</div>';

            // 4. Temporizador y llamada al servidor (Solo llega aquí si estamos en "games")
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                
                google.script.run
                    .withSuccessHandler((juegos) => {
                        if (juegos && juegos.length > 0) {
                            let html = '<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; padding: 10px;">';
                            
                            juegos.forEach(game => {
