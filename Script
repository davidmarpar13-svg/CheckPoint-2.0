window.switchGameTab = function(tabName, btnElement) {
    // 1. Quitar la clase 'active' de todos los botones de las pestañas
    const btns = document.querySelectorAll('.game-tab-btn');
    btns.forEach(b => b.classList.remove('active'));

    // 2. Ocultar todas las secciones de contenido
    const sections = document.querySelectorAll('#gameDetailScreen .tab-section');
    sections.forEach(s => {
        s.style.display = 'none';
        s.classList.remove('active');
    });

    // 3. Poner la clase 'active' al botón pulsado (para que se vea la raya debajo)
    btnElement.classList.add('active');

    // 4. Mostrar la sección seleccionada
    const tabToActivate = document.querySelector(`#gameDetailScreen #tab-${tabName}`);
    if (tabToActivate) {
        tabToActivate.style.display = 'block';
        tabToActivate.classList.add('active');
    }
};

window.pintarColeccionPerfil = function() {
    const contenedor = document.getElementById('realCollection');
    const contadorRef = document.getElementById('statCollection'); // Referencia a tu número 0
    
    // 1. Contamos cuántos juegos tienes en memoria
    let totalJuegos = 0;
    if (window.miColeccionActiva) {
        totalJuegos = Object.keys(window.miColeccionActiva).length;
    }

    // 2. Actualizamos el número en la pestaña superior
    if (contadorRef) {
        contadorRef.innerText = totalJuegos;
    }

    if (!contenedor) return;
    
    // Si no hay juegos guardados
    if (totalJuegos === 0) {
        contenedor.innerHTML = '<div style="text-align: center; color: #888; padding: 40px; font-style: italic; font-size: 14px;">Por ahora no hay nada que ver aquí... salvo una colección más vacía que la taberna de un pueblo fantasma. ¿Seguro que juegas a algo o solo miras los menús?</div>';
        return;
    }

    // Si hay juegos, forzamos 3 columnas y quitamos el texto del estado inferior
    let html = '<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; padding: 5px 10px; width: 100%; box-sizing: border-box;">';
    
    // Recorremos todos los juegos
    Object.values(window.miColeccionActiva).forEach(juego => {
        
        // Carátula
        const coverUrl = juego.caratula ? `https://images.igdb.com/igdb/image/upload/t_cover_big/${juego.caratula}.jpg` : 'https://images.igdb.com/igdb/image/upload/t_cover_big/nocover.png';
            
        // HTML de la carátula sin el div del estado
       html += '<div onclick="window.openGameDetail(\'' + juego.id + '\', \'' + juego.estado + '\')" style="cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform=\'scale(1.05)\'" onmouseout="this.style.transform=\'scale(1)\'">';
html += '<img src="' + coverUrl + '" style="width: 100%; aspect-ratio: 3/4; object-fit: cover; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.15); display: block;">';
html += '</div>';
    });
    
    html += '</div>';
    
    // Inyectamos el HTML
    contenedor.innerHTML = html;
};

window.borrarJuegoDeColeccion = function(gameId) {
    if(!confirm("¿Seguro que quieres borrar este juego de tu colección?")) return;
    const usuarioActual = auth.currentUser;
    if (!usuarioActual) return;

    // 1. SALVAR DATOS: Guardamos una copia en memoria para que la ficha no se quede vacía al recargarse
    if (!window.juegosCargados) window.juegosCargados = {};
    if (!window.juegosCargados[gameId] && window.miColeccionActiva && window.miColeccionActiva[gameId]) {
        window.juegosCargados[gameId] = JSON.parse(JSON.stringify(window.miColeccionActiva[gameId]));
    }

    // 2. ANIMACIÓN DE SALIDA: Ocultamos los botones actuales suavemente
    const iconsContainer = document.getElementById('gdIconsContainer');
    if (iconsContainer) {
        iconsContainer.style.transition = 'all 0.3s ease';
        iconsContainer.style.opacity = '0';
        iconsContainer.style.transform = 'scale(0.95)';
    }

    const juegoRef = doc(db, 'users', usuarioActual.uid, 'coleccion', gameId.toString());
    
    deleteDoc(juegoRef).then(() => {
        // 3. Borramos de tu colección local
        delete window.miColeccionActiva[gameId];
        if(window.pintarColeccionPerfil) window.pintarColeccionPerfil();
        
        // 4. Redibujamos la ficha en modo "no lo tienes" con animación de entrada
        setTimeout(() => {
            window.openGameDetail(gameId, 'not_owned'); // Forzamos el modo sin tenerlo
            
            setTimeout(() => {
                const nuevoContainer = document.getElementById('gdIconsContainer');
                if (nuevoContainer) {
                    nuevoContainer.style.transition = 'all 0.3s ease';
                    nuevoContainer.style.opacity = '1';
                    nuevoContainer.style.transform = 'scale(1)';
                }
            }, 50);
        }, 300);
        
    }).catch((error) => {
        console.error("Error al borrar:", error);
        if (iconsContainer) {
            iconsContainer.style.opacity = '1';
            iconsContainer.style.transform = 'scale(1)';
        }
    });
};
window.actualizarEstadoJuego = function(gameId, nuevoEstado) {
    const usuarioActual = auth.currentUser;
    if (!usuarioActual || !window.miColeccionActiva[gameId]) return;

    // Actualiza en Firebase
    const juegoRef = doc(db, 'users', usuarioActual.uid, 'coleccion', gameId.toString());
    updateDoc(juegoRef, { estado: nuevoEstado }).then(() => {
        // Actualiza en local
        window.miColeccionActiva[gameId].estado = nuevoEstado;
        if(window.pintarColeccionPerfil) window.pintarColeccionPerfil();
        
        // Actualiza el texto central del nuevo botón animado
        const textoEstado = document.getElementById('textoEstadoCentral');
        if (textoEstado) textoEstado.innerText = nuevoEstado;
    });
};

window.seleccionarNuevoEstado = function(gameId, nuevoEstado, elementoClicado) {
    // 1. Ocultar el menú inmediatamente
    document.getElementById('estadoDropdownMenu').classList.remove('show');
    
