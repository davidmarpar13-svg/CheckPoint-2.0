        const tieneImg = Boolean(el.querySelector('img'));
        const tieneNota = /\/\s*10/.test(el.textContent || '');
        const subConNota = Array.from(el.children).filter(function(c) {
            return c.querySelector && c.querySelector('img') && /\/\s*10/.test(c.textContent || '');
        });
        return tieneImg && tieneNota && subConNota.length === 0;
    });

    hijos.forEach(function(card) {
        const coverImg = card.querySelector('img');
        const textos = Array.from(card.querySelectorAll('h3, h4, div, span, p')).map(function(el) {
            return el.children.length === 0 ? (el.textContent || '').trim() : '';
        }).filter(Boolean);

        const tituloCand = textos.find(function(t) {
            return t.length > 1 && !/^\★?\s*\d+\s*\/\s*10$/.test(t) && !/^★+$/.test(t) && !/^\d{1,2}\s+[a-z]{3}\s+\d{4}$/i.test(t) && t !== 'star';
        });
        if (!tituloCand) return;

        const titKey = tituloCand.toLowerCase().trim();
        if (window._juegosSinResenaPorBorrado.has(titKey)) return;

        const matchNota = (card.textContent || '').match(/(\d+)\s*\/\s*10/);
        const notaNum = matchNota ? parseInt(matchNota[1], 10) : 8;

        const comentarioCand = textos.filter(function(t) {
            return t !== tituloCand && !/^\★?\s*\d+\s*\/\s*10$/.test(t) && !/^★+$/.test(t) && !/^\d{1,2}\s+[a-z]{3}\s+\d{4}$/i.test(t) && t !== 'star';
        }).pop() || '';
        const textoLimpio = comentarioCand.replace(/^["“”«»']+/, '').replace(/["“”«»']+$/, '').trim();

        const idJuegoRes = window.resolverIdJuegoDeTarjetaResena(card, tituloCand);

        const objRes = {
            idJuego: idJuegoRes,
            titulo: tituloCand,
            cover: coverImg ? coverImg.src : '',
            nota: notaNum,
            texto: textoLimpio,
            cardEl: card
        };

        window._mapaMisResenasGuardadas[titKey] = objRes;
        if (idJuegoRes) window._mapaMisResenasGuardadas['id_' + idJuegoRes] = objRes;
    });
};

