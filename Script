window.añadirAlInventario = function(gameId) {
    const game = window.juegosCargados[gameId];
    if (!game) return;

    const iconsContainer = document.getElementById('gdIconsContainer');
    if (iconsContainer) {
        iconsContainer.style.transition = 'all 0.3s ease';
        iconsContainer.style.opacity = '0';
        iconsContainer.style.transform = 'scale(0.95)';
    }

    const usuarioActual = auth.currentUser;
    const miUid = usuarioActual ? usuarioActual.uid : "usuario_anonimo";

    // 1. CALCULAR AÑO PARA EL FILTRO RETRO
    let anioLanzamiento = 2026; 
    let fechaUsar = game.first_release_date || game.lanzamiento;
    if (fechaUsar) {
        let timestamp = String(fechaUsar).length <= 10 ? fechaUsar * 1000 : fechaUsar;
        anioLanzamiento = new Date(timestamp).getFullYear();
    }

    // 2. FONDO DEFINITIVO (Respetando juegos clásicos < 2017)
    let idFondoReal = null;
    if (anioLanzamiento < 2017 && game.artworks && game.artworks.length > 0) {
        // ES RETRO: Forzamos el artwork para que no salgan píxeles feos
        let arte = game.artworks[0];
        idFondoReal = arte ? (arte.image_id || arte) : null;
    } else {
        // ES MODERNO: Cogemos la primera captura de pantalla directamente
        if (game.screenshots && game.screenshots.length > 0) {
            let captura = game.screenshots[0];
            if (captura) idFondoReal = captura.image_id || captura;
        }
        // Plan B para modernos sin capturas
        if (!idFondoReal && game.artworks && game.artworks.length > 0) {
            let arte = game.artworks[0];
            if (arte) idFondoReal = arte.image_id || arte;
        }
    }

    // 3. EXTRACCIÓN SEGURA (Escudos contra IGDB)
    const plataformasSafe = game.platforms ? Array.from(game.platforms).map(p => p ? (p.name || p) : "").filter(n => typeof n === 'string' && n !== "") : [];
    const generosSafe = game.genres ? Array.from(game.genres).map(g => g ? (g.name || g) : "").filter(n => typeof n === 'string' && n !== "") : [];
    const empresasSafe = game.involved_companies ? Array.from(game.involved_companies).map(e => (e && e.company && e.company.name) ? e.company.name : "").filter(n => typeof n === 'string' && n !== "") : [];
    const videosSafe = game.videos ? Array.from(game.videos).map(v => v ? (v.video_id || v) : null).filter(v => v !== null) : [];
    const screenshotsSafe = game.screenshots ? Array.from(game.screenshots).map(s => s ? (s.image_id || s) : null).filter(s => s !== null) : [];

    // 4. OBJETO FINAL PARA FIREBASE
    const datosSaneados = {
        id: game.id,
        nombre: game.name || 'Juego sin título',
        caratula: game.cover ? (game.cover.image_id || game.cover) : null,
        fondo: typeof idFondoReal === 'string' ? idFondoReal : null, 
        
        summary: game.summary || game.storyline || "",
        first_release_date: game.first_release_date || null,
        
        plataformas: plataformasSafe,
        generos: generosSafe,
        empresas: empresasSafe,
        videos: videosSafe,
        screenshots: screenshotsSafe,
        
        estado: 'pendiente',
        fecha_agregado: new Date().getTime(),
        uid: miUid,
        
        puntuacion: (window.miColeccionActiva && window.miColeccionActiva[game.id] && window.miColeccionActiva[game.id].puntuacion) ? window.miColeccionActiva[game.id].puntuacion : 0,
        reseña: (window.miColeccionActiva && window.miColeccionActiva[game.id] && window.miColeccionActiva[game.id].reseña) ? window.miColeccionActiva[game.id].reseña : ""
    };

    const juegoRef = doc(db, 'users', miUid, 'coleccion', game.id.toString());

    setDoc(juegoRef, datosSaneados, { merge: true })
    .then(() => {
        if (!window.miColeccionActiva) window.miColeccionActiva = {};
        window.miColeccionActiva[game.id] = datosSaneados;
        
        if (typeof window.pintarColeccionPerfil === 'function') window.pintarColeccionPerfil();

        setTimeout(() => {
            if (typeof window.openGameDetail === 'function') window.openGameDetail(game.id);
            if (iconsContainer) {
                iconsContainer.style.opacity = '1';
                iconsContainer.style.transform = 'scale(1)';
            }
        }, 300);
    })
    .catch(error => console.error("Error guardando:", error));
};

