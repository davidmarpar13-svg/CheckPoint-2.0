window.aplicarFiltroTarjetasResenasPerfil = function() {
    const tabResenas = document.getElementById('tab-resenasPerfil');
    if (!tabResenas) return;
    window.sincronizarMapaMisResenasDesdeDOM();

    const q = (window.busquedaResenasPerfil || '').trim();
    const notaFiltro = window.filtroEstrellasResenasPerfil;
    const msgPrevio = document.getElementById('msgSinResenasFiltro');
    if (msgPrevio) msgPrevio.remove();

    const hijos = Array.from(tabResenas.children).filter(function(el) {
        return el.id !== 'subNavResenasPerfilWrap' && el.id !== 'msgSinResenasFiltro';
    });

    let tarjetas = [];
    hijos.forEach(function(h) {
        if (h.querySelector('img') && /\/\s*10/.test(h.textContent || '')) {
            const sub = Array.from(h.children).filter(function(s) { return s.querySelector('img') && /\/\s*10/.test(s.textContent || ''); });
            tarjetas = sub.length > 0 ? tarjetas.concat(sub) : tarjetas.concat([h]);
        }
    });

    if (tarjetas.length === 0) return;
    let visibles = 0;
    tarjetas.forEach(function(card) {
        const textoCard = (card.textContent || '');
        const matchNota = textoCard.match(/(\d+)\s*\/\s*10/);
        const notaCard = matchNota ? parseInt(matchNota[1], 10) : null;
        let cumple = !q || window.coincideBusquedaFlexible(textoCard, q);
        if (notaFiltro !== null && notaCard !== notaFiltro) cumple = false;
        card.style.display = cumple ? '' : 'none';
        if (cumple) visibles++;
    });

    if (visibles === 0) {
        const avisoVacio = document.createElement('div');
        avisoVacio.id = 'msgSinResenasFiltro';
        avisoVacio.style.cssText = 'text-align: center; padding: 35px 20px; color: #888; font-family: "Outfit", sans-serif; font-size: 0.84rem;';
        avisoVacio.textContent = notaFiltro ? ('No tienes reseñas con ' + notaFiltro + '/10 estrellas.') : 'No hay reseñas que coincidan con tu búsqueda.';
        tabResenas.appendChild(avisoVacio);
    }
};

