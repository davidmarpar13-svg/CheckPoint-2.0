           // 1. NUEVO MOTOR DE BÚSQUEDA INTELIGENTE (Anti-Cuelgues y Detector de Errores)
        async function fetchConReintentos(url, maxReintentos = 3) {
            for (let i = 0; i < maxReintentos; i++) {
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 20000); 

                try {
                    const res = await fetch(url, { 
                        cache: "no-store",
                        signal: controller.signal 
                    });
                    
                    clearTimeout(timeoutId); 
                    
                    // SI GOOGLE DEVUELVE HTML EN LUGAR DE DATOS, LO IMPRIMIMOS EN LA CONSOLA
                    if (res.headers.get("content-type") && res.headers.get("content-type").includes("text/html")) {
                        const errorHTML = await res.text();
                        console.error("🚨 ERROR OCULTO DE GOOGLE:", errorHTML);
                        throw new Error("HTML detectado, forzando reintento");
                    }
                    return await res.json();
                    
                } catch (e) {
                    clearTimeout(timeoutId);
                    if (i === maxReintentos - 1) throw e;
                    await new Promise(r => setTimeout(r, 500)); 
                }
            }
        }

