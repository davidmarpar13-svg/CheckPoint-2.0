        const usuario = this.obtenerUsuarioActivo();
        tema.comentarios = Array.isArray(tema.comentarios) ? tema.comentarios : [];

        const nuevoCom = {
            id: 'com_' + Date.now() + '_' + Math.random().toString(36).slice(2, 5),
            autorUid: usuario.uid,
            autorNombre: usuario.nombre,
            autorAvatar: usuario.avatar,
            texto: texto.replace(/</g, '&lt;').replace(/>/g, '&gt;'),
            foto: this.fotoComentarioPendienteBase64 || '',
            likes: [],
            likesDetalle: [],
            fecha: Date.now()
        };

        tema.comentarios.push(nuevoCom);

        // 1. Notificar al creador del tema (si quien comenta no es el creador)
        if (!this.esUsuarioCreadorDelTema(tema)) {
            window.enviarNotificacionAUsuarioDestino(tema.autorUid, tema.autorNombre, {
                id: 'notif_com_tema_' + tema.id + '_' + nuevoCom.id,
