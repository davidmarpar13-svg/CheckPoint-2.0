        // 2. Notificar a todos los usuarios que siguen el tema (excepto a quien acaba de comentar y al creador que ya recibe la suya)
        const seguidores = Array.isArray(tema.seguidores) ? tema.seguidores : [];
        seguidores.forEach(function(segUid) {
            if (!segUid || segUid === usuario.uid || segUid === tema.autorUid) return;
            window.enviarNotificacionAUsuarioDestino(segUid, '', {
