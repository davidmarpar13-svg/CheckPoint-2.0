                                const title = game.name || 'Desconocido';
                                const platform = (game.platforms && game.platforms.length > 0) ? (game.platforms[0].abbreviation || game.platforms[0].name) : 'ND';

                                html += `
                                    <div style="display: flex; flex-direction: column; align-items: center; background: rgba(255,255,255,0.7); border-radius: 12px; padding: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); text-align: center;">
                                        <img src="${coverUrl}" style="width: 100%; aspect-ratio: 3/4; object-fit: cover; border-radius: 8px; margin-bottom: 6px;" />
                                        <div style="font-weight: 700; font-size: 12px; color: #111; line-height: 1.1; margin-bottom: 4px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; width: 100%;">${title}</div>
                                        <div style="font-size: 10px; font-weight: 600; color: #555; background: rgba(0,0,0,0.08); padding: 2px 6px; border-radius: 6px;">${platform}</div>
                                    </div>
                                `;
                            });
                            
                            html += '</div>';
                            searchResults.innerHTML = html;
                        } else {
                            searchResults.innerHTML = '<div style="text-align: center; color: #555; padding: 20px;">No se han encontrado juegos</div>';
                        }
                    })
