// 1. CARGAR "PRÓXIMAMENTE" (10 juegos + filtro por plataformas)
window.cargarProximamente = async function() {
    window.asegurarBarrasFiltrosExplorar();
    const contenedor = document.getElementById('exploreUpcomingList');
    if (!contenedor) return;

    const fraseProx = (window.FRASES_CARGA_PROXIMAMENTE && window.FRASES_CARGA_PROXIMAMENTE.length)
        ? window.FRASES_CARGA_PROXIMAMENTE[window._idxFraseProximamente++ % window.FRASES_CARGA_PROXIMAMENTE.length]
        : 'Cargando próximos lanzamientos...';
    contenedor.innerHTML = `<div class="texto-carga-explorar">${fraseProx}</div>`;

    try {
        const separador = APPS_SCRIPT_URL.includes('?') ? '&' : '?';
        const urlFinal = `${APPS_SCRIPT_URL}${separador}action=upcoming&t=${Date.now()}`;

        const respuesta = await fetch(urlFinal);
        const json = await respuesta.json();

        if (json && json.success === false) {
            console.error("IGDB ERROR:", json);
            contenedor.innerHTML = `<div style="text-align:center; padding: 20px; color:#dc2626; width: 100%; border: 1px solid #fca5a5; background: #fef2f2; border-radius: 8px;">
                <strong>Error del servidor:</strong><br>
                <span style="font-size:0.85rem">${json.error}</span>
            </div>`;
            return;
        }

        const juegos = Array.isArray(json) ? json : (json?.data || []);

        if (juegos.length === 0) {
            contenedor.innerHTML = '<div class="texto-carga-explorar">No hay lanzamientos a la vista.</div>';
            return;
        }

        window.juegosProximosCache = juegos;
        window.renderizarCarruselProximamente();
    } catch (error) {
        console.error("Error al cargar próximamente:", error);
        contenedor.innerHTML = '<div class="texto-carga-explorar" style="color:#dc2626 !important;">Error de conexión al cargar próximos lanzamientos.</div>';
    }
};

