// Función que filtra en #listasJuegoOverlay las tarjetas que NO contienen el juego actual
window.filtrarTarjetasListasPorJuegoActual = function(idJuegoExplicito) {
    const idJuego = String(
        idJuegoExplicito ||
        window.juegoActualEnFichaId ||
        window.currentGameId ||
        window.idJuegoActual ||
        window.juegoSeleccionadoId ||
        ''
    ).trim();

    const overlay = document.getElementById('listasJuegoOverlay');
    if (!overlay || !idJuego) return;

    const cacheListas = window.misListasCache || {};
    const tarjetas = overlay.querySelectorAll('[onclick*="abrirDetalleLista"]');

    let visibles = 0;
    tarjetas.forEach(tarjeta => {
        const attrOnclick = tarjeta.getAttribute('onclick') || '';
        const match = attrOnclick.match(/abrirDetalleLista\(['"]([^'"]+)['"]\)/);
        if (match && match[1]) {
            const idLista = match[1];
            const datosLista = cacheListas[idLista];
            const juegosEnLista = (datosLista && Array.isArray(datosLista.juegos))
                ? datosLista.juegos.map(String)
                : [];

            // SOLO se muestra si la lista contiene este juego
            if (juegosEnLista.includes(idJuego)) {
                tarjeta.style.display = 'flex';
                visibles++;
            } else {
                tarjeta.style.display = 'none';
            }
        }
    });

    // Mensaje cuando el juego no pertenece a ninguna lista todavía
    let msgVacio = document.getElementById('msgSinListasParaEsteJuego');
    if (visibles === 0 && tarjetas.length > 0) {
        if (!msgVacio) {
            msgVacio = document.createElement('p');
            msgVacio.id = 'msgSinListasParaEsteJuego';
            msgVacio.style.cssText = 'color: #888; font-family: "Outfit", sans-serif; font-size: 0.88rem; text-align: center; margin: 30px 20px; line-height: 1.5;';
            msgVacio.textContent = 'Este juego aún no está en ninguna de tus listas.';
            tarjetas[0].parentElement.appendChild(msgVacio);
        }
        msgVacio.style.display = 'block';
    } else if (msgVacio) {
        msgVacio.style.display = 'none';
    }
};

