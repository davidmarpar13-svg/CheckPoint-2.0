// Guarda la elección en Firebase
window.guardarFavorito = async function(gameId) {
    const slotIndex = window.slotFavoritoActual;
    
    // Si el juego ya está en otro hueco, lo quitamos de ahí para no repetir
    const indiceExistente = window.misFavoritos.indexOf(gameId);
    if (indiceExistente !== -1) window.misFavoritos[indiceExistente] = null;

    window.misFavoritos[slotIndex] = gameId;

    document.getElementById('favGameModalOverlay').style.display = 'none';
    window.pintarTop3(); // Actualiza la pantalla rápido

    try {
        const user = auth.currentUser;
        if (user) {
            const userRef = doc(db, "users", user.uid);
            await updateDoc(userRef, { favoritos: window.misFavoritos });
        }
    } catch (error) { console.error("Error al guardar en Firebase:", error); }
};

// Quita un juego de un hueco
window.quitarFavorito = async function(slotIndex) {
    window.misFavoritos[slotIndex] = null;
    window.pintarTop3();

    try {
        const user = auth.currentUser;
        if (user) {
            const userRef = doc(db, "users", user.uid);
            await updateDoc(userRef, { favoritos: window.misFavoritos });
        }
    } catch (error) { console.error("Error al quitar favorito:", error); }
};

