// Registro de notificaciones borradas para no volver a generarlas al sincronizar
window.obtenerIdsNotificacionesBorradas = function() {
    try {
        const raw = localStorage.getItem('checkpoint_notifs_borradas_v2');
        return raw ? (JSON.parse(raw) || []) : [];
    } catch (e) {
        return [];
    }
};

window.marcarIdNotificacionComoBorrada = function(idNotif) {
    if (!idNotif) return;
    try {
        const lista = window.obtenerIdsNotificacionesBorradas();
        if (lista.indexOf(idNotif) === -1) {
            lista.push(idNotif);
            localStorage.setItem('checkpoint_notifs_borradas_v2', JSON.stringify(lista));
        }
    } catch (e) {}
};

// Mejoramos eliminarNotificacionIndividual para recordar qué notificaciones ha cerrado el usuario
window.eliminarNotificacionIndividual = function(idNotif) {
    window.marcarIdNotificacionComoBorrada(idNotif);
    window.cargarAvisosEstrenoGuardados();
    window.misNotificacionesGenerales = (window.misNotificacionesGenerales || []).filter(function(n) { return n && n.id !== idNotif; });
    window.guardarNotificacionesGenerales();
    window.actualizarCampanaYPanelNotificaciones();
};

// Envía una notificación al usuario destinatario (en Firebase Firestore y/o en local si corresponde)
window.enviarNotificacionAUsuarioDestino = async function(targetUid, targetNombre, notifObj) {
    if (!notifObj || !notifObj.id) return;

    const borradas = window.obtenerIdsNotificacionesBorradas();
    if (borradas.indexOf(notifObj.id) !== -1) return;

    const miUsuario = window.ComunidadApp ? window.ComunidadApp.obtenerUsuarioActivo() : { uid: 'anon', nombre: '' };
    const esParaMi = (targetUid && miUsuario.uid && targetUid === miUsuario.uid) ||
                     (targetNombre && miUsuario.nombre && targetNombre.toLowerCase() === miUsuario.nombre.toLowerCase());

    if (esParaMi) {
        window.crearNotificacionApp(notifObj);
        return;
    }

    // Si el destinatario es otro usuario registrado, la guardamos directamente en su documento de Firebase
    if (targetUid && targetUid !== 'anon' && typeof db !== 'undefined' && typeof doc !== 'undefined' && typeof getDoc !== 'undefined' && typeof updateDoc !== 'undefined') {
        try {
            const userRef = doc(db, 'users', targetUid);
            const snap = await getDoc(userRef);
            if (snap && snap.exists()) {
                const data = snap.data() || {};
                const actuales = Array.isArray(data.notificacionesGenerales) ? data.notificacionesGenerales : [];
                if (!actuales.some(function(n) { return n && n.id === notifObj.id; })) {
                    actuales.unshift(Object.assign({
                        tipo: 'comunidad',
                        icono: 'forum',
                        colorIcono: '#f59e0b',
                        fecha: Date.now(),
                        leida: false
                    }, notifObj));
                    await updateDoc(userRef, { notificacionesGenerales: actuales });
                }
            }
        } catch (e) {}
    }
};

// Escanea los temas de las comunidades para generar automáticamente tus notificaciones de likes, comentarios en tus temas, temas seguidos y likes en tus comentarios
window.sincronizarNotificacionesDeComunidad = function() {
    if (!window.ComunidadApp) return;
    const miUsuario = window.ComunidadApp.obtenerUsuarioActivo();
    const borradas = window.obtenerIdsNotificacionesBorradas();

    window.cargarAvisosEstrenoGuardados();
    const actuales = Array.isArray(window.misNotificacionesGenerales) ? window.misNotificacionesGenerales : [];
    const idsExistentes = new Set(actuales.map(function(n) { return n && n.id; }).filter(Boolean));
    let añadidas = false;

    const agregarSiNoExiste = function(notif) {
        if (!notif || !notif.id) return;
        if (idsExistentes.has(notif.id) || borradas.indexOf(notif.id) !== -1) return;
        idsExistentes.add(notif.id);
        window.misNotificacionesGenerales.unshift(notif);
        añadidas = true;
    };

    const esMio = function(uid, nombre) {
        if (uid && miUsuario.uid && uid !== 'anon' && miUsuario.uid !== 'anon') {
            return uid === miUsuario.uid;
        }
        return Boolean(nombre && miUsuario.nombre && nombre.toLowerCase() === miUsuario.nombre.toLowerCase());
    };

    try {
        for (let i = 0; i < localStorage.length; i++) {
            const key = localStorage.key(i);
            if (!key || key.indexOf('checkpoint_comunidad_temas_') !== 0) continue;

            const raw = localStorage.getItem(key);
            if (!raw) continue;
            const temas = JSON.parse(raw) || [];

            temas.forEach(function(t) {
                if (!t || !t.id) return;
                const soyCreadorTema = esMio(t.autorUid, t.autorNombre);
                const seguidores = Array.isArray(t.seguidores) ? t.seguidores : [];
                const sigoElTema = seguidores.indexOf(miUsuario.uid) !== -1 ||
                                   (miUsuario.nombre && seguidores.indexOf(miUsuario.nombre.toLowerCase()) !== -1);

                // 1. Si soy el creador del tema: revisar likes recibidos en mi tema
                if (soyCreadorTema && Array.isArray(t.likesDetalle)) {
                    t.likesDetalle.forEach(function(lk) {
                        if (!lk || esMio(lk.uid, lk.nombre)) return;
                        agregarSiNoExiste({
                            id: 'notif_like_tema_' + t.id + '_' + (lk.uid || lk.nombre),
                            tipo: 'like_tema',
                            titulo: '❤️ A ' + (lk.nombre || 'un usuario') + ' le gusta tu tema',
                            mensaje: 'Ha dado Me gusta a tu tema "' + (t.titulo || 'Tema') + '" en ' + (t.juegoTitulo || 'la comunidad') + '.',
                            imagen: t.foto || '',
                            icono: 'favorite',
                            colorIcono: '#e11d48',
                            idJuego: t.idJuego || '',
                            idTema: t.id,
                            fecha: lk.fecha || Date.now(),
                            leida: false
                        });
                    });
                }

                // 2. Revisar comentarios del tema (para el creador del tema, seguidores del tema y likes en mis comentarios)
                const comentarios = Array.isArray(t.comentarios) ? t.comentarios : [];
                comentarios.forEach(function(c) {
                    if (!c || !c.id) return;
                    const soyAutorComentario = esMio(c.autorUid, c.autorNombre);

                    // A) Si soy el creador del tema y alguien comenta en él
                    if (soyCreadorTema && !soyAutorComentario) {
                        agregarSiNoExiste({
                            id: 'notif_com_tema_' + t.id + '_' + c.id,
                            tipo: 'comentario_tema',
                            titulo: '💬 ' + (c.autorNombre || 'Un usuario') + ' ha comentado en tu tema',
                            mensaje: 'En "' + (t.titulo || 'tu tema') + '": "' + (c.texto ? c.texto.slice(0, 60) : 'Ha subido una imagen') + '"',
                            imagen: t.foto || c.foto || '',
                            icono: 'forum',
                            colorIcono: '#2563eb',
                            idJuego: t.idJuego || '',
                            idTema: t.id,
                            fecha: c.fecha || Date.now(),
                            leida: false
                        });
                    }
                    // B) Si NO soy el creador, pero SIGO el tema y alguien comenta
                    else if (!soyCreadorTema && sigoElTema && !soyAutorComentario) {
                        agregarSiNoExiste({
                            id: 'notif_seg_tema_' + t.id + '_' + c.id,
                            tipo: 'seguimiento_tema',
                            titulo: '🔔 Nuevo comentario en "' + (t.titulo || 'tema seguido') + '"',
                            mensaje: (c.autorNombre || 'Un usuario') + ' comentó: "' + (c.texto ? c.texto.slice(0, 60) : 'Imagen adjunta') + '"',
                            imagen: t.foto || c.foto || '',
                            icono: 'notifications_active',
                            colorIcono: '#f59e0b',
                            idJuego: t.idJuego || '',
                            idTema: t.id,
                            fecha: c.fecha || Date.now(),
                            leida: false
                        });
                    }

                    // C) Si soy el autor de este comentario y alguien le da Like a mi comentario
                    if (soyAutorComentario && Array.isArray(c.likesDetalle)) {
                        c.likesDetalle.forEach(function(lkCom) {
                            if (!lkCom || esMio(lkCom.uid, lkCom.nombre)) return;
                            agregarSiNoExiste({
                                id: 'notif_like_com_' + c.id + '_' + (lkCom.uid || lkCom.nombre),
                                tipo: 'like_comentario',
                                titulo: '❤️ A ' + (lkCom.nombre || 'un usuario') + ' le gustó tu comentario',
                                mensaje: 'En el tema "' + (t.titulo || '') + '": "' + (c.texto ? c.texto.slice(0, 55) : 'Tu imagen') + '"',
                                imagen: c.foto || t.foto || '',
                                icono: 'favorite',
                                colorIcono: '#e11d48',
                                idJuego: t.idJuego || '',
                                idTema: t.id,
                                fecha: lkCom.fecha || Date.now(),
                                leida: false
                            });
                        });
                    }
                });
            });
        }
    } catch (e) {}

    if (añadidas) {
        window.misNotificacionesGenerales.sort(function(a, b) { return (b.fecha || 0) - (a.fecha || 0); });
        window.guardarNotificacionesGenerales();
        window.actualizarCampanaYPanelNotificaciones();
    }
};

window.ComunidadApp = {
    idJuegoActual: '',
    datosJuegoActual: {},
    temasActuales: [],
    idTemaAbierto: null,
    fotoTemaPendienteBase64: '',
    fotoComentarioPendienteBase64: '',

    obtenerUsuarioActivo: function() {
        let uid = 'anon';
        let nombre = 'Jugador';
        let avatar = 'https://ui-avatars.com/api/?name=Jugador&background=231815&color=fff';

        try {
            if (typeof auth !== 'undefined' && auth.currentUser) {
                uid = auth.currentUser.uid;
                nombre = auth.currentUser.displayName || (auth.currentUser.email ? auth.currentUser.email.split('@')[0] : 'Jugador');
                if (auth.currentUser.photoURL) avatar = auth.currentUser.photoURL;
            }
            const nickDOM = document.getElementById('profileUsername') || document.querySelector('#profilePanel h2, #profilePanel h1');
            if (nickDOM && nickDOM.textContent && nickDOM.textContent.trim()) {
                nombre = nickDOM.textContent.trim();
            }
            const avatarDOM = document.getElementById('profileAvatarImg') || document.querySelector('#profilePanel img');
            if (avatarDOM && avatarDOM.src && avatarDOM.src.startsWith('http')) {
                avatar = avatarDOM.src;
            }
        } catch (e) {}

        return { uid: uid, nombre: nombre, avatar: avatar };
    },

    esUsuarioCreadorDelTema: function(tema) {
        if (!tema) return false;
        const usuario = this.obtenerUsuarioActivo();
        if (tema.autorUid && usuario.uid && tema.autorUid !== 'anon' && usuario.uid !== 'anon') {
            if (tema.autorUid === usuario.uid) return true;
        }
        return Boolean(tema.autorNombre && usuario.nombre && tema.autorNombre.trim().toLowerCase() === usuario.nombre.trim().toLowerCase());
    },

    usuarioSigueElTema: function(tema) {
        if (!tema || !Array.isArray(tema.seguidores)) return false;
        const usuario = this.obtenerUsuarioActivo();
        return tema.seguidores.indexOf(usuario.uid) !== -1 ||
               (usuario.nombre && tema.seguidores.indexOf(usuario.nombre.toLowerCase()) !== -1);
    },

    // Inyecta automáticamente el botón de 3 puntitos arriba a la derecha en la vista del hilo (#vistaHiloComunidad)
    asegurarMenuTresPuntosEnDOM: function() {
        const vistaHilo = document.getElementById('vistaHiloComunidad');
        if (!vistaHilo) return;
        const topBar = vistaHilo.querySelector('.comunidad-top-bar');
        if (!topBar) return;

        if (!document.getElementById('contenedorMenuTresPuntosHilo')) {
            const ultimoDiv = topBar.lastElementChild;
            const contenedorMenu = document.createElement('div');
            contenedorMenu.id = 'contenedorMenuTresPuntosHilo';
            contenedorMenu.className = 'contenedor-menu-tres-puntos';
            contenedorMenu.innerHTML =
                '<button type="button" class="btn-tres-puntos-tema" onclick="window.ComunidadApp.toggleMenuOpcionesTema(event)" title="Opciones del tema">' +
                '<span class="material-symbols-rounded" style="font-size: 20px;">more_vert</span>' +
                '</button>' +
                '<div id="dropdownOpcionesTemaHilo" class="dropdown-opciones-tema"></div>';

            if (ultimoDiv && ultimoDiv.tagName === 'DIV' && !ultimoDiv.id) {
                topBar.replaceChild(contenedorMenu, ultimoDiv);
            } else {
                topBar.appendChild(contenedorMenu);
            }
        }
    },

    toggleMenuOpcionesTema: function(e) {
        if (e) {
            e.stopPropagation();
            e.preventDefault();
        }
        const menu = document.getElementById('dropdownOpcionesTemaHilo');
        if (!menu) return;

        const estaAbierto = menu.classList.contains('abierto');
        if (estaAbierto) {
            menu.classList.remove('abierto');
        } else {
            const tema = (this.temasActuales || []).find(function(t) { return t && t.id === window.ComunidadApp.idTemaAbierto; });
            this.actualizarContenidoMenuTresPuntos(tema);
            menu.classList.add('abierto');
        }
    },

    actualizarContenidoMenuTresPuntos: function(tema) {
        this.asegurarMenuTresPuntosEnDOM();
        const menu = document.getElementById('dropdownOpcionesTemaHilo');
        if (!menu || !tema) return;

        const esCreador = this.esUsuarioCreadorDelTema(tema);

        if (esCreador) {
            menu.innerHTML =
