    // Publicar un comentario en el hilo + Notificar al creador del tema y a todos los seguidores del tema
    publicarComentarioEnHilo: async function() {
        if (!this.idTemaAbierto) return;
        const tema = (this.temasActuales || []).find(function(t) { return t && t.id === window.ComunidadApp.idTemaAbierto; });
