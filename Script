// --- MOTOR DE CÁLCULO DE GESTOS ---
function iniciarGestosTactiles(img) {
    let initialDistance = 0;
    let startX = 0, startY = 0;

    img.addEventListener('touchstart', (e) => {
        if (e.touches.length === 2) {
            e.preventDefault();
            // Calcular la distancia inicial entre los dos dedos
            initialDistance = Math.hypot(
                e.touches[0].pageX - e.touches[1].pageX,
                e.touches[0].pageY - e.touches[1].pageY
            );
        } else if (e.touches.length === 1 && window.imgScale > 1) {
            e.preventDefault();
            // Registrar dónde empieza a arrastrar con un dedo
            startX = e.touches[0].pageX - window.imgLastTx;
            startY = e.touches[0].pageY - window.imgLastTy;
        }
    }, { passive: false });

    img.addEventListener('touchmove', (e) => {
        e.preventDefault(); // Bloquear el scroll de la página web
        if (e.touches.length === 2) {
            // ZOOM: Calcular cuánto se han separado los dedos
            const currentDistance = Math.hypot(
                e.touches[0].pageX - e.touches[1].pageX,
                e.touches[0].pageY - e.touches[1].pageY
            );
            
            window.imgScale = window.imgLastScale * (currentDistance / initialDistance);
            window.imgScale = Math.min(Math.max(1, window.imgScale), 4); // Límite: mínimo 1x, máximo 4x
            
            img.style.transform = `translate(${window.imgTx}px, ${window.imgTy}px) scale(${window.imgScale})`;
        } else if (e.touches.length === 1 && window.imgScale > 1) {
            // ARRASTRAR: Mover la imagen si está ampliada
            window.imgTx = e.touches[0].pageX - startX;
            window.imgTy = e.touches[0].pageY - startY;
            
            img.style.transform = `translate(${window.imgTx}px, ${window.imgTy}px) scale(${window.imgScale})`;
        }
    }, { passive: false });

    img.addEventListener('touchend', (e) => {
        // Guardar la posición y escala final cuando levanta los dedos
        if (e.touches.length < 2) {
            window.imgLastScale = window.imgScale;
        }
        if (e.touches.length === 0) {
            window.imgLastTx = window.imgTx;
            window.imgLastTy = window.imgTy;
        }
    });
}

