// Comprueba si un juego pertenece a la plataforma seleccionada (soporta nombres de IGDB, abreviaturas e IDs numéricos)
window.juegoCumpleFiltroPlataforma = function(juego, plataforma) {
    if (!plataforma || plataforma === 'Todos') return true;
    if (!juego || typeof juego !== 'object') return false;

    const idsNumericos = [];
    if (Array.isArray(juego.platforms)) {
        juego.platforms.forEach(p => {
            if (typeof p === 'number') idsNumericos.push(p);
            else if (p && typeof p.id === 'number') idsNumericos.push(p.id);
        });
    }

    const textoPlat = [
        juego.plataformas,
        juego.plataforma,
        juego.platform,
        Array.isArray(juego.platforms)
            ? juego.platforms.map(p => (p && (p.name || p.abbreviation || p.slug)) || p).join(' ')
            : (typeof juego.platforms === 'string' ? juego.platforms : '')
    ].filter(Boolean).join(' ').toLowerCase();

    switch (plataforma) {
        case 'PlayStation':
            return /\b(ps1|ps2|ps3|ps4|ps5|playstation|psp|ps vita|vita)\b/i.test(textoPlat) ||
                   idsNumericos.some(id => [7, 8, 9, 38, 46, 48, 165, 167].includes(id));
        case 'Xbox':
            return /\b(xbox|series x|series s|xone|x360)\b/i.test(textoPlat) ||
                   idsNumericos.some(id => [11, 12, 49, 169].includes(id));
        case 'Nintendo':
            return /\b(nintendo|switch|wii|3ds|2ds|ds|game boy|gba|gbc|n64|snes|nes|gamecube|famicom)\b/i.test(textoPlat) ||
                   idsNumericos.some(id => [4, 5, 18, 19, 20, 21, 22, 24, 33, 37, 41, 130, 137, 159, 508].includes(id));
        case 'PC':
            return /\b(pc|windows|mac|linux|steam|dos)\b/i.test(textoPlat) ||
                   idsNumericos.some(id => [3, 6, 13, 14, 82].includes(id));
        default:
            return true;
    }
};

