window.normalizarTextoBusqueda = function(str) {
    if (!str) return '';
    return String(str)
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9\s]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
};

window.distanciaLevenshtein = function(a, b) {
    if (a === b) return 0;
    if (!a.length) return b.length;
    if (!b.length) return a.length;
    const matrix = [];
    for (let i = 0; i <= b.length; i++) matrix[i] = [i];
    for (let j = 0; j <= a.length; j++) matrix[0][j] = j;
    for (let i = 1; i <= b.length; i++) {
        for (let j = 1; j <= a.length; j++) {
            if (b.charAt(i - 1) === a.charAt(j - 1)) {
                matrix[i][j] = matrix[i - 1][j - 1];
            } else {
                matrix[i][j] = Math.min(
                    matrix[i - 1][j - 1] + 1,
                    matrix[i][j - 1] + 1,
                    matrix[i - 1][j] + 1
                );
            }
        }
    }
    return matrix[b.length][a.length];
};

window.coincideBusquedaFlexible = function(textoObjetivoRaw, queryRaw) {
    const q = window.normalizarTextoBusqueda(queryRaw);
    if (!q) return true;
    const target = window.normalizarTextoBusqueda(textoObjetivoRaw);
    if (!target) return false;
    if (target.indexOf(q) !== -1) return true;

    const palabrasQuery = q.split(' ').filter(Boolean);
    const palabrasTarget = target.split(' ').filter(Boolean);

    return palabrasQuery.every(function(pq) {
        if (target.indexOf(pq) !== -1) return true;
        const maxErrores = pq.length <= 3 ? 0 : (pq.length <= 6 ? 1 : 2);
        if (maxErrores === 0) return false;

        return palabrasTarget.some(function(pt) {
            if (window.distanciaLevenshtein(pq, pt) <= maxErrores) return true;
            if (pt.length > pq.length) {
                const prefijo = pt.slice(0, pq.length);
                if (window.distanciaLevenshtein(pq, prefijo) <= maxErrores) return true;
            }
            return false;
        });
    });
};

// Comprueba si un tema pertenece al usuario activo (comparando UID y Nombre sin importar mayúsculas)
window.esTemaDelUsuarioActivo = function(tema) {
    if (!tema) return false;
    const usuario = window.ComunidadApp ? window.ComunidadApp.obtenerUsuarioActivo() : { uid: 'anon', nombre: 'David' };
    const miUid = String(usuario.uid || '').trim();
    const miNombre = String(usuario.nombre || 'David').trim().toLowerCase();
    const autorUid = String(tema.autorUid || '').trim();
    const autorNombre = String(tema.autorNombre || '').trim().toLowerCase();

    if (miUid && miUid !== 'anon' && autorUid && miUid === autorUid) return true;
    if (miNombre && autorNombre && miNombre === autorNombre) return true;

    // También comprobamos en el DOM del hilo abierto si el nombre del autor del tema principal coincide con el usuario activo
    const overlayDet = document.getElementById('vistaDetalleTemaOverlay');
    if (overlayDet && overlayDet.style.display !== 'none') {
