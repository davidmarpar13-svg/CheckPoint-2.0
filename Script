window.borrarJuegoDeColeccion = function(gameId) {
    if(!confirm("¿Seguro que quieres borrar este juego de tu colección?")) return;
    const usuarioActual = auth.currentUser;
    if (!usuarioActual) return;

    // 1. SALVAR DATOS: Guardamos una copia en memoria para que la ficha no se quede vacía al recargarse
    if (!window.juegosCargados) window.juegosCargados = {};
    if (!window.juegosCargados[gameId] && window.miColeccionActiva && window.miColeccionActiva[gameId]) {
        window.juegosCargados[gameId] = JSON.parse(JSON.stringify(window.miColeccionActiva[gameId]));
    }

