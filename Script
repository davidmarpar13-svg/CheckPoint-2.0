        });
        if (estrellas.length > 0 && estrellas[0].parentElement) {
            estrellas[0].parentElement.classList.add('contenedor-estrellas-resena-glass');
        }
    }

    if (estrellas.length >= 5) {
        estrellas.slice(0, 10).forEach(function(starEl, idx) {
            const activa = (idx + 1) <= notaSeleccionada;
            starEl.classList.toggle('estrella-resena-activa', activa);
