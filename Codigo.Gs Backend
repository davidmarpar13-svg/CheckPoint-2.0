// SISTEMA DE CACHÉ DE TOKENS (Velocidad Extrema)
// =======================================================
function getIGDBTokenFast() {
  var props = PropertiesService.getScriptProperties();
  var token = props.getProperty('IGDB_FAST_TOKEN');

  if (!token) {
    var url = "https://id.twitch.tv/oauth2/token?client_id=" + String(TWITCH_CLIENT_ID).trim() + "&client_secret=" + String(TWITCH_CLIENT_SECRET).trim() + "&grant_type=client_credentials";
    var response = UrlFetchApp.fetch(url, { method: 'post', muteHttpExceptions: true });
    
    if (response.getResponseCode() === 200) {
      token = JSON.parse(response.getContentText()).access_token;
      props.setProperty('IGDB_FAST_TOKEN', token);
    } else {
      throw new Error("Twitch rechazó las claves: " + response.getContentText());
    }
  }
  return token;
}

function resetIGDBTokenFast() {
  PropertiesService.getScriptProperties().deleteProperty('IGDB_FAST_TOKEN');
}

