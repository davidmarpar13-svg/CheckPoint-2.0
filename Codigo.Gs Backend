// Función para buscar juegos (Llamada desde el frontend)
function buscarJuegosIGDB(query) {
  try {
    // 1. Limpiamos la búsqueda y evitamos consultas vacías
    query = String(query || '').trim();
    if (!query) return [];

    var token = String(getIGDBTokenFast()).trim();
    var clientId = String(TWITCH_CLIENT_ID).trim();

    // 2. Escapamos comillas (consejo clave) para que si buscas algo con " no rompa IGDB
    var safeQuery = query.replace(/"/g, '\\"');

    // 3. Consulta limpia sin el filtro category de momento, para asegurar resultados
    var searchBody = 'search "' + safeQuery + '"; ' +
                 'fields id, name, summary, storyline, cover.image_id, cover.url, artworks.image_id, screenshots.image_id, platforms.id, platforms.name, platforms.abbreviation, genres.name, first_release_date, involved_companies.developer, involved_companies.company.name; ' +
                 'limit 30;';
    var options = {
      method: 'post',
      headers: {
        'Client-ID': clientId,
        'Authorization': 'Bearer ' + token,
        'Accept': 'application/json'
      },
      payload: searchBody,
      muteHttpExceptions: true // Evita que Apps Script crashee internamente si IGDB falla
    };

    var response = UrlFetchApp.fetch('https://api.igdb.com/v4/games', options);
    var status = response.getResponseCode();
    var textResponse = response.getContentText();

    // 4. Control de errores HTTP nativos (Consejo clave de tus capturas)
    if (status < 200 || status >= 300) {
      Logger.log("IGDB HTTP Error " + status + ": " + textResponse);
      throw new Error("IGDB rechazó la conexión. Estado: " + status);
    }

    var parsed = JSON.parse(textResponse);

    if (!Array.isArray(parsed)) {
      throw new Error("IGDB no devolvió una lista válida.");
    }

    // 5. Procesamos las imágenes
    parsed.forEach(function(g) {
      if (g.cover && g.cover.image_id) {
        g.cover.url = 'https://images.igdb.com/igdb/image/upload/t_cover_big/' + g.cover.image_id + '.jpg';
      }
    });

    return parsed; 

  } catch (err) {
    Logger.log("Error en buscarJuegosIGDB: " + err.message);
    // Lanzamos el error limpio para que el frontend ponga "Error de conexión" y no falle la consola
    throw new Error(err.message);
  }
}

