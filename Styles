            flex-shrink: 0;
            z-index: 10;
        }

        .section-header {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    margin-bottom: 12px;
    /* La línea gap: 12px; ha sido eliminada */
}
        
        .section-title { 
            font-family: 'Outfit', sans-serif; 
            font-size: 0.85rem; 
            font-weight: 700; 
            text-transform: uppercase; 
            letter-spacing: 1.5px; 
            color: #2b1d14; 
            margin: 0; 
            margin-right: 12px;
        }
        
        .section-link { 
            font-family: 'Inter', sans-serif; 
            font-size: 0.7rem; 
            color: #614a3b; 
            font-weight: 600; 
            text-transform: uppercase; 
            cursor: pointer; 
        }

        /* Carrusel Hype (Móvil) */
        .hype-carousel { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 10px; scroll-snap-type: x mandatory; width: 100%; box-sizing: border-box; }
        .hype-carousel::-webkit-scrollbar { display: none; }
        .hype-card { min-width: 85%; height: 190px; border-radius: 16px; position: relative; overflow: hidden; scroll-snap-align: center; flex-shrink: 0; background: #e0dcd0; }
        .hype-card img { width: 100%; height: 100%; object-fit: cover; opacity: 0.9; }
        .hype-date { position: absolute; top: 12px; left: 12px; background: rgba(255,255,255,0.85); backdrop-filter: blur(10px); padding: 4px 8px; border-radius: 6px; font-size: 0.7rem; font-weight: 600; color: #b36b00; border: 1px solid rgba(0,0,0,0.1); }
        .hype-info { position: absolute; bottom: 0; left: 0; width: 100%; padding: 40px 12px 12px; background: linear-gradient(to top, rgba(0,0,0,0.8), transparent); box-sizing: border-box; }
        .hype-info h3 { margin: 0; font-family: 'Outfit', sans-serif; font-size: 1.1rem; color: white; text-transform: uppercase; font-weight: 700; }
        .hype-info p { margin: 3px 0 0; font-size: 0.70rem; color: rgba(255,255,255,0.8); }

        .category-trigger {
            display: flex;
            align-items: center;
            gap: 4px;
            cursor: pointer;
            color: #8c857e;
            font-family: 'Inter', sans-serif;
            font-size: 0.70rem;
            font-weight: 600;
            text-transform: uppercase;
            transition: all 0.3s ease;
        }
        .category-trigger svg {
            width: 14px;
            height: 14px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }
        /* Estado oculto: Cuando se abre el menú, la palabra original desaparece hacia la izquierda */
        .category-trigger.hidden-trigger {
            opacity: 0;
            transform: translateX(-15px);
            pointer-events: none;
            position: absolute;
        }

        /* Oculta temporalmente el título principal para ganar todo el ancho en móvil */
        .section-title.hide-title {
            opacity: 0;
            transform: translateX(-20px);
            pointer-events: none;
            width: 0;
            margin: 0;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        /* 3. MENÚ HORIZONTAL CON ICONOS (Estilo App Moderna) */
        .horizontal-menu-container {
            display: flex;
            align-items: center;
            gap: 8px;
            overflow-x: auto;
            width: 100%;
            opacity: 0;
            transform: translateX(15px); /* Entra suavemente desde la derecha */
            pointer-events: none;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            scrollbar-width: none; /* Oculta barra en Firefox */
            -ms-overflow-style: none; /* Oculta barra en IE/Edge */
        }
        .horizontal-menu-container::-webkit-scrollbar { display: none; } /* Oculta barra en Chrome/Safari */
        
        .horizontal-menu-container.show {
            opacity: 1;
            transform: translateX(0);
            pointer-events: auto;
        }

        /* Diseño de cada píldora con icono */
        .h-menu-item {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            background: rgba(255, 255, 255, 0.55);
            border: 1px solid rgba(0,0,0,0.05);
            border-radius: 20px;
            font-family: 'Inter', sans-serif;
            font-size: 0.70rem;
            font-weight: 600;
            color: #614a3b;
            cursor: pointer;
            transition: all 0.2s;
            flex-shrink: 0;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }
        .h-menu-item svg {
            width: 14px;
            height: 14px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2.2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }
        .h-menu-item.selected, .h-menu-item:hover {
            background: #2b1d14;
            color: #F9F7F1;
            border-color: #2b1d14;
            transform: scale(1.02);
        }
        /* Grid Populares (Móvil: 3 columnas) */
        .popular-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; width: 100%; }
        .grid-card { aspect-ratio: 3/4; border-radius: 10px; overflow: hidden; background: rgba(0,0,0,0.05); box-shadow: 0 4px 10px rgba(0,0,0,0.05); }
        .grid-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
        .grid-card:active img { transform: scale(0.95); }

        /* Barra Inferior (Móvil) */
        .bottom-nav.glass-panel { 
            position: fixed; 
            bottom: 0; 
            left: 0; 
            width: 100%; 
            height: 60px; /* Más bajita al no tener texto */
            display: flex; 
            justify-content: space-around; 
            align-items: center; 
            padding: 0 10px; 
            box-sizing: border-box;
            /* Cristal muy translúcido y brillante */
            background: rgba(255, 255, 255, 0.55); 
            backdrop-filter: blur(25px); 
            -webkit-backdrop-filter: blur(25px);
            border-top: 1px solid rgba(255, 255, 255, 0.8); 
            box-shadow: 0 -5px 25px rgba(0, 0, 0, 0.04);
            border-radius: 0;
            z-index: 9999;
        }
        /* BOTONES: Líneas finas y toque minimalista */
        .nav-item { 
            background: none; 
            border: none; 
            color: #a09a96; 
            display: flex; 
            align-items: center; 
            justify-content: center;
            cursor: pointer; 
            width: 50px; 
            height: 50px;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); 
        }
        
        .nav-item svg { 
            width: 24px; 
            height: 24px; 
            stroke: currentColor; 
            fill: none; 
            stroke-width: 1.2; /* LÍNEAS MUCHO MÁS FINAS Y ELEGANTES */
            stroke-linecap: round; 
            stroke-linejoin: round; 
            transition: all 0.3s ease;
        }

        /* BOTÓN ACTIVO: Negro y elegante (sin engrosar en exceso) */
        .nav-item.active { 
            color: #000000; 
            transform: translateY(-3px); 
        }
        .nav-item.active svg {
            stroke-width: 1.5; /* Solo un pelín más marcado al activarse, no brusco */
            filter: drop-shadow(0px 4px 6px rgba(0,0,0,0.15)); /* Pequeña sombra para darle relieve */
        }

        /* =========================================
           ADAPTACIÓN PARA ORDENADORES (PC)
           ========================================= */
        @media (min-width: 768px) {
    body, html {
        background-color: #111; /* Fondo oscuro alrededor de la app */
    }
    
    /* Centrar la app con una sombra elegante */
    .app-wrapper {
        max-width: 450px;
        border-left: 1px solid rgba(255,255,255,0.1);
        border-right: 1px solid rgba(255,255,255,0.1);
        box-shadow: 0 0 50px rgba(0,0,0,0.8);
    }
    
    /* Centrar el ratón y asegurar que se vea la parte de abajo de la imagen */
    #authBackground, #authOverlay {
        width: 100%;
        max-width: 450px;
        left: 50%;
        transform: translateX(-50%);
        background-position: center bottom; /* Obliga a la foto a mostrar el ratón */
    }
    
    /* Centrar la barra de navegación */
    .bottom-nav.glass-panel {
        max-width: 450px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
    }
}

