        .top-logo {
            position: absolute; top: 30px; left: 0; width: 100%; text-align: center;
            font-family: 'Outfit', sans-serif;
            font-size: 0.85rem; 
            font-weight: 600; 
            letter-spacing: 4px; 
            text-transform: uppercase;
