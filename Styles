        .section-header {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    margin-bottom: 12px;
    /* La línea gap: 12px; ha sido eliminada */
}
        
        .section-title { 
            font-family: 'Outfit', sans-serif; 
            font-size: 0.85rem; 
