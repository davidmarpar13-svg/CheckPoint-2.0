<style>

  body {
    font-family: 'Outfit', sans-serif;
    /* Así todo el texto normal usará la fuente moderna y limpia */
}

h1, h2, h3, .titulo-epico {
    font-family: 'Cinzel', serif;
    /* Los títulos grandes usarán la fuente épica de la pantalla de inicio */
}
        :root {
      /* CRISTAL MUCHO MÁS TRANSPARENTE Y SUTIL */
      --glass-bg: rgba(255, 255, 255, 0.12);
      --glass-border: rgba(255, 255, 255, 0.25);
      --text-main: #ffffff;
      --text-muted: rgba(255, 255, 255, 0.85);
    }

    /* Diseño del submenú de consolas */
    .sub-platform-filters {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        padding: 5px 20px 15px 20px;
        scrollbar-width: none; /* Oculta la barra en Firefox */
        transition: opacity 0.3s ease;
    }
    .sub-platform-filters::-webkit-scrollbar { display: none; } /* Oculta la barra en Chrome/Safari */
    .sub-platform-filters.hidden { display: none; }

    .sub-btn {
        background: rgba(255, 255, 255, 0.08);
        color: #ccc;
        border: 1px solid rgba(255, 255, 255, 0.15);
        padding: 6px 16px;
        border-radius: 20px;
        cursor: pointer;
        white-space: nowrap;
        font-size: 0.8rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s ease;
    }
    .sub-btn.active {
        background: rgba(255, 255, 255, 0.9);
        color: #000;
        font-weight: 600;
    }

    /* PEGA AQUÍ EL CÓDIGO DE ALINEACIÓN DEL MENÚ SUPERIOR */
    .clase-de-tu-menu-superior {
        display: flex;
        justify-content: flex-start;
        padding-left: 0;
        margin-left: 0;
        gap: 10px;
    }


       * {
  box-sizing: border-box;
}

body, html {
    margin: 0;
    padding: 0;
    width: 100vw;
    max-width: 100vw;
    height: 100%;
    font-family: 'Inter', sans-serif;
    background-color: #222;
    color: var(--text-main);
    
    /* ESTO ES LO QUE ARREGLA EL PROBLEMA DEL MÓVIL */
    overflow-x: hidden !important; 
    
    position: relative;
}

        #authBackground {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: url('https://firebasestorage.googleapis.com/v0/b/checkpoint-85fae.firebasestorage.app/o/Imagen%20de%20Inicio%20de%20sesi%C3%B3n%2FGemini_Generated_Image_adt0dtadt0dtadt0.jpeg?alt=media&token=d5eb4b89-6310-4729-9bd8-4bda9798995b') no-repeat center center;
            background-size: cover; z-index: 0; pointer-events: none; transition: opacity 0.5s ease;
        }

        /* OVERLAY SUTIL PARA QUE NO ENSUCIe LA IMAGEN */
        #authOverlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(180deg, rgba(0,0,0,0.02) 0%, rgba(0,0,0,0.4) 100%);
            z-index: 1; pointer-events: none; transition: opacity 0.5s ease;
        }

        /* 2. CONTENEDOR PRINCIPAL */
        .app-wrapper {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            width: 100%;
            min-height: 100vh;
            margin: 0 auto;
            background-color: transparent !important; 
            box-sizing: border-box;
            padding-bottom: 0 !important;
        }

        .top-logo {
            position: absolute; top: 30px; left: 0; width: 100%; text-align: center;
            font-family: 'Outfit', sans-serif;
            font-size: 0.85rem; 
            font-weight: 600; 
            letter-spacing: 4px; 
            text-transform: uppercase;
            color: #2b1d14; /* Marrón oscuro profundo */
            text-shadow: none;
        }

        .hero-section { 
            padding: 0 25px; 
            margin-bottom: auto; 
            margin-top: 85px; 
            text-align: left; 
            display: flex; 
            flex-direction: column; 
            align-items: flex-start; 
        }

        .main-headline { 
            font-family: 'Cinzel', serif; 
            font-size: 1.7rem; font-weight: 600; line-height: 1.25; margin: 0 0 10px 0; 
            letter-spacing: -0.3px; 
            color: #4a3324; /* Marrón cálido inspirado en el pelaje del ratón */
            text-shadow: none; 
        }

        .sub-headline { 
            font-family: 'Lora', serif; 
            font-size: 0.9rem; font-weight: 500; 
            color: #614a3b; /* Tono marrón tierra más suave y legible */
            line-height: 1.5; max-width: 400px; margin: 0; 
            text-shadow: none; 
        }

        /* PANEL INFERIOR MÁS GLASS Y TRANSPARENTE */
        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            border-top: 1px solid var(--glass-border); 
            border-radius: 25px 25px 0 0; 
            padding: 20px 20px 30px 20px; 
            width: 100%; box-sizing: border-box;
            box-shadow: 0 -10px 40px rgba(0,0,0,0.1);
            animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        
        @keyframes slideUp {
            from { transform: translateY(100%); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .panel-header { display: flex; align-items: center; margin-bottom: 15px; gap: 10px; }
        .btn-back {
            background: none; border: none; color: white; cursor: pointer; padding: 0;
            display: flex; align-items: center; justify-content: center;
        }
        .btn-back svg { width: 20px; height: 20px; stroke: white; stroke-width: 2.5; }
        .card-title { 
            font-family: 'Cinzel', serif; 
            font-size: 1.1rem; font-weight: 600; margin: 0; text-shadow: 0 1px 2px rgba(0,0,0,0.3); 
        }

        .input-group, .input-wrapper { position: relative; margin-bottom: 10px; }
        .input-group input, .input-wrapper input {
            width: 100%; padding: 12px 12px 12px 38px; 
            background: rgba(0, 0, 0, 0.25); border: 1px solid rgba(255, 255, 255, 0.18);
            color: white; border-radius: 12px; box-sizing: border-box; outline: none;
            font-size: 0.9rem; font-family: 'Inter', sans-serif; transition: all 0.3s ease; -webkit-appearance: none;
        }
        .input-group input::placeholder, .input-wrapper input::placeholder { color: rgba(255, 255, 255, 0.6); }
        .input-group input:focus, .input-wrapper input:focus { background: rgba(0, 0, 0, 0.4); border-color: rgba(255, 255, 255, 0.6); }

        .icon {
            position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
            width: 16px; height: 16px; fill: none; stroke: rgba(255, 255, 255, 0.8);
            stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; pointer-events: none;
            transition: stroke 0.2s ease;
        }

        /* Cuando el navegador hace autocompletar (fondo blanco), el icono se vuelve oscuro automáticamente */
        input:-webkit-autofill + .icon,
        input:-webkit-autofill:hover + .icon,
        input:-webkit-autofill:focus + .icon {
            stroke: #2b1d14 !important;
        }

        .input-inline { display: flex; gap: 8px; margin-bottom: 10px; }
        .input-inline .input-wrapper { flex-grow: 1; margin-bottom: 0; }
        
        button.primary-btn {
            width: 100%; padding: 13px; 
            background: rgba(255, 255, 255, 0.9); 
            color: #000000; border: none; border-radius: 12px; cursor: pointer;
            font-weight: 600; font-size: 0.95rem; font-family: 'Inter', sans-serif; transition: transform 0.1s, background 0.3s;
        }
        button.primary-btn:active { transform: scale(0.97); background: #ffffff; }
        
        button.glass-btn { 
            background: rgba(255, 255, 255, 0.15); color: white; border: 1px solid rgba(255,255,255,0.35); 
        }
        button.glass-btn:active { background: rgba(255, 255, 255, 0.25); }
        
        button.arrow-btn {
            width: 45px; flex-shrink: 0; 
            background: rgba(255, 255, 255, 0.2); 
            border: 1px solid rgba(255, 255, 255, 0.4); 
            border-radius: 12px; display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: 0.1s; color: white;
        }
        button.arrow-btn:active { transform: scale(0.95); background: rgba(255, 255, 255, 0.35); }
        button.arrow-btn svg { width: 20px; height: 20px; stroke: white; stroke-width: 2.5; fill: none; } 

        .text-link { text-align: center; margin-top: 12px; font-size: 0.8rem; color: var(--text-muted); cursor: pointer; font-family: 'Lora', serif; }
        .text-link:hover { color: white; }
        .terms-container { font-size: 0.70rem; display: flex; gap: 8px; margin-top: 8px; align-items: flex-start; color: var(--text-muted); line-height: 1.4; font-family: 'Lora', serif; }
        .terms-container input[type="checkbox"] { margin-top: 2px; accent-color: white; }
        
        .modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.6); z-index: 100; display: flex; justify-content: center; align-items: center;
            padding: 20px; box-sizing: border-box; backdrop-filter: blur(5px);
        }
        .modal-content {
            display: flex; flex-direction: column; width: 100%; max-width: 400px; max-height: 85vh; padding: 20px;
            border-radius: 20px !important; margin: 0;
            background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255,255,255,0.25);
        }
        .modal-scroll-area {
            overflow-y: auto; flex-grow: 1; padding-right: 10px; font-size: 0.85rem; color: rgba(255,255,255,0.9); line-height: 1.6;
            margin: 12px 0; max-height: 250px; font-family: 'Lora', serif;
        }
        .modal-scroll-area::-webkit-scrollbar { width: 4px; }
        .modal-scroll-area::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.4); border-radius: 4px; }
        .modal-scroll-area h4 { color: white; margin-top: 0; font-family: 'Cinzel', serif; }

        .hidden { display: none !important; }

/* --- ESTILOS DEL DASHBOARD & GLASS --- */
        .glass-panel {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.25);
        }

        #dashboardPanel:not(.hidden) {
            display: flex;
            flex-direction: column;
            flex-grow: 1;
            background-color: #F9F7F1; 
        }

        .dashboard-scroll {
            flex-grow: 1;
            overflow-y: auto;
            padding: 15px;
            padding-bottom: 80px !important; /* Reducido para la nueva barra */
            width: 100%;
            box-sizing: border-box;
            background-color: #F9F7F1;
        }

        .dashboard-top-bar {
            width: 100%;
            text-align: center;
            padding: 25px 0 10px 0;
            font-family: 'Outfit', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: 5px;
            text-transform: uppercase;
            color: #2b1d14; /* Mismo tono marrón elegante que usas */
