        }

        #authBackground {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: url('https://firebasestorage.googleapis.com/v0/b/checkpoint-85fae.firebasestorage.app/o/Imagen%20de%20Inicio%20de%20sesi%C3%B3n%2FGemini_Generated_Image_adt0dtadt0dtadt0.jpeg?alt=media&token=d5eb4b89-6310-4729-9bd8-4bda9798995b') no-repeat center center;
            background-size: cover; z-index: 0; pointer-events: none; transition: opacity 0.5s ease;
        }

        /* OVERLAY SUTIL PARA QUE NO ENSUCIe LA IMAGEN */
        #authOverlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
