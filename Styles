        }

        .hero-section { 
            padding: 0 25px; 
            margin-bottom: auto; 
            margin-top: 85px; 
            text-align: left; 
            display: flex; 
            flex-direction: column; 
            align-items: flex-start; 
        }

        .main-headline { 
            font-family: 'Cinzel', serif; 
            font-size: 1.7rem; font-weight: 600; line-height: 1.25; margin: 0 0 10px 0; 
            letter-spacing: -0.3px; 
