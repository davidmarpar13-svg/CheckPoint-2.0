/* Indicador animado Pull-to-Refresh */
.ptr-container {
    height: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: height 0.25s ease, opacity 0.25s ease;
    opacity: 0;
    width: 100%;
}
.ptr-container.visible {
    opacity: 1;
}
.bottom-loader {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 15px 0 85px 0;
    width: 100%;
}
.bottom-loader.hidden {
    display: none;
}
.ptr-spinner {
    width: 22px;
    height: 22px;
    border: 3px solid rgba(150, 150, 150, 0.2); /* Borde gris transparente */
