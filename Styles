<style>
        :root {
      /* CRISTAL MUCHO MÁS TRANSPARENTE Y SUTIL */
      --glass-bg: rgba(255, 255, 255, 0.12);
      --glass-border: rgba(255, 255, 255, 0.25);
      --text-main: #ffffff;
      --text-muted: rgba(255, 255, 255, 0.85);
    }

    /* Diseño del submenú de consolas */
    .sub-platform-filters {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        padding: 5px 20px 15px 20px;
        scrollbar-width: none; /* Oculta la barra en Firefox */
        transition: opacity 0.3s ease;
    }
    .sub-platform-filters::-webkit-scrollbar { display: none; } /* Oculta la barra en Chrome/Safari */
    .sub-platform-filters.hidden { display: none; }

    .sub-btn {
        background: rgba(255, 255, 255, 0.08);
        color: #ccc;
        border: 1px solid rgba(255, 255, 255, 0.15);
        padding: 6px 16px;
        border-radius: 20px;
        cursor: pointer;
        white-space: nowrap;
        font-size: 0.8rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s ease;
    }
    .sub-btn.active {
        background: rgba(255, 255, 255, 0.9);
        color: #000;
        font-weight: 600;
    }

    /* PEGA AQUÍ EL CÓDIGO DE ALINEACIÓN DEL MENÚ SUPERIOR */
    .clase-de-tu-menu-superior {
        display: flex;
        justify-content: flex-start;
        padding-left: 0;
        margin-left: 0;
